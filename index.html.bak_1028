<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#008254">
<title>수급 대시보드</title>
<link rel="manifest" href="manifest.webmanifest">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;500;700&family=Noto+Sans+KR:wght@300;400;500;700&display=swap">
<script>(function(){var T=['market','judge','streak','sector','chart','table','force','report','sim','list'],t=(location.hash||'').replace('#','').split('/')[1];if(t==='market'||T.indexOf(t)<0)document.documentElement.classList.add('tab-market');})();</script>
<style>

  :root {
    --sans: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Pretendard", "Noto Sans KR", "Malgun Gothic", "Segoe UI", sans-serif;
    --serif: "Noto Serif KR", "Batang", Georgia, serif;
    --color-bg: #f4f5f7; --color-panel: #ffffff; --color-fg: #1b1f27; --color-fg-muted: #667085; --color-border-line: #e1e4ea;
    --color-ok: #168a4a; --color-warn: #b7791f; --color-bad: #c93a3a;
    --c0: #2f6fed; --c1: #d97706; --c2: #0f9d8a; --c3: #9333ea; --c4: #db2777; --c5: #4b5563; --c6: #65a30d; --c7: #0891b2;
    --cds-chart-grid: #e8ebf0; --cds-chart-axis: #98a2b3; --cds-chart-reference: #98a2b3; --cds-chart-muted: #b6bcc8;
    --cds-surface-popover: #ffffff; --cds-border: #d5d9e1; --cds-text-secondary: #667085; --cds-shadow-popover: 0 4px 14px rgba(16,24,40,.14);
    --cds-radius: 12px; --cds-gap-sm: 8px; --cds-gap-md: 14px; --cds-pad-xs: 4px; --cds-pad-sm: 8px; --cds-pad-lg: 16px;
    --cds-font-size-caption: .78rem; --cds-font-size-body: .95rem; --cds-font-size-heading: 1.05rem; --cds-font-size-title: 1.6rem;
    --cds-font-weight-medium: 600; --cds-dur-slow: .25s;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
    --color-bg: #0f1218; --color-panel: #171b23; --color-fg: #e8eaf0; --color-fg-muted: #98a2b3; --color-border-line: #272d38;
    --color-ok: #4ade80; --color-warn: #fbbf24; --color-bad: #f87171;
    --c0: #6ea0ff; --c1: #fbbf24; --c2: #2dd4bf; --c3: #c084fc; --c4: #f472b6; --c5: #9ca3af; --c6: #a3e635; --c7: #22d3ee;
    --cds-chart-grid: #232a35; --cds-chart-axis: #596273; --cds-chart-reference: #596273; --cds-chart-muted: #4a5262;
    --cds-surface-popover: #1e232d; --cds-border: #323a47; --cds-text-secondary: #98a2b3; --cds-shadow-popover: 0 4px 14px rgba(0,0,0,.5);
    color-scheme: dark; } }
  body { margin: 0; background: var(--color-bg); color: var(--color-fg); font-family: var(--sans); font-size: 14px;
    padding: max(12px, env(safe-area-inset-top, 0px)) max(12px, env(safe-area-inset-right, 0px)) max(24px, env(safe-area-inset-bottom, 0px)) max(12px, env(safe-area-inset-left, 0px)); }

  body { padding-bottom: calc(76px + env(safe-area-inset-bottom, 0px)); }
  .tabbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; display: flex; background: var(--color-panel); border-top: 1px solid var(--color-border-line);
    padding: 4px max(4px, env(safe-area-inset-right, 0px)) calc(4px + env(safe-area-inset-bottom, 0px)) max(4px, env(safe-area-inset-left, 0px)); }
  .tabbar button { flex: 1; min-width: 0; font: inherit; border: 0; background: transparent; color: var(--color-fg-muted); padding: 7px 2px 5px; display: flex; flex-direction: column; align-items: center; gap: 3px; cursor: pointer; border-radius: 10px; }
  .tabbar button b { font-size: .55rem; line-height: 1; opacity: .35; }
  .tabbar button span { font-size: .8rem; }
  @media (max-width: 460px) { .tabbar button span { font-size: .68rem; letter-spacing: -.02em; } }
  .tabbar button.on { color: var(--color-fg); font-weight: 700; }
  .tabbar button.on b { opacity: 1; color: var(--c0); }
  .tabbar-wrap { max-width: 760px; margin-inline: auto; }
  .sd .top { position: sticky; top: 0; z-index: 10; background: var(--color-bg); padding-block: 8px; margin-block: -8px 0; }
  [hidden] { display: none !important; }
  .dash-skeleton { background: linear-gradient(90deg, var(--color-border-line), transparent, var(--color-border-line)); background-size: 200% 100%; animation: sk 1.4s linear infinite; border-radius: 8px; color: transparent !important; }
  @keyframes sk { to { background-position: -200% 0; } }
  @media (prefers-reduced-motion: reduce) { .dash-skeleton { animation: none; } }

  .sd { max-width: 760px; margin-inline: auto; display: flex; flex-direction: column; gap: var(--cds-gap-md); font-family: var(--sans); color: var(--color-fg); }
  .sd * { box-sizing: border-box; }
  .sd h1 { font-family: var(--serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; }
  .sd h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }
  .sd .note { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); margin: 0; line-height: 1.5; }
  .sd .card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-sm); min-width: 0; }
  .sd .top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--cds-gap-sm); }
  .sd select { font: inherit; font-size: 16px; min-width: 0; max-width: 100%; padding: 8px 10px; border-radius: var(--cds-radius); border: 1px solid var(--color-border-line); background: var(--color-bg); color: var(--color-fg); }
  .sd .hero { display: flex; flex-direction: column; gap: var(--cds-gap-sm); }
  .sd .hero-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .sd .pill { font-family: var(--serif); font-size: 1.6rem; line-height: 1; padding: 10px 16px; border-radius: 999px; border: 2px solid currentColor; font-weight: 400; white-space: nowrap; }
  .sd .pill.v-go { color: var(--color-ok); }
  .sd .pill.v-ready { color: var(--color-warn); }
  .sd .pill.v-watch, .sd .pill.v-wait { color: var(--color-fg-muted); }
  .sd .px { display: flex; flex-direction: column; font-variant-numeric: tabular-nums; }
  .sd .px b { font-weight: 500; font-size: 1.25rem; }
  .sd .chg-up { color: var(--color-ok); } .sd .chg-dn { color: var(--color-bad); }
  .sd .kv { display: grid; grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr)); gap: var(--cds-gap-sm); }
  .sd .kv div { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .sd .kv small { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }
  .sd .kv b { font-weight: 500; font-variant-numeric: tabular-nums; font-size: 1.05rem; }
  .sd .checks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .sd .checks li { display: grid; grid-template-columns: 1.6rem 1fr auto; gap: 8px; align-items: start; }
  .sd .checks .dot { width: 1.3rem; height: 1.3rem; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: .8rem; border: 1.5px solid var(--color-border-line); color: var(--color-fg-muted); }
  .sd .checks li.ok .dot { background: var(--color-ok); border-color: var(--color-ok); color: var(--color-bg); }
  .sd .checks .val { font-variant-numeric: tabular-nums; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); text-align: right; }
  .sd .chart { width: 100%; position: relative; min-height: 200px; }
  .sd .chart svg { display: block; width: 100%; height: auto; }
  .sd .legend { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }
  .sd .legend span { display: inline-flex; align-items: center; gap: 5px; }
  .sd .tip { position: absolute; pointer-events: none; z-index: 5; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .sd .tip .t { color: var(--cds-text-secondary); }
  .sd .tbl-wrap { max-height: 22rem; overflow: auto; }
  .sd table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }
  .sd th { position: sticky; top: 0; background: var(--color-panel); text-align: left; font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted); padding: 6px 6px; border-bottom: 1px solid var(--color-border-line); }
  .sd td { padding: 9px 6px; border-bottom: 1px solid var(--color-border-line); }
  .sd tbody tr { cursor: pointer; }
  .sd tbody tr.cur td { font-weight: 600; }
  .sd .tag { display: inline-block; padding: 2px 8px; border-radius: 999px; border: 1px solid currentColor; font-size: .72rem; }
  .sd .tag.v-go { color: var(--color-ok); } .sd .tag.v-ready { color: var(--color-warn); } .sd .tag.v-watch, .sd .tag.v-wait { color: var(--color-fg-muted); }
  .sd .fail { display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 120px; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }
  .sd .fail i { width: .375rem; height: .375rem; border-radius: 50%; background: var(--color-bad); display: inline-block; }
  .sd [data-dash-source-state=empty] { color: transparent; }
  .sd [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }
  .sd .xscroll { overflow-x: auto; }
  .sd .ytbl { min-width: 46rem; }
  .sd .ytbl th, .sd .ytbl td { text-align: right; white-space: nowrap; }
  .sd .ytbl th:first-child, .sd .ytbl td:first-child { text-align: left; position: sticky; left: 0; background: var(--color-panel); z-index: 1; }
  .sd .ytbl td.cell { background: var(--bg, transparent); }
  .sd .ytbl tbody tr.sel td:first-child { font-weight: 700; }
  .sd .ytbl tbody tr.sel td { box-shadow: inset 0 -2px 0 var(--color-fg-muted); }
  .sd .seg { display: inline-flex; border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); overflow: hidden; align-self: flex-start; }
  .sd .seg button { font: inherit; font-size: var(--cds-font-size-caption); padding: 8px 14px; border: 0; background: transparent; color: var(--color-fg-muted); cursor: pointer; }
  .sd .seg button.on { background: var(--color-fg); color: var(--color-bg); }
  .sd .ytbl tbody tr.sub td { color: var(--color-fg-muted); }
  .sd .ytbl tbody tr.grp td { border-top: 2px solid var(--color-border-line); }
  .sd .disc { text-align: center; padding-bottom: 12px; }
  /* 수급표: 좁은 화면에서도 가로 스크롤 없이 한 화면에 다 보이게(숫자는 만주·천원 단위로 줄이고 머리글은 세로로) */
  @media (max-width: 640px) {
    .sd #yearly { padding: 14px 4px; margin-inline: -6px; }
    .sd #yearly > h2, .sd #yearly > .note, .sd #yearly > .seg { margin-inline: 8px; }
    .sd #yearly .xscroll { overflow-x: visible; }
    .sd .ytbl { min-width: 0; width: 100%; table-layout: fixed; font-size: 7px; }
    .sd .ytbl th, .sd .ytbl td { padding: 6px 1px; overflow: hidden; text-overflow: clip; letter-spacing: -.07em; }
    .sd .ytbl th { font-size: 9px; vertical-align: bottom; }
    .sd .ytbl th:nth-child(n+4) { writing-mode: vertical-rl; text-align: left; height: 5em; padding: 3px 0; }
    .sd .ytbl th:nth-child(1) { width: 8%; } .sd .ytbl th:nth-child(2) { width: 6.5%; } .sd .ytbl th:nth-child(3) { width: 7%; }
    .sd .ytbl th:nth-child(-n+3) { font-size: 7.5px; letter-spacing: -.06em; }
    .sd .ytbl th:first-child, .sd .ytbl td:first-child { position: static; }
  }

  /* ===== 디자인 가이드 적용: 스프루스 그린 + 민트 + 헤어라인, 각진 모서리, 그림자 없음 ===== */
  :root {
    --sans: "Montserrat", "Noto Sans KR", -apple-system, "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
    --serif: "Montserrat", "Noto Sans KR", sans-serif;
    --primary: #008254; --primary-deep: #006642; --forest: #00482f; --mint-50: #effcf8; --mint-100: #e3faf2; --mint-200: #b7ecda;
    --lime-panel: #e8fdac; --lime-accent: #ddfa88; --logo-lime: #8dc63f; --hairline: #ebebec; --hairline-strong: #d8d9da;
    --ink: #000000; --body: #3d4045; --muted: #64666a; --link: #005fb9; --error: #de2828; --canvas-soft: #f7f7f7;
    --color-bg: #f7f7f7; --color-panel: #ffffff; --color-fg: #000000; --color-fg-muted: #64666a; --color-border-line: #d8d9da;
    --color-ok: #008254; --color-warn: #5e7f00; --color-bad: #de2828;
    --c0: #008254; --c1: #4b99e6; --c2: #8dc63f; --c3: #005fb9; --c4: #00482f; --c5: #64666a; --c6: #b7ecda; --c7: #de2828;
    --cds-chart-grid: #ebebec; --cds-chart-axis: #b1b3b5; --cds-chart-reference: #b1b3b5; --cds-chart-muted: #b1b3b5;
    --cds-surface-popover: #ffffff; --cds-border: #d8d9da; --cds-text-secondary: #64666a; --cds-shadow-popover: 0 4px 16px rgba(100,102,106,.12);
    --cds-radius: 8px;
  }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
    --primary: #2fbf86; --primary-deep: #0b5a3f; --forest: #0a3d2b; --mint-50: #12241d; --mint-100: #163128; --mint-200: #245a45;
    --lime-panel: #2a3a12; --hairline: #232a27; --hairline-strong: #323b37; --ink: #ffffff; --body: #c9cdd1; --muted: #98a09c; --link: #6db0ff; --canvas-soft: #0e1311;
    --color-bg: #0e1311; --color-panel: #151b18; --color-fg: #ffffff; --color-fg-muted: #98a09c; --color-border-line: #323b37;
    --color-ok: #2fbf86; --color-warn: #b6d94a; --color-bad: #ff6b6b;
    --c0: #2fbf86; --c1: #6db0ff; --c2: #a6dc5a; --c3: #8cc2ff; --c4: #6ee7b7; --c5: #98a09c; --c6: #245a45; --c7: #ff6b6b;
    --cds-chart-grid: #232a27; --cds-chart-axis: #4a544f; --cds-chart-reference: #4a544f; --cds-chart-muted: #56615b;
    --cds-surface-popover: #1b221f; --cds-border: #323b37; --cds-text-secondary: #98a09c; --cds-shadow-popover: 0 4px 16px rgba(0,0,0,.5);
  } }
  html { background: var(--color-bg); }
  body { font-weight: 300; font-size: 15px; line-height: 1.5; padding: 0 0 calc(76px + env(safe-area-inset-bottom, 0px)); color: var(--body); }
  .band { background: linear-gradient(90deg, var(--primary) 0%, #00a36b 100%); color: #fff;
    padding: env(safe-area-inset-top, 0px) 0 0; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .band { background: linear-gradient(90deg, #0a3d2b 0%, #0d5a3f 100%); } }
  .band-in { max-width: 760px; margin-inline: auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px;
    padding: 12px max(16px, env(safe-area-inset-right, 0px)) 12px max(16px, env(safe-area-inset-left, 0px)); }
  .band-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .band .badge { color: var(--lime-accent); font-size: 11px; font-weight: 700; letter-spacing: .04em; }
  .band h1 { margin: 0; font-family: var(--sans); font-weight: 700; font-size: 1.5rem; line-height: 1.15; color: #fff; }
  .band select { font: inherit; font-weight: 500; font-size: 16px; min-width: 0; max-width: 100%; padding: 12px 14px; border: 0; border-radius: 2px; background: #fff; color: #000; }
  .sd { padding: 16px max(16px, env(safe-area-inset-right, 0px)) 0 max(16px, env(safe-area-inset-left, 0px)); gap: 16px; color: var(--body); }
  .sd h1, .sd h2 { font-family: var(--sans); color: var(--color-fg); }
  .sd h2 { font-size: 1.1rem; font-weight: 700; line-height: 1.25; }
  .sd .note { color: var(--muted); font-weight: 400; }
  .sd .card { border: 1px solid var(--hairline-strong); border-radius: 8px; box-shadow: none; padding: 20px; gap: 12px; }
  /* 판단 카드 */
  .sd .hero .px b { color: var(--color-fg); font-weight: 700; }
  .sd .pill { font-family: var(--sans); font-size: 1.15rem; font-weight: 700; border: 0; border-radius: 2px; padding: 14px 18px; letter-spacing: 0; }
  .sd .pill.v-go { background: var(--primary); color: #fff; }
  .sd .pill.v-ready { background: var(--lime-panel); color: var(--primary-deep); }
  .sd .pill.v-watch, .sd .pill.v-wait { background: var(--canvas-soft); color: var(--muted); box-shadow: inset 0 0 0 1px var(--hairline-strong); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .sd .pill.v-ready { color: var(--lime-accent); } }
  .sd #v-text { background: var(--lime-panel); color: #000; border-radius: 8px; padding: 12px 14px; font-weight: 400; font-size: .92rem; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .sd #v-text { color: var(--body); } }
  /* 조건 4가지: 민트 패널 */
  .sd #checks { background: var(--mint-50); border: 0; border-radius: 16px; }
  .sd .checks .dot { border-radius: 50%; border-color: var(--hairline-strong); background: var(--color-panel); }
  .sd .checks li.ok .dot { background: var(--primary); border-color: var(--primary); color: #fff; }
  .sd .checks li { font-weight: 400; color: var(--color-fg); }
  .sd .checks .val { color: var(--body); font-weight: 500; }
  /* 성과: 진한 그린 통계 블록 */
  .sd #perf .kv { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .sd #perf .kv div { background: var(--primary-deep); color: #fff; border-radius: 8px; padding: 14px; gap: 4px; }
  .sd #perf .kv small { color: #cdeee1; font-weight: 500; }
  .sd #perf .kv b { font-size: 1.45rem; font-weight: 700; }
  /* 탭/버튼 */
  .tabbar { background: var(--color-panel); border-top: 1px solid var(--hairline-strong); box-shadow: none; }
  .tabbar button { border-radius: 2px; color: var(--muted); font-weight: 500; position: relative; }
  .tabbar button.on { color: var(--primary); font-weight: 700; }
  .tabbar button.on::before { content: ""; position: absolute; top: -5px; left: 18%; right: 18%; height: 3px; background: var(--primary); }
  .tabbar button b { display: none; }
  .sd .seg { border: 1px solid var(--hairline-strong); border-radius: 2px; }
  .sd .seg button { font-weight: 700; padding: 12px 18px; color: var(--primary); }
  .sd .seg button.on { background: var(--primary); color: #fff; }
  /* 표: 헤어라인만, 세로선 없음 */
  .sd table { font-weight: 400; color: var(--color-fg); }
  .sd th { color: var(--muted); font-weight: 700; font-size: .72rem; background: var(--color-panel); border-bottom: 1px solid var(--hairline-strong); }
  .sd td { border-bottom: 1px solid var(--hairline); }
  .sd .ytbl tbody tr.grp td { border-top: 2px solid var(--hairline-strong); }
  .sd .tag { border-radius: 2px; border: 0; font-weight: 700; padding: 3px 8px; }
  .sd .tag.v-go { background: var(--primary); color: #fff; }
  .sd .tag.v-ready { background: var(--lime-panel); color: var(--primary-deep); }
  .sd .tag.v-watch, .sd .tag.v-wait { background: var(--canvas-soft); color: var(--muted); }
  .sd .tip { border-radius: 8px; }
  .sd .disc { font-weight: 400; }
  .sd .chg-up { color: var(--color-ok); } .sd .chg-dn { color: var(--color-bad); }

  .sd .pill.v-strong { background: var(--forest, #00482f); color: #ddfa88; }
  .sd .tag.v-strong { background: var(--forest, #00482f); color: #ddfa88; }

  .sd .st { display: inline-block; padding: 3px 8px; border-radius: 2px; font-weight: 700; font-size: .78rem; background: var(--canvas-soft); color: var(--muted); white-space: nowrap; }
  .sd .st.ready { background: var(--primary); color: #fff; } .sd .st.hold { background: #fff3e0; color: #b45f00; }
  .sd .st.void, .sd .st.nodata { background: #fdecec; color: #b3261e; } .sd .st.watch, .sd .st.wait { background: var(--lime-panel); color: var(--primary-deep); }
  .sd .econd { list-style: none; margin: 8px 0; padding: 0; } .sd .econd li { padding: 6px 0; border-bottom: 1px solid var(--hairline); display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
  .sd .econd .m { font-weight: 700; min-width: 3.4rem; } .sd .econd .e-pass .m { color: var(--color-ok); } .sd .econd .e-fail .m { color: var(--color-bad); } .sd .econd .e-na .m, .sd .econd .e-off .m { color: var(--muted); }
  .sd .econd .t { color: var(--muted); font-size: .85rem; }
  #simcard .st { display: inline-block; padding: 2px 8px; border-radius: 3px; font-weight: 700; font-size: .74rem; background: var(--line); color: var(--muted); white-space: nowrap; }
  #simcard .st.ready { background: var(--primary); color: #fff; } #simcard .st.hold { background: var(--warn-bg); color: var(--warn); }
  #simcard .st.void, #simcard .st.nodata { background: var(--dn-bg); color: var(--dn); } #simcard .st.watch, #simcard .st.wait { background: var(--lime); color: var(--deep); }
  .sd .req-box { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .sd .req-btn { font: inherit; font-weight: 700; font-size: 1rem; padding: 14px 20px; border: 0; border-radius: 2px; background: var(--primary); color: #fff; cursor: pointer; }
  .sd .req-btn:disabled { background: var(--canvas-soft); color: var(--muted); box-shadow: inset 0 0 0 1px var(--hairline-strong); cursor: default; }
  .sd .req-btn.arm { background: var(--forest); color: #ddfa88; }
  .sd .job { border: 1px solid var(--hairline-strong); border-radius: 8px; padding: 12px 14px; display: flex; flex-direction: column; gap: 6px; font-weight: 400; }
  .sd .job b { color: var(--color-fg); }
  .sd .job .steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 12px; font-size: var(--cds-font-size-caption); color: var(--muted); }
  .sd .job .steps span.ok { color: var(--primary); } .sd .job .steps span.bad { color: var(--color-bad); }
  .sd .md { border-top: 2px solid var(--hairline-strong); padding-top: 14px; font-weight: 400; color: var(--color-fg); overflow-wrap: anywhere; }
  .sd .md h1 { font-size: 1.25rem; margin: 16px 0 8px; } .sd .md h2 { font-size: 1.1rem; margin: 18px 0 8px; } .sd .md h3, .sd .md h4 { font-size: 1rem; margin: 14px 0 6px; font-family: var(--sans); font-weight: 700; }
  .sd .md p { margin: 6px 0; } .sd .md ul, .sd .md ol { margin: 6px 0; padding-left: 1.3rem; } .sd .md li { margin: 3px 0; }
  .sd .md blockquote { margin: 10px 0; padding: 10px 14px; background: var(--lime-panel); color: #000; border-radius: 8px; }
  .sd .md code { background: var(--canvas-soft); padding: 1px 5px; border-radius: 2px; font-size: .9em; }
  .sd .md hr { border: 0; border-top: 1px solid var(--hairline-strong); margin: 14px 0; }
  .sd .md .tw { overflow-x: auto; margin: 8px 0; } .sd .md table { min-width: 28rem; } .sd .md td, .sd .md th { text-align: left; vertical-align: top; white-space: normal; }
  .sd .md a { color: var(--primary); text-decoration: underline; }
  .sd a.req-btn { display: inline-block; text-decoration: none; }
  .band-pick { display: flex; align-items: stretch; gap: 8px; min-width: 0; max-width: 100%; }
  .band-pick select { flex: 1 1 auto; min-width: 0; }
  .band-pick input { flex: 1 1 auto; min-width: 0; font: inherit; font-size: 16px; padding: 8px 10px; border-radius: 2px; border: 0; background: #fff; color: #111; }
  .band-req { font: inherit; font-weight: 700; font-size: .95rem; padding: 0 14px; border: 0; border-radius: 2px; background: #ddfa88; color: #00482f; cursor: pointer; white-space: nowrap; }
  .band-req:disabled { background: rgba(255,255,255,.25); color: #fff; cursor: default; }
  .band-req.off { background: rgba(255,255,255,.28); color: #fff; }
  .band-req.arm { background: #00482f; color: #ddfa88; }

  /* ===== SIM-SECTION: 강한진입 모의투자 ===== */
  #simcard { display: flex; flex-direction: column; gap: var(--cds-gap-md); --bg: var(--color-bg); --panel: var(--color-panel); --ink: var(--color-fg); --body: var(--color-fg); --muted: var(--color-fg-muted);
    --line: var(--color-border-line); --line2: var(--color-border-line); --primary: #008254; --deep: #006642; --mint: #effcf8; --lime: #e8fdac; --up: var(--color-ok); --dn: var(--color-bad);
    --warn: #b45f00; --warn-bg: #fff3e0; --dn-bg: #fdecec; --blue: #005fb9; --chart-grid: var(--cds-chart-grid); --chart-axis: #8a8d90; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) #simcard { --primary: #2fbf86; --deep: #0b5a3f; --mint: #12241d; --lime: #2a3a12; --warn: #ffb54d; --warn-bg: #3a2a10; --dn-bg: #3a1a1a; --blue: #6db0ff; --chart-axis: #6b756f; } }
  #simcard .empty, #simcard .err { padding: 16px; border-radius: var(--cds-radius); text-align: center; }
  #simcard .empty { color: var(--muted); border: 1px solid var(--line); background: var(--panel); }
  #simcard .err { background: var(--dn-bg); color: var(--dn); }
  #simcard .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px; }
  #simcard .kpi { background: var(--deep); color: #fff; border-radius: 10px; padding: 10px 12px; }
  #simcard .kpi small { display: block; color: #cdeee1; font-weight: 500; font-size: .72rem; }
  #simcard .kpi b { font-size: 1.15rem; }
  #simcard .kpi.neg b { color: #ffb4b4; } #simcard .kpi.pos b { color: #ddfa88; }
  #simcard .up { color: var(--up); } #simcard .dn { color: var(--dn); }
  #simcard .disc { color: var(--muted); font-size: .78rem; font-weight: 400; }
  #simcard .tag { display: inline-block; border-radius: 3px; padding: 2px 8px; font-size: .74rem; font-weight: 700; background: var(--line); color: var(--muted); }
  #simcard .tag.g { background: var(--primary); color: #fff; } #simcard .tag.l { background: var(--lime); color: var(--deep); }
  #simcard .tag.r { background: var(--dn-bg); color: var(--dn); } #simcard .tag.w { background: var(--warn-bg); color: var(--warn); }
  #simcard .tbl-wrap { max-height: none; overflow-x: auto; overflow-y: visible; }
  #simcard th { position: static; }
  #simcard table { width: 100%; border-collapse: collapse; font-size: .88rem; }
  #simcard th { text-align: left; color: var(--muted); font-size: .72rem; font-weight: 700; padding: 6px 8px; border-bottom: 1px solid var(--line2); white-space: nowrap; }
  #simcard td { padding: 8px 4px; border-bottom: 1px solid var(--line); white-space: normal; word-break: keep-all; }
  #simcard td.num { white-space: nowrap; }
  #simcard th { padding: 6px 4px; }
  #simcard td.num, #simcard th.num { text-align: right; font-variant-numeric: tabular-nums; }
  #simcard button { font: inherit; cursor: pointer; border: 1px solid var(--primary); background: var(--panel); color: var(--primary); border-radius: 6px; padding: 6px 12px; font-weight: 700; font-size: .84rem; min-height: 36px; }
  #simcard button.solid { background: var(--primary); color: #fff; }
  #simcard button.ghost { border-color: var(--line2); color: var(--muted); font-weight: 400; }
  #simcard input, #simcard select { font: inherit; font-size: 16px; border: 1px solid var(--line2); border-radius: 6px; padding: 6px 8px; background: var(--bg); color: var(--ink); min-width: 0; min-height: 38px; }
  #simcard .row { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; }
  #simcard .row label { display: flex; gap: 6px; align-items: center; font-size: .84rem; color: var(--muted); }
  #simcard .rules { background: var(--mint); border-radius: 10px; padding: 12px 14px; font-size: .84rem; }
  #simcard .rules ol { margin: 4px 0 0; padding-left: 20px; }
  #simcard .pos-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; align-items: center; }
  #simcard .pos-head h3 { margin: 0; font-size: 1.05rem; } #simcard .pos-head h3 small { color: var(--muted); font-weight: 400; margin-left: 6px; }
  #simcard .grid2 { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-top: 8px; }
  #simcard .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  #simcard .stat { background: var(--bg); border-radius: 8px; padding: 8px 10px; }
  #simcard .stat small { display: block; color: var(--muted); font-size: .7rem; font-weight: 500; }
  #simcard .stat b { font-size: .95rem; font-variant-numeric: tabular-nums; }
  #simcard .stopline { padding: 8px 12px; border-radius: 8px; font-size: .84rem; background: var(--bg); }
  #simcard .stopline.on { background: var(--dn-bg); color: var(--dn); }
  #simcard .verdict { border-radius: 10px; padding: 14px; background: var(--lime); color: #000; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) #simcard .verdict { color: var(--color-fg); } }
  #simcard .verdict.hold { background: var(--mint); } #simcard .verdict.part { background: var(--warn-bg); } #simcard .verdict.sell { background: #ffe0b2; }
  #simcard .verdict.stop { background: var(--dn-bg); } #simcard .verdict.idle { background: var(--bg); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) #simcard .verdict.sell { background: #4a3210; } }
  #simcard .verdict .vt { font-size: 1.1rem; font-weight: 700; }
  #simcard .verdict ul { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 3px; font-size: .84rem; }
  #simcard .meter { height: 8px; background: rgba(0,0,0,.12); border-radius: 4px; margin-top: 8px; overflow: hidden; }
  #simcard .meter i { display: block; height: 100%; background: var(--warn); }
  #simcard svg.chart { width: 100%; height: auto; display: block; }
  #simcard svg text { font-size: 10px; fill: var(--chart-axis); }
  #simcard .tr-in { width: 100%; max-width: 150px; }
  #simcard tr.sel { cursor: pointer; } #simcard tr.sel:hover td { background: var(--mint); } #simcard tr.sel.on td { background: var(--lime); }
  #simcard .scard { background: var(--panel); border: 1px solid var(--line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-sm); min-width: 0; }
  @media (max-width: 640px) {
    #simcard .stats { grid-template-columns: repeat(2, 1fr); }
    #simcard .row label { width: 100%; justify-content: space-between; } #simcard .row label input, #simcard .row label select { flex: 1; max-width: 62%; }
    #simcard .pos-head .row { width: 100%; } #simcard .tr-in { max-width: none; }
    #simcard table.stack thead { display: none; } #simcard table.stack, #simcard table.stack tbody { display: block; }
    #simcard table.stack tr { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 12px; background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; }
    #simcard table.stack tr.sel.on { border-color: var(--primary); background: var(--lime); }
    #simcard table.stack td { display: flex; justify-content: space-between; align-items: center; gap: 8px; border: 0; padding: 3px 0; white-space: normal; text-align: right; }
    #simcard table.stack td[data-label]::before { content: attr(data-label); color: var(--muted); font-size: .72rem; font-weight: 700; text-align: left; }
    #simcard table.stack td:first-child { grid-column: 1 / -1; justify-content: flex-start; text-align: left; font-size: 1rem; }
    #simcard table.stack td:last-child { grid-column: 1 / -1; justify-content: flex-end; }
    #simcard table.stack td:empty { display: none; } #simcard table.stack td[colspan] { grid-column: 1 / -1; }
  }
.crawl{display:none;position:sticky;top:0;z-index:50;background:var(--card,#fff);border-bottom:1px solid var(--line,#ddd);padding:6px 14px;font-size:13px}
.crawl.on{display:block}
.crawl .cb{height:8px;border-radius:4px;background:rgba(128,128,128,.25);overflow:hidden;margin-top:4px}
.crawl .cb i{display:block;height:100%;width:0;background:#2a7de1;transition:width .6s}
.crawl.done .cb i{background:#1a9a5a}

  /* ---- 시장 탭·탭바·시인성 (patch_market) ---- */
  :root { --mk-pos: #d32f2f; --mk-neg: #1565c0; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --mk-pos: #ff7b7b; --mk-neg: #7fb0ff; } }
  :root[data-theme="dark"] { --mk-pos: #ff7b7b; --mk-neg: #7fb0ff; }
  .tabbar { overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .tabbar::-webkit-scrollbar { display: none; }
  .tabbar button { flex: 1 0 auto; min-width: 56px; padding-inline: 8px; }
  .tabbar button span { white-space: nowrap; }
  @media (min-width: 900px) { .tabbar { justify-content: center; } .tabbar button { flex: 0 0 auto; min-width: 74px; } }
  .subnav { position: sticky; top: 0; z-index: 15; display: flex; gap: 6px; overflow-x: auto; padding: 8px 2px; margin: 0 0 10px; background: var(--color-bg, #fff); scrollbar-width: none; }
  .subnav::-webkit-scrollbar { display: none; }
  .subnav button { flex: 0 0 auto; font: inherit; font-size: .86rem; font-weight: 700; padding: 7px 14px; border-radius: 999px; border: 1px solid var(--color-border-line, #ddd); background: var(--color-panel, #fff); color: var(--color-fg, #111); cursor: pointer; }
  .subnav button:hover { border-color: var(--mk-neg); }
  section.card[id] { scroll-margin-top: 54px; }
  .sd table td, .sd table th { font-variant-numeric: tabular-nums; }
  .tbl-wrap thead th { position: sticky; top: 0; z-index: 2; background: var(--color-panel, #fff); box-shadow: 0 1px 0 var(--color-border-line, #ddd); }
  .tbl-wrap tbody tr:nth-child(even) { background: rgba(128, 128, 128, .07); }
  .tbl-wrap tbody tr[data-key]:hover, .tbl-wrap tbody tr[data-file]:hover { background: rgba(21, 101, 192, .12); cursor: pointer; }
  .mk .pos { color: var(--mk-pos); } .mk .neg { color: var(--mk-neg); }
  .mk h2 small { font-size: .78rem; font-weight: 500; color: var(--color-fg-muted, #666); margin-left: 6px; }
  .mk .mk-line { margin: 4px 0 10px; font-size: 1.02rem; line-height: 1.7; }
  .mk .mk-line b { font-weight: 800; }
  .mk-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 10px; }
  .mk-kpi { border: 1px solid var(--color-border-line, #ddd); border-radius: 10px; padding: 10px 12px; }
  .mk-kpi h3 { margin: 0 0 6px; font-size: .95rem; }
  .mk-kpi .cells { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; text-align: center; }
  .mk-kpi .cell b { display: block; font-size: 1.28rem; font-weight: 800; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .mk-kpi .cell span { display: block; font-size: .78rem; color: var(--color-fg-muted, #666); }
  .mk-kpi .cell em { display: block; font-style: normal; font-size: .76rem; font-variant-numeric: tabular-nums; }
  .mk-chips { display: flex; gap: 6px; margin: 4px 0 10px; }
  .mk-chips button { font: inherit; font-weight: 700; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--color-border-line, #ddd); background: var(--color-panel, #fff); color: var(--color-fg, #111); cursor: pointer; }
  .mk-chips button[aria-pressed="true"] { background: var(--mk-neg); border-color: var(--mk-neg); color: #fff; }
  .mk-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 10px; }
  .mk-card { border: 1px solid var(--color-border-line, #ddd); border-radius: 10px; padding: 8px 10px 6px; }
  .mk-card h3 { margin: 0 0 4px; font-size: .95rem; }
  .mk-card.buy { border-top: 3px solid var(--mk-pos); } .mk-card.sell { border-top: 3px solid var(--mk-neg); } .mk-card.both { border-top: 3px solid #8e44ad; }
  .mk-row { display: grid; grid-template-columns: 22px 1fr auto auto; gap: 6px; align-items: center; width: 100%; font: inherit; text-align: left; background: transparent; color: inherit; border: 0; border-top: 1px solid var(--color-border-line, #eee); padding: 7px 2px; cursor: pointer; }
  .mk-row:hover { background: rgba(21, 101, 192, .1); }
  .mk-row .rk { color: var(--color-fg-muted, #888); font-size: .8rem; text-align: center; }
  .mk-row .nm { font-weight: 700; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mk-row .nm small { display: block; font-weight: 400; font-size: .74rem; color: var(--color-fg-muted, #888); }
  .mk-row .amt { font-weight: 800; font-variant-numeric: tabular-nums; text-align: right; }
  .mk-row .amt small { display: block; font-weight: 500; font-size: .74rem; }
  .mk-empty { color: var(--color-fg-muted, #888); padding: 8px 2px; }
  .mk-two { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 10px; }
  .mk table.acc { width: 100%; border-collapse: collapse; }
  .mk table.acc th, .mk table.acc td { padding: 7px 8px; text-align: right; border-bottom: 1px solid var(--color-border-line, #eee); }
  .mk table.acc th:first-child, .mk table.acc td:first-child { text-align: left; font-weight: 700; }
  .mk table.acc td { font-weight: 700; font-size: 1.02rem; }
  /* ---- 시장 탭 xAI 테마 ---- */
  html.tab-market { color-scheme: dark; --mk-pos: #ff7a7a; --mk-neg: #a0c3ec;
    --x-canvas: #0a0a0a; --x-card: #191919; --x-soft: #1a1c20; --x-hair: #212327; --x-ink: #ffffff; --x-body: #dadbdf; --x-mute: #7d8187; --x-pill: rgba(255, 255, 255, .25);
    --x-font: "Universal Sans", "Inter", "Geist", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", -apple-system, Arial, sans-serif;
    --x-mono: "Geist Mono", "JetBrains Mono", "IBM Plex Mono", ui-monospace, "Cascadia Mono", Consolas, "D2Coding", monospace; }
  html.tab-market, html.tab-market body { background: var(--x-canvas); color: var(--x-body); }
  /* 머리띠·진행 막대·탭바: 시장 탭에서만 어둡게 */
  html.tab-market .band { background: var(--x-canvas) !important; border-bottom: 1px solid var(--x-hair); color: var(--x-ink); }
  html.tab-market .band .badge { font-family: var(--x-mono); font-size: 13px; font-weight: 400; letter-spacing: 1.2px; text-transform: uppercase; color: var(--x-mute); }
  html.tab-market .band h1 { font-family: var(--x-font); font-weight: 400; letter-spacing: -.02em; color: var(--x-ink); }
  html.tab-market .pick-wrap { border-radius: 9999px; overflow: hidden; border: 1px solid var(--x-pill); }
  html.tab-market .pick-wrap input { background: transparent !important; color: var(--x-ink) !important; }
  html.tab-market .pick-wrap input::placeholder { color: var(--x-mute); }
  html.tab-market #pick-btn { background: transparent !important; color: var(--x-ink) !important; border-left: 1px solid var(--x-hair) !important; }
  html.tab-market .band-req { background: transparent !important; color: var(--x-ink) !important; border: 1px solid var(--x-pill) !important; border-radius: 9999px !important; font-weight: 400 !important; }
  html.tab-market .crawl { background: var(--x-canvas) !important; color: var(--x-mute) !important; border-bottom: 1px solid var(--x-hair) !important; }
  html.tab-market .crawl { font-size: 15px !important; line-height: 22px; }
  html.tab-market .crawl .cb { background: var(--x-hair); }
  html.tab-market .crawl .cb i, html.tab-market .crawl.done .cb i { background: var(--x-ink); }
  html.tab-market .tabbar { background: rgba(10, 10, 10, .88) !important; -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border-top: 1px solid var(--x-hair) !important; }
  html.tab-market .tabbar button { color: var(--x-mute); font-weight: 400; }
  html.tab-market .tabbar button.on { color: var(--x-ink); font-weight: 400; }
  html.tab-market .tabbar button span { font-size: 14px; }
  html.tab-market .tabbar button.on::before { background: var(--x-ink); }
  /* 구역: 카드 chrome 제거, 큰 여백, 모든 글자 두께 400 */
  html.tab-market .sd .card.mk { background: transparent; border: 0 !important; box-shadow: none !important; border-radius: 0; padding: 64px 0 8px; font-family: var(--x-font); color: var(--x-body); }
  @media (max-width: 767px) { html.tab-market .sd .card.mk { padding-top: 40px; } }
  html.tab-market .sd .mk, html.tab-market .sd .mk * { font-weight: 400; }
  html.tab-market .sd .mk { font-size: 16px; }
  html.tab-market .sd .mk h2 { font-family: var(--x-font); font-size: clamp(28px, 4.2vw, 48px); line-height: 1.1; letter-spacing: -.025em; color: var(--x-ink); margin: 0 0 24px; }
  html.tab-market .sd .mk h2 small { display: block; margin: 12px 0 0; font-size: 16px; line-height: 24px; letter-spacing: 0; color: var(--x-mute); }
  html.tab-market .sd .mk h2::before { display: block; font-family: var(--x-mono); font-size: 15px; line-height: 20px; letter-spacing: 1.4px; text-transform: uppercase; color: var(--x-mute); margin-bottom: 14px; }
  html.tab-market .sd #mk-sum h2::before { content: "Market / Today"; }
  html.tab-market .sd #mk-acc h2::before { content: "Net buy / By investor"; }
  html.tab-market .sd #mk-top h2::before { content: "Top 5 / Rankings"; }
  html.tab-market .sd #mk-sec h2::before { content: "Sectors / Foreign + Institution"; }
  html.tab-market .sd #mk-lu h2::before { content: "Limit up / Today"; }
  html.tab-market .sd #mk-sum { padding-top: 40px; }
  html.tab-market .sd #mk-sum h2 { font-size: clamp(44px, 8vw, 96px); line-height: 1; letter-spacing: -.025em; }
  html.tab-market .sd .mk .mk-line { font-size: 20px; line-height: 32px; color: var(--x-body); margin: 0 0 32px; }
  html.tab-market .sd .mk .mk-line b { color: var(--x-ink); }
  html.tab-market .sd .mk .mk-line b.pos { color: var(--mk-pos); } html.tab-market .sd .mk .mk-line b.neg { color: var(--mk-neg); }
  html.tab-market .sd .mk .note { font-size: 15px; line-height: 24px; color: var(--x-mute); }
  /* 시장 카드 */
  html.tab-market .sd .mk-kpi { background: var(--x-card); border: 1px solid var(--x-hair); border-radius: 8px; padding: 24px; }
  html.tab-market .sd .mk-kpi h3 { font-family: var(--x-mono); font-size: 12px; line-height: 16px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--x-ink); margin: 0 0 20px; }
  html.tab-market .sd .mk-kpi h3 small { font-family: var(--x-font); font-size: 12px; letter-spacing: 0; text-transform: none; color: var(--x-mute) !important; margin-left: 8px; }
  html.tab-market .sd .mk-kpi .cell span { font-family: var(--x-mono); font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--x-mute); }
  html.tab-market .sd .mk-kpi h3 { font-family: var(--x-mono); font-size: 14px; line-height: 20px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--x-ink); margin: 0 0 12px; }
  html.tab-market .sd .mk-kpi h3 small { font-family: var(--x-font); font-size: 14px; letter-spacing: 0; text-transform: none; color: var(--x-mute) !important; margin-left: 8px; }
  html.tab-market .sd .mk-kpi .cells { display: block; text-align: left; }
  html.tab-market .sd .mk-kpi .cell { display: grid; grid-template-columns: 76px 1fr; grid-template-rows: auto auto; column-gap: 12px; align-items: baseline; padding: 14px 0; border-top: 1px solid var(--x-hair); min-width: 0; }
  html.tab-market .sd .mk-kpi .cell span { grid-row: 1 / 3; align-self: center; font-family: var(--x-mono); font-size: 14px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--x-mute); text-align: left; }
  html.tab-market .sd .mk-kpi .cell b { display: block; text-align: right; font-size: clamp(26px, 4.2vw, 36px); line-height: 1.1; letter-spacing: -.02em; margin: 0; white-space: nowrap; }
  html.tab-market .sd .mk-kpi .cell em { text-align: right; font-size: 15px; line-height: 22px; margin-top: 4px; }
  /* 표: 모노 대문자 머리글 + 헤어라인 */
  html.tab-market .sd .mk table.acc th { font-family: var(--x-mono); font-size: 14px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--x-mute); background: transparent; border-bottom: 1px solid var(--x-hair); box-shadow: none; }
  html.tab-market .sd .mk table.acc td { font-size: 20px; color: var(--x-ink); border-bottom: 1px solid var(--x-hair); }
  html.tab-market .sd .mk table.acc td.pos { color: var(--mk-pos); } html.tab-market .sd .mk table.acc td.neg { color: var(--mk-neg); }
  html.tab-market .sd .mk table.acc td:first-child { font-family: var(--x-mono); font-size: 14px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--x-body); }
  /* 버튼: 전부 흰 반투명 테두리 알약, 선택은 흰 채움 */
  html.tab-market .sd .mk-chips button, html.tab-market .sd .subnav[data-tab="market"] button, html.tab-market .sd #mk-lu-more {
    font-family: var(--x-font) !important; font-size: 16px !important; line-height: 24px; font-weight: 400 !important; min-height: 44px; padding: 8px 20px !important;
    border: 1px solid var(--x-pill) !important; border-radius: 9999px !important; background: transparent !important; color: var(--x-ink) !important; transition: background-color .25s, color .25s, border-color .25s; }
  html.tab-market .sd .mk-chips button:hover, html.tab-market .sd .subnav[data-tab="market"] button:hover, html.tab-market .sd #mk-lu-more:hover { background: var(--x-soft) !important; }
  html.tab-market .sd .mk-chips button[aria-pressed="true"] { background: var(--x-ink) !important; border-color: var(--x-ink) !important; color: var(--x-canvas) !important; }
  html.tab-market .sd .mk-chips button:focus-visible, html.tab-market .sd .subnav[data-tab="market"] button:focus-visible, html.tab-market .sd #mk-lu-more:focus-visible, html.tab-market .sd .mk-row:focus-visible { outline: 2px solid var(--x-ink); outline-offset: 2px; }
  html.tab-market .sd .subnav[data-tab="market"] { background: rgba(10, 10, 10, .8); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); padding: 12px 0; gap: 8px; border-bottom: 1px solid var(--x-hair); }
  /* 순위 카드·업종 카드 */
  html.tab-market .sd .mk-card { background: var(--x-card); border: 1px solid var(--x-hair) !important; border-radius: 8px; padding: 24px 24px 8px; }
  html.tab-market .sd .mk-card.buy, html.tab-market .sd .mk-card.sell, html.tab-market .sd .mk-card.both { border-top: 1px solid var(--x-hair) !important; }
  html.tab-market .sd .mk-card h3 { font-family: var(--x-mono); font-size: 14px; line-height: 20px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--x-mute); margin: 0 0 12px; }
  html.tab-market .sd .mk-card h3 + .mk-row { border-top: 0; }
  html.tab-market .sd .mk-row { font-family: var(--x-font); border-top: 1px solid var(--x-hair); padding: 14px 4px; transition: background-color .25s; }
  html.tab-market .sd .mk-row:hover { background: var(--x-soft); }
  html.tab-market .sd .mk-row .rk { font-family: var(--x-mono); font-size: 14px; color: var(--x-mute); }
  html.tab-market .sd .mk-row .nm { font-size: 18px; color: var(--x-ink); }
  html.tab-market .sd .mk-row .nm small { font-size: 14px; color: var(--x-mute); margin-top: 6px; }
  html.tab-market .sd .mk-row .amt { font-size: 20px; }
  html.tab-market .sd .mk-row .amt small { font-size: 14px; margin-top: 4px; }
  html.tab-market .sd .mk-empty { color: var(--x-mute); }
  /* 종합 판단 태그: 알약 + 색 글자(구분은 유지) */
  html.tab-market .sd .mk .jtag { font-family: var(--x-font); font-size: 13px; line-height: 20px; padding: 1px 12px; border-radius: 9999px; background: transparent; border: 1px solid currentColor; }
  html.tab-market .sd .mk .jtag.buy { color: #7ee2a8; } html.tab-market .sd .mk .jtag.wait { color: #a0c3ec; }
  html.tab-market .sd .mk .jtag.hold { color: #ffc285; } html.tab-market .sd .mk .jtag.no { color: #ff7a7a; }
</style>
</head>
<body>
<header class="band">
  <div class="band-in">
    <div class="band-text">
      <span class="badge">코스피200 + 코스닥 · 수급 분석</span>
      <h1 id="title">수급 대시보드</h1>
    </div>
    <div class="band-pick">
      <div class="pick-wrap">
        <input type="search" id="pick-q" placeholder="종목명·코드를 입력하세요" autocomplete="off" aria-label="종목 검색">
        <button type="button" id="pick-btn" aria-label="종목 목록 열기">▾</button>
        <div class="pick-list" id="pick-list" hidden></div>
      </div>
      <select id="pick" aria-label="종목 선택" hidden></select>
      <button type="button" id="band-req" class="band-req" hidden>분석 요구</button>
    </div>
  </div>
</header>
<div class="crawl" id="crawl" role="status" aria-live="polite"><span id="crawl-t"></span><div class="cb"><i id="crawl-i"></i></div></div>
<div class="sd">

  <section class="card hero" id="verdict" data-tab="judge">
    <div class="hero-row">
      <span class="pill dash-skeleton" id="v-pill">진입</span>
      <div class="px">
        <b><span id="v-name" data-source="summary" data-field="name">—</span> <span class="note" id="v-code">—</span></b>
        <span><span id="v-close" data-source="summary" data-field="close">—</span>원 · 20일 <span id="v-chg" data-source="summary" data-field="chg20">—</span></span>
      </div>
    </div>
    <p id="v-text" class="note">—</p>
    <p class="note" id="v-layers">—</p>
    <p class="rep-line" id="v-rep"></p>
    <p class="note" id="v-asof">—</p>
    <button type="button" id="go-analysis" class="req-btn" hidden>분석 →</button>
  </section>

  <section class="card" id="jbasis" data-tab="judge">
    <h2>종합 판단 근거 — 기준선과 비교</h2>
    <p class="note">네 가지 분석(① 수급 후보, ② 진입 확인, ③ 추세 확인, ④ 분석 보고서)이 아래 기준선을 넘는지 보고 매수진입·매수대기·매수보류·매수불가로 나눕니다. 기준선은 아래 「기준선 설정」에서 바꿀 수 있습니다.</p>
    <ul class="jb" id="jb-list"></ul>
    <p class="note"><b style="color:#0a7d3c">매수진입</b> 모든 기준 통과 · <b style="color:#1f5fbf">매수대기</b> 후보이고 반등·시가 확인 등을 기다리는 중 · <b style="color:#b45f00">매수보류</b> 추세 미확인·보고서 점수가 기준에 못 미침 · <b style="color:#b3261e">매수불가</b> 후보가 아니거나 무효·부정 보고서·유동성·투자경고 등. 수익을 보장하지 않으며 실제 주문과 연결되어 있지 않습니다.</p>
  </section>

  <details class="card" id="jset" data-tab="judge">
    <summary><b>기준선 설정</b> — 종합 판단 기준을 직접 바꿀 수 있습니다 (이 브라우저에 저장)</summary>
    <div class="jset-grid">
      <label>① 수급 후보: 켜진 신호가 <input type="number" id="js-min" min="1" max="3" step="1" style="width:4rem"> 개 이상이면 후보 (신호 3가지 중)</label>
      <fieldset><legend>② 진입 확인에서 반드시 통과해야 하는 조건 (기본: 가격 반등·순매수 조건·손익비는 끔 — 백테스트에서 개선 근거가 없거나 오히려 불리했음)</legend>
        <label><input type="checkbox" data-req="rebound"> 가격 반등 확인(종가가 직전 3거래일 최고 종가 돌파)</label>
        <label><input type="checkbox" data-req="flowSum"> 최근 5일 외국인+기관 순매수 합 &gt; 0</label>
        <label><input type="checkbox" data-req="flowDays"> 최근 5일 중 순매수일 ≥ 3일</label>
        <label><input type="checkbox" data-req="chase"> 추격매수 제한(다음날 시가 갭 &lt; 3%)</label>
        <label><input type="checkbox" data-req="rr"> 예상 손익비 ≥ 2</label>
        <label><input type="checkbox" data-req="liq"> 유동성·거래정지</label>
      </fieldset>
      <fieldset><legend>③ 추세 확인 — 백테스트에서 효과가 확인된 조건(분석 보고서 9·10절)</legend>
        <label><input type="checkbox" id="js-trend"> 추세 강세 필요: 종가가 20일선보다 8.5% 이상 위 &amp; 세력 5일 순매수가 20일 평균 거래대금의 2.5% 이하</label>
        <label><input type="checkbox" id="js-trendreb"> 오늘 반등 확인 필요: 종가가 직전 3거래일 최고 종가를 돌파</label>
      </fieldset>
      <label>④ 분석 보고서: <select id="js-rep"><option value="optional">있으면 반영(없어도 진행)</option><option value="required">필수(없으면 매수대기)</option><option value="ignore">반영 안 함</option></select></label>
      <label>보고서 점수가 <input type="number" id="js-buy" min="0" max="5" step="0.1" style="width:4.5rem"> 점 이상이면 진입 가능</label>
      <label>보고서 점수가 <input type="number" id="js-block" min="0" max="5" step="0.1" style="width:4.5rem"> 점 미만이면 매수불가</label>
      <label><input type="checkbox" id="js-flag"> 투자경고·위험, 관리종목, 거래정지 종목은 매수불가</label>
      <label>미확인 조건은 <select id="js-unk"><option value="pass">통과로 보고 표시만</option><option value="block">보류로 봄</option></select></label>
      <button type="button" id="js-reset">기본값으로 되돌리기</button>
    </div>
    <p class="note">기본값(2개·모든 조건 필수·보고서 있으면 반영·3.5점/2.0점)은 검증용 초기값이며 최적값이 아닙니다. 설정은 이 브라우저에만 저장되고 다른 기기에는 적용되지 않습니다. 수급 신호 개수와 진입 확인 조건의 계산은 그대로이고, 어디까지를 통과로 볼지만 바뀝니다.</p>
  </details>

  <section class="card" id="checks" data-tab="judge">
    <h2>① 수급 후보 — 신호 3가지와 확인 2가지</h2>
    <p class="note">신호 ①②③ 중 2개 이상이면 「강한 진입」(후보 강도), ①만이면 「진입」, ②나 ③만이면 「진입 준비」입니다. 눌림 매수와 매집 간격 확산은 같은 세력합 매집 이동평균에서 나와 서로 독립적인 근거가 아닙니다. 후보 강도는 곧바로 매수 가능하다는 뜻이 아닙니다.</p>
    <p class="note" id="check-sum"></p>
    <ul class="checks" id="check-list"></ul>
  </section>


  <section class="card" id="entry" data-tab="judge">
    <h2>② 진입 확인 — 반등·수급·가격 기준 점검</h2>
    <p class="note">후보가 된 뒤 가격 반등, 최근 5일 외국인+기관 수급, 추격매수·급등일 저가·손익비·유동성을 차례로 확인합니다. 통과·미통과·미확인은 아래 표에서 조건마다 보입니다.</p>
    <p id="entry-head"></p>
    <p class="note" id="entry-reason"></p>
    <ul class="econd" id="entry-conds"></ul>
    <p class="note" id="entry-nums"></p>
    <p class="note" id="entry-px"></p>
    <p class="note" id="entry-mkt"></p>
    <p class="note" id="entry-meta"></p>
    <p class="note"><b>「진입 조건 충족」은 전략 규칙을 만족했다는 뜻이며 수익을 보장하지 않습니다.</b> 이 화면은 분석·모의투자용이고 실제 주문과 연결되어 있지 않습니다.</p>
  </section>


  <section class="card" id="rep-judge" data-tab="judge">
    <h2>④ 분석 보고서 반영</h2>
    <p id="rj-head"></p>
    <p class="note" id="rj-sum"></p>
    <p class="note" id="rj-rule">반영 규칙: 수급 조건을 충족해도 보고서 의견이 관망·부정이면 신규 진입을 보류하고, 긍정(매수 의견 또는 3.5점 이상)이면 「진입 가능」으로 올립니다. 보고서가 없으면 수급 규칙만으로 판단하고 「미반영」이라고 표시합니다. 보고서는 작성 시점의 정보이므로 작성일을 함께 확인하세요.</p>
    <button type="button" class="req-btn" id="rj-open" hidden>보고서 읽기</button>
  </section>

  <section class="card" id="who" data-tab="force">
    <h2>상승하기 전에 누가 매집했나</h2>
    <p class="note" id="who-note">—</p>
    <div class="chart dash-skeleton" id="who-chart" data-source="groups"></div>
  </section>

  <section class="card" id="now" data-tab="force">
    <h2>지금 그 세력은 어떤가</h2>
    <p class="note">핵심 세력 3곳의 최근 60일 누적 순매수입니다. 오르는 선은 계속 사고 있다는 뜻입니다.</p>
    <div class="legend" id="now-legend"></div>
    <div class="chart dash-skeleton" id="now-chart" data-source="cum60"></div>
    <div class="tbl-wrap">
      <table id="now-table" data-source="groups" data-row-key="c,g">
        <thead><tr><th data-field="g">세력</th><th data-field="cur5">5일</th><th data-field="cur20">20일</th><th data-field="ratio">분산비</th><th>상태</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <section class="card" id="yearly" data-tab="table">
    <h2>년월별 거래량과 수급주체별 평균단가</h2>
    <p class="note">오늘부터 거꾸로 센 구간별 표입니다. 주는 5일, 월은 20일, 분기는 60일, 년은 240일 단위입니다. 아래 버튼으로 순매수 주식 수와 평균단가를 바꿔 봅니다.</p>
    <div class="seg" role="group" aria-label="표시 값">
      <button type="button" id="mode-net" class="on">순매수량</button>
      <button type="button" id="mode-px">평균단가</button>
    </div>
    <p class="note" id="mode-note">—</p>
    <div class="xscroll">
      <table id="year-table" class="ytbl" data-source="blocks" data-row-key="c,o">
        <thead><tr><th data-field="lab">구간</th><th data-field="ap">평균가</th><th data-field="vol">거래량</th><th data-field="개인">개인</th><th data-field="외국인">외국인</th><th data-field="기관계">기관계</th><th data-field="금융투자">금융투자</th><th data-field="보험">보험</th><th data-field="투신">투신</th><th data-field="기타금융">기타금융</th><th data-field="은행">은행</th><th data-field="연기금등">연기금등</th><th data-field="사모펀드">사모펀드</th><th data-field="국가">국가</th><th data-field="기타법인">기타법인</th><th data-field="기타외인">기타외인</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <h2 style="font-size: var(--cds-font-size-body)">수급주체별 현재 매수평단</h2>
    <p class="note">매집수량이 늘어난 날의 종가로 원가를 쌓아 계산한 평균 매수가입니다. 수익률은 오늘 종가 기준입니다.</p>
    <div class="tbl-wrap">
      <table id="cost-table" data-source="cost" data-row-key="c,g">
        <thead><tr><th data-field="g">투자자</th><th data-field="avg">매수평단</th><th data-field="ret">수익률</th><th data-field="acc">매집수량</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <section class="card" id="price" data-tab="chart">
    <h2>주가와 신호 (최근 1년)</h2>
    <div class="legend" id="price-legend"></div>
    <div class="chart dash-skeleton" id="price-chart" data-source="daily"></div>
  </section>

  <section class="card" id="acc" data-tab="chart">
    <h2>세력합 매집수량</h2>
    <p class="note">외국인·기관·국가·기타법인의 순매수를 모은 누적 값입니다. 5일선이 20일선 위로 올라가면 매집이 강해지는 중입니다.</p>
    <div class="legend" id="acc-legend"></div>
    <div class="chart dash-skeleton" id="acc-chart" data-source="daily"></div>
  </section>

  <section class="card" id="gap" data-tab="chart">
    <h2>매집 간격 (5일선 − 20일선)</h2>
    <p class="note">세력합 매집수량의 5일선이 20일선보다 얼마나 위에 있는지입니다. 점선은 이전 상승이 시작될 때의 간격이고, 선이 점선 위로 올라간 첫날을 ●로 표시했습니다.</p>
    <div class="legend" id="gap-legend"></div>
    <div class="chart dash-skeleton" id="gap-chart" data-source="daily"></div>
  </section>

  <section class="card" id="ratio" data-tab="chart">
    <h2>분산비 (세력합)</h2>
    <p class="note">매집수량이 그동안의 최고치에 얼마나 가까운지입니다. 1에 가까울수록 매집이 쌓여 있습니다.</p>
    <div class="chart dash-skeleton" id="ratio-chart" data-source="daily"></div>
  </section>

  <section class="card" id="perf" data-tab="judge">
    <h2>이 종목의 지난 신호는 어땠나</h2>
    <div class="tbl-wrap">
      <table id="perf-table">
        <thead><tr><th>신호</th><th>횟수</th><th>20일 뒤 상승</th><th>평균 수익</th><th>최근</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <p class="note">과거 5년 기록이고, 이어지는 신호는 첫날만 셌습니다. 20일 뒤 수익률은 신호가 난 날 종가 기준입니다. 과거 성과가 앞으로를 보장하지 않습니다.</p>
  </section>

  <nav class="subnav" data-tab="market" aria-label="이 탭 안의 구역">
    <button type="button" data-jump="mk-sum">오늘 요약</button><button type="button" data-jump="mk-top">주체별 Top</button><button type="button" data-jump="mk-sec">업종</button><button type="button" data-jump="mk-lu">상한가</button>
  </nav>
  <section class="card mk" id="mk-sum" data-tab="market">
    <h2>오늘의 수급 <small id="mk-date"></small></h2>
    <div id="mk-line" class="mk-line">불러오는 중…</div>
    <div class="mk-kpis" id="mk-kpis"></div>
    <p class="note" id="mk-note"></p>
  </section>
  <section class="card mk" id="mk-acc" data-tab="market">
    <h2>주체별 누적 순매수 <small>분석 종목 합계 · 억원</small></h2>
    <div class="tbl-wrap"><table class="acc" id="mk-acc-t"><thead><tr><th>주체</th><th>당일</th><th>5일</th><th>20일</th></tr></thead><tbody></tbody></table></div>
    <p class="note">분석 종목(코스피200 + 코스닥 시총 상위 + 추가·편입 종목) 안에서 순매수 수량 × 종가를 더한 값입니다. 거래소 전체 집계와 다릅니다.</p>
  </section>
  <section class="card mk" id="mk-top" data-tab="market">
    <h2>누가 많이 사고 팔았나 <small>분석 종목 기준 순위</small></h2>
    <div class="mk-chips" id="mk-chips"><button type="button" data-p="1" aria-pressed="true">당일</button><button type="button" data-p="5" aria-pressed="false">5일 누적</button><button type="button" data-p="20" aria-pressed="false">20일 누적</button></div>
    <div class="mk-grid" id="mk-grid"></div>
    <p class="note">순위는 금액 크기 순일 뿐 추천이 아닙니다. 종목을 누르면 분석 화면으로 이동하고, 색 태그는 판단 탭의 종합 판단입니다.</p>
  </section>
  <section class="card mk" id="mk-sec" data-tab="market">
    <h2>업종별 외국인·기관 <small id="mk-sec-d"></small></h2>
    <div class="mk-two"><div class="mk-card buy"><h3>순매수 상위 업종</h3><div id="mk-sec-b"></div></div><div class="mk-card sell"><h3>순매도 상위 업종</h3><div id="mk-sec-s"></div></div></div>
    <p class="note">크레온 0797(거래소 기준, 억원). 외국인 + 기관계 합계 순서입니다. 업종 전체는 업종 탭에서 볼 수 있습니다.</p>
  </section>
  <section class="card mk" id="mk-lu" data-tab="market">
    <h2>오늘 상한가 <small id="mk-lu-d"></small></h2>
    <div id="mk-lu-b"></div>
    <p class="note"><button type="button" class="subnav-link" id="mk-lu-more" style="font:inherit;font-weight:700;border:1px solid var(--color-border-line);background:transparent;color:inherit;padding:6px 12px;border-radius:999px;cursor:pointer">강한진입 탭에서 날짜별로 보기 →</button></p>
  </section>

  <nav class="subnav" data-tab="streak" aria-label="이 탭 안의 구역">
    <button type="button" data-jump="limitup">상한가 종목</button><button type="button" data-jump="jlist">종합 판단별 검색</button><button type="button" data-jump="streak">연속 신호 목록</button>
  </nav>
  <section class="card" id="limitup" data-tab="streak">
    <h2>상한가 종목</h2>
    <p class="note" id="lu-note">그날 상한가로 마감한 종목을 모았습니다. 종목을 누르면 그 종목의 분석 화면으로 이동합니다.</p>
    <div class="jl-ctl"><label>날짜 <select id="lu-date"></select></label></div>
    <p class="note" id="lu-sum"></p>
    <div class="tbl-wrap" style="max-height:360px;overflow:auto"><table id="lu-table" class="jl"><thead><tr><th>종목</th><th>구분</th><th>종가</th><th>당일 상승</th><th>종합 판단</th><th>수급 후보</th><th>20일</th></tr></thead><tbody></tbody></table></div>
  </section>

  <section class="card" id="jlist" data-tab="streak">
    <h2>종합 판단별 종목 검색</h2>
    <p class="note">판단 탭의 종합 판단(① 수급 후보 + ② 진입 확인 + ③ 추세 확인 + ④ 분석 보고서)을 분석 중인 모든 종목에 적용한 목록입니다. 판정은 판단 탭의 「기준선 설정」을 따르므로 기준선을 바꾸면 이 목록도 바뀝니다. 줄을 누르면 그 종목의 판단 탭으로 갑니다.</p>
    <div class="chips" id="jl-chips"></div>
    <div class="jl-ctl"><label>기준일 <select id="jl-date"><option value="">최신 (오늘 자료)</option></select></label><input type="search" id="jl-q" placeholder="종목명·코드로 거르기" autocomplete="off"><label><input type="checkbox" id="jl-strong"> 강한 진입 연속 3일 이상만</label></div>
    <p class="note" id="jl-sum"></p>
    <div class="tbl-wrap" style="max-height:480px;overflow:auto"><table id="jl-table" class="jl"><thead><tr><th>종목</th><th>종합 판단</th><th>수급 후보</th><th>진입 확인</th><th>보고서</th><th>20일</th><th>연속</th></tr></thead><tbody></tbody></table></div>
  </section>

  <section class="card" id="streak" data-tab="streak">
    <h2>강한 진입이 5거래일 연속 나온 종목</h2>
    <p class="note">신호 ①눌림 매수 ②매집 간격 확산 ③거래량 폭발 중 2개 이상이 켜진 「강한 진입」이 오늘까지 며칠째 이어지는지 셉니다. 줄을 누르면 그 종목의 분석으로 이동합니다. <b>과거 승률·평균</b>은 지금 켜져 있는 신호들이 이 종목에서 예전에 났을 때 20일 뒤 어떻게 됐는지를 합친 값입니다. 승률이 50% 미만이거나 평균 수익이 마이너스인 종목은 후보에서 빼고 아래에 따로 적었습니다. 표본이 5건 미만이면 판단하지 않고 후보에 남깁니다(과거 승률 칸에 「표본 적음」).</p>
    <p class="note" id="streak-sum">—</p>
    <div class="row-pick" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:8px 0">
      <label for="streak-date"><b>저장된 날짜별 목록</b></label>
      <select id="streak-date" style="font:inherit;padding:6px 8px"><option value="">불러오는 중…</option></select>
      <span class="note" id="streak-date-note"></span>
    </div>
    <div class="tbl-wrap" id="streak-snap-wrap" hidden>
      <table id="streak-snap">
        <thead><tr><th>종목</th><th>연속</th><th>시작일</th><th>시작 후</th><th>그날 상태</th><th>후보일</th><th>반등 확인</th><th>충족일</th><th>그날 종가→현재</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <p class="note" id="streak-snap-note"></p>
    <div class="tbl-wrap">
      <table id="streak-table" data-source="summary" data-row-key="code">
        <thead><tr><th data-field="name">종목</th><th data-field="strong_streak">연속</th><th data-field="strong_ret">시작 후</th><th data-field="hist_win">과거 승률</th><th data-field="hist_avg">과거 평균</th><th data-field="st_ko">진입 상태</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <h2 style="font-size: var(--cds-font-size-body)">곧 5일이 되는 종목 (3~4일 연속)</h2>
    <div class="tbl-wrap">
      <table id="streak-near" data-source="summary" data-row-key="code">
        <thead><tr><th data-field="name">종목</th><th data-field="strong_streak">연속</th><th data-field="strong_ret">시작 후</th><th data-field="hist_win">과거 승률</th><th data-field="hist_avg">과거 평균</th><th data-field="st_ko">진입 상태</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  <h2 style="font-size: var(--cds-font-size-body)">과거 성과가 나빠 제외한 종목</h2>
    <p class="note" id="streak-outnote">—</p>
    <div class="tbl-wrap">
      <table id="streak-out" data-source="summary" data-row-key="code">
        <thead><tr><th data-field="name">종목</th><th data-field="strong_streak">연속</th><th data-field="strong_ret">시작 후</th><th data-field="hist_win">과거 승률</th><th data-field="hist_avg">과거 평균</th><th data-field="st_ko">진입 상태</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <div id="simcard" data-tab="sim"><section class="card"><h2>강한진입 모의투자</h2><p class="note">불러오는 중…</p></section></div>

  <nav class="subnav" data-tab="sector" aria-label="이 탭 안의 구역">
    <button type="button" data-jump="sector">매집이평선 차트</button><button type="button" data-jump="secinv">투자자 매매현황</button><button type="button" data-jump="seclist">업종·구성 종목</button>
  </nav>
  <section class="card" id="sector" data-tab="sector">
    <h2>업종별 수급 — 매집이평선</h2>
    <p class="note" id="sector-basis">불러오는 중…</p>
    <div class="chips" id="sector-chips"></div>
    <div class="row-sec"><button type="button" id="sector-rec">매집 강한 12개 보기</button><button type="button" id="sector-clear">선택 모두 해제</button><span class="note" id="sector-count"></span></div>
    <div class="sector-grid" id="sector-grid"></div>
    <p class="note">각 차트는 최근 약 240거래일입니다. 회색은 매집수량(누적 순매수에서 누적 최저점을 뺀 값), <b style="color:var(--primary,#00855a)">초록</b>은 5일선, <b style="color:var(--warn,#b45f00)">주황</b>은 20일선입니다. 5일선이 20일선 위에 있으면 최근 매집이 이어지는 쪽입니다. 금액은 세력합(외국인+기관계+국가+기타법인+기타외인) 순매수 수량 × 종가의 합입니다. 투자 권유가 아닙니다.</p>
  </section>

  <section class="card" id="secinv" data-tab="sector">
    <h2>업종별 투자자 매매현황 (크레온 0797)</h2>
    <p class="note" id="si-basis">불러오는 중…</p>
    <p class="note" id="si-prog"></p>
    <div class="chips" id="si-mkt"></div>
    <div class="si-ctl"><label>기간 <select id="si-per"></select></label></div>
    <p class="note" id="si-range"></p>
    <div class="tbl-wrap" style="max-height:460px;overflow:auto"><table id="si-table" class="si"><thead></thead><tbody></tbody></table></div>
    <div class="sector-grid" id="si-charts" hidden></div>
    <p class="note">숫자는 순매수 억원입니다. 빨강은 순매수, 파랑은 순매도입니다. 업종 이름 순서는 크레온 화면과 같습니다. 기관계는 금융투자·보험·투신·은행·기타금융·연기금등·사모펀드·국가의 합입니다.</p>
  </section>

  <section class="card" id="seclist" data-tab="sector">
    <h2>업종 목록과 구성 종목</h2>
    <p class="note">크레온의 종목 코드 관리 자료로 만든 코스피·코스닥 업종 분류입니다(HTS 업종 화면과 같은 분류를 쓰지만 화면 자체를 가져온 것은 아닙니다). 업종 줄을 누르면 그 업종에 속한 종목이 아래에 나옵니다. 분석 중인 종목은 「보기」로 분석 화면으로 가고, 아닌 종목은 이 컴퓨터에서 「추가」를 눌러 수집을 요청할 수 있습니다.</p>
    <div class="chips" id="sl-mkt"></div>
    <div class="tbl-wrap" style="max-height:340px;overflow:auto"><table id="sl-table" class="seltbl"><thead><tr><th>업종</th><th>시장</th><th>전체 종목</th><th>분석 중</th><th>매집 상태</th></tr></thead><tbody></tbody></table></div>
    <h3 id="sl-title" style="margin:10px 0 4px;font-size:1rem"></h3>
    <p class="note" id="sl-msg">주도주 순서 = 분석 중인 종목을 최근 20일 세력합(외국인+기관계+국가+기타법인+기타외인) 순매수 금액(수량×종가, 억원)이 큰 순으로 줄 세운 것입니다. 업종 내 비중은 순매수가 플러스인 종목끼리의 몫입니다. 분석 중이 아닌 종목은 순위를 매길 수 없어 아래에 둡니다.</p>
    <div class="tbl-wrap" style="max-height:420px;overflow:auto"><table id="sl-stocks" hidden><thead><tr><th>주도 순위</th><th>종목</th><th>상태</th><th>20일 세력 순매수</th><th>업종 내 비중</th><th>현재가</th><th>20일</th><th></th></tr></thead><tbody></tbody></table></div>
  </section>

  <section class="card" id="analysis" data-tab="report">
    <h2>투자팀 분석</h2>
    <p class="note">사업모델·재무·산업·리스크 4개 관점으로 조사한 뒤 종합 보고서를 만듭니다. 원할 때만 요구하세요. 보통 15~30분 걸리고 이 컴퓨터의 Claude 사용량이 쓰입니다.</p>
    <div id="req-box" class="req-box">
      <button type="button" id="req-btn" class="req-btn" disabled>이 종목 분석 요구</button>
      <p class="note" id="req-note">—</p>
    </div>
    <div id="job-box"></div>
  </section>

  <section class="card" id="reports" data-tab="report">
    <h2>분석 보고서</h2>
    <p class="note" id="rep-note">—</p>
    <div class="tbl-wrap">
      <table id="rep-table">
        <thead><tr><th>종목</th><th>날짜</th><th>점수</th><th>의견</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <div id="rep-view" class="md" hidden></div>
  </section>

  <section class="card" id="find" data-tab="list">
    <h2>종목 검색 · 추가</h2>
    <p class="note">코스피·코스닥 보통주 전체에서 찾을 수 있습니다. 분석 중이 아닌 종목은 <b>이 컴퓨터에서 열었을 때만</b>(127.0.0.1:8770) 「추가」를 눌러 수집을 요청할 수 있습니다. 수집기가 크레온에서 5년치를 받고, 그 뒤로는 매일 코스피200과 함께 갱신합니다. 인터넷에 공개된 사이트에서는 검색만 되고 추가는 되지 않습니다.</p>
    <input type="search" id="find-q" list="find-dl" placeholder="종목명·코드 입력 또는 아래 목록" autocomplete="off" style="width:100%;max-width:28rem;font:inherit;font-size:16px;padding:8px 10px;border:1px solid var(--hairline-strong,#ccc);border-radius:6px">
    <datalist id="find-dl"></datalist>
    <div class="find-pick" style="display:flex;flex-wrap:wrap;gap:6px;margin:8px 0">
      <select id="fp-mkt" aria-label="시장"><option value="">시장 전체</option><option>코스피</option><option>코스닥</option></select>
      <select id="fp-sec" aria-label="업종"><option value="">업종 전체</option></select>
      <select id="fp-stk" aria-label="종목"><option value="">목록에서 종목 고르기…</option></select>
    </div>
    <p class="note" id="find-info"></p>
    <p class="note" id="find-msg"></p>
    <div class="tbl-wrap"><table id="find-table" hidden><thead><tr><th>종목</th><th>시장 · 업종</th><th>상태</th><th></th></tr></thead><tbody></tbody></table></div>
  </section>

  <section class="card" id="rank" data-tab="list">
    <h2>종목 모아보기</h2>
    <p class="note">줄을 누르면 위의 분석이 그 종목으로 바뀝니다. 진입 신호가 있는 종목이 위에 옵니다.</p>
    <div class="tbl-wrap">
      <table id="rank-table" data-source="summary" data-row-key="code">
        <thead><tr><th data-field="name">종목</th><th data-field="verdict">판단</th><th data-field="chg20">20일</th><th data-field="leaders">핵심 세력</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <p class="note disc"><span id="built"></span><span class="ver">화면 v20261027-시장탭 · </span>시트와 같은 규칙으로 계산한 참고 지표이며 투자 권유가 아닙니다. 수급은 거래소+NXT 전체 기준입니다.</p>
</div>

<nav class="tabbar" id="tabbar" aria-label="구역 이동">
  <button type="button" data-go="market"><b>●</b><span>시장</span></button>
  <button type="button" data-go="judge"><b>●</b><span>판단</span></button>
  <button type="button" data-go="streak"><b>●</b><span>강한진입</span></button>
  <button type="button" data-go="sector"><b>●</b><span>업종</span></button>
  <button type="button" data-go="chart"><b>●</b><span>차트</span></button>
  <button type="button" data-go="table"><b>●</b><span>수급표</span></button>
  <button type="button" data-go="force"><b>●</b><span>세력</span></button>
  <button type="button" data-go="report"><b>●</b><span>분석</span></button>
  <button type="button" data-go="sim"><b>●</b><span>모의투자</span></button>
  <button type="button" data-go="list"><b>●</b><span>종목</span></button>
</nav>
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<script>
(() => {

  // ---- 데이터 연결: 정적 JSON (data/summary.json + data/<종목코드>.json) ----
  const COLORS = ['var(--c0)', 'var(--c1)', 'var(--c2)', 'var(--c3)', 'var(--c4)', 'var(--c5)', 'var(--c6)', 'var(--c7)'];
  const st = { summary: { status: 'loading', data: [] }, built: '', code: null, files: null, fstatus: 'loading', renderFn: null };
  const store = (k) => { try { return localStorage.getItem(k); } catch (e) { return null; } };
  const keep = (k, v) => { try { localStorage.setItem(k, v); } catch (e) { /* 저장 불가 환경 */ } };
  const TABS = ['market', 'judge', 'streak', 'sector', 'chart', 'table', 'force', 'report', 'sim', 'list'];
  const hashParts = () => (location.hash || '').replace('#', '').split('/');
  const hashCode = () => (hashParts()[0] || '').toUpperCase();
  const hashTab = () => { const t = hashParts()[1]; return TABS.includes(t) ? t : 'market'; };
  const dash = {
    colors: COLORS,
    data(id) {
      if (id === 'summary') return st.summary;
      if (st.files && st.fstatus === 'ok') return { status: 'ok', data: st.files[id] || [] };
      return { status: st.fstatus === 'error' ? 'error' : 'loading', data: [] };
    },
    params() {
      const rows = st.summary.data;
      const want = hashCode() || store('lastCode') || '005930';
      const ok = rows.find((r) => r.code === want) || rows[0];
      return { code: ok ? ok.code : want };
    },
    setParams(p) { const code = p.code || dash.params().code; let tab = p.tab || hashTab(); if (!p.tab && p.code && tab === 'market') tab = 'judge'; location.hash = code + '/' + tab; },
    onData(fn) { st.renderFn = fn; fn(); }
  };
  let PICKROWS = [];
  const redraw = () => { if (st.renderFn) st.renderFn(); };
  async function loadStock() {
    const code = dash.params().code;
    if (code === st.code && st.fstatus === 'ok') { redraw(); return; }
    st.code = code; st.fstatus = 'loading'; st.files = null; redraw();
    try {
      const r = await fetch('data/' + code + '.json?v=' + encodeURIComponent(st.built), { cache: 'no-cache' });
      if (!r.ok) throw new Error(r.status);
      const f = await r.json();
      if (st.code !== code) return;
      st.files = f; st.fstatus = 'ok'; keep('lastCode', code);
    } catch (e) { if (st.code === code) st.fstatus = 'error'; }
    redraw();
  }
  async function boot() {
    try {
      const r = await fetch('data/summary.json', { cache: 'no-cache' });
      if (!r.ok) throw new Error(r.status);
      const j = await r.json();
      st.summary = { status: 'ok', data: j.stocks }; st.built = j.built || '';
      const b = document.getElementById('built'); if (b) b.textContent = '데이터 갱신 ' + (j.built || '').replace('T', ' ') + ' · ';
    } catch (e) { st.summary = { status: 'error', data: [] }; }
    await probeLocal(); await loadReports(); window.dispatchEvent(new Event('supply-judge')); if (RPT.busy) startPoll();
    await loadStock();
  }
  window.addEventListener('hashchange', loadStock);
  const $ = (id) => document.getElementById(id);
  const num = d3.format(',');
  const pct = d3.format('+.1%');
  const pct0 = d3.format('.0%');
  const parse = (s) => new Date(s + 'T00:00:00Z');
  const fmtDay = d3.utcFormat('%Y-%m-%d');
  const fmtMon = d3.utcFormat('%-m월');
  const shares = (v) => {
    const a = Math.abs(v), s = v < 0 ? '-' : '';
    if (a >= 1e8) return s + (a / 1e8).toFixed(1) + '억주';
    if (a >= 1e4) return s + num(Math.round(a / 1e4)) + '만주';
    return s + num(Math.round(a)) + '주';
  };
  const VCLASS = { '강한 진입': 'v-strong', '진입': 'v-go', '진입 준비': 'v-ready', '관망': 'v-watch', '대기': 'v-wait' };
  const VORDER = { '강한 진입': 0, '진입': 1, '진입 준비': 2, '관망': 3, '대기': 4 };
  const NS = 'http://www.w3.org/2000/svg';

  const fail = (el) => { el.classList.remove('dash-skeleton'); el.replaceChildren(); const d = document.createElement('div'); d.className = 'fail'; d.innerHTML = '<i></i><span>불러오지 못했습니다</span>'; el.appendChild(d); };
  const getCode = () => dash.params().code || '005930';

  // 시계열 선 차트. series: [{key,label,color,width,dash}], rows 는 x 오름차순
  function timeChart(el, o) {
    el.classList.remove('dash-skeleton');
    el.replaceChildren();
    const W = Math.max(280, el.clientWidth || 320), H = o.height || 210;
    const m = { l: 8, r: 8, t: 10, b: 22 };
    const rows = o.rows;
    if (!rows.length) return;
    const ys = [];
    o.series.forEach((s) => rows.forEach((r) => { if (r[s.key] != null) ys.push(r[s.key]); }));
    (o.ref || []).forEach((r) => ys.push(r.y));
    let y0 = o.yMin != null ? o.yMin : d3.min(ys), y1 = o.yMax != null ? o.yMax : d3.max(ys);
    if (y0 === y1) { y0 -= 1; y1 += 1; }
    const pad = (y1 - y0) * 0.06;
    if (o.yMin == null) y0 -= pad;
    if (o.yMax == null) y1 += pad;
    const probe = d3.select(el).append('svg').attr('width', 10).attr('height', 10);
    const t = probe.append('text').attr('font-size', 11).text(o.yFmt(y1 - 0.0001));
    let lw = 0; const tt = [o.yFmt(y1), o.yFmt(y0), o.yFmt((y0 + y1) / 2)];
    tt.forEach((s) => { t.text(s); lw = Math.max(lw, t.node().getComputedTextLength()); });
    probe.remove();
    m.l = Math.ceil(lw) + 10;
    const x = d3.scaleUtc([parse(rows[0][o.x]), parse(rows[rows.length - 1][o.x])], [m.l, W - m.r]);
    const y = d3.scaleLinear([y0, y1], [H - m.b, m.t]);
    const svg = d3.select(el).append('svg').attr('viewBox', `0 0 ${W} ${H}`).attr('width', '100%');
    const yt = y.ticks(4);
    svg.append('g').selectAll('line').data(yt).join('line').attr('x1', m.l).attr('x2', W - m.r).attr('y1', y).attr('y2', y).attr('stroke', 'var(--cds-chart-grid)');
    svg.append('g').selectAll('text').data(yt).join('text').attr('x', m.l - 6).attr('y', y).attr('dy', '0.32em').attr('text-anchor', 'end').attr('font-size', 11).attr('fill', 'var(--color-fg-muted)').text((d) => o.yFmt(d));
    const xt = x.ticks(Math.max(3, Math.floor(W / 90)));
    svg.append('g').selectAll('text').data(xt).join('text').attr('x', x).attr('y', H - 6).attr('text-anchor', 'middle').attr('font-size', 11).attr('fill', 'var(--color-fg-muted)').text((d) => fmtMon(d));
    (o.ref || []).forEach((r) => {
      svg.append('line').attr('x1', m.l).attr('x2', W - m.r).attr('y1', y(r.y)).attr('y2', y(r.y)).attr('stroke', 'var(--cds-chart-reference)').attr('stroke-dasharray', '4 4');
      svg.append('text').attr('x', W - m.r).attr('y', y(r.y) - 4).attr('text-anchor', 'end').attr('font-size', 10).attr('fill', 'var(--color-fg-muted)').text(r.label);
    });
    o.series.forEach((s) => {
      const line = d3.line().defined((r) => r[s.key] != null).x((r) => x(parse(r[o.x]))).y((r) => y(r[s.key]));
      svg.append('path').datum(rows).attr('d', line).attr('fill', 'none').attr('stroke', s.color).attr('stroke-width', s.width || 2).attr('stroke-linejoin', 'round').attr('stroke-linecap', 'round').attr('opacity', s.opacity || 1);
    });
    if (o.markers) {
      const g = svg.append('g');
      o.markers.forEach((mk) => {
        g.selectAll('path.' + mk.cls).data(rows.filter(mk.test)).join('path').attr('class', mk.cls)
          .attr('transform', (r) => `translate(${x(parse(r[o.x]))},${y(r[mk.key]) + (mk.dy || 0)})`)
          .attr('d', d3.symbol().type(mk.symbol).size(mk.size || 70)()).attr('fill', mk.color).attr('stroke', 'var(--color-panel)').attr('stroke-width', 1);
      });
    }
    // 끝점 라벨
    const last = rows[rows.length - 1];
    o.series.forEach((s) => { if (s.end && last[s.key] != null) svg.append('circle').attr('cx', x(parse(last[o.x]))).attr('cy', y(last[s.key])).attr('r', 3.5).attr('fill', s.color); });
    // 툴팁
    const tip = document.createElement('div'); tip.className = 'tip'; tip.hidden = true; el.appendChild(tip);
    const rule = svg.append('line').attr('y1', m.t).attr('y2', H - m.b).attr('stroke', 'var(--cds-chart-axis)').attr('opacity', 0);
    const bis = d3.bisector((r) => parse(r[o.x])).center;
    svg.on('pointermove', (ev) => {
      const px = d3.pointer(ev)[0];
      const r = rows[bis(rows, x.invert(px))];
      if (!r) return;
      rule.attr('x1', x(parse(r[o.x]))).attr('x2', x(parse(r[o.x]))).attr('opacity', 1);
      tip.hidden = false;
      tip.replaceChildren();
      const t1 = document.createElement('div'); t1.className = 't'; t1.textContent = r[o.x]; tip.appendChild(t1);
      o.series.forEach((s) => { if (r[s.key] == null) return; const d = document.createElement('div'); d.textContent = s.label + ' ' + (s.tipFmt || o.yFmt)(r[s.key]); tip.appendChild(d); });
      if (o.tipExtra) { const e = o.tipExtra(r); if (e) { const d = document.createElement('div'); d.textContent = e; tip.appendChild(d); } }
      const tw = tip.offsetWidth, left = Math.min(Math.max(0, (x(parse(r[o.x])) / W) * el.clientWidth - tw / 2), el.clientWidth - tw);
      tip.style.left = left + 'px'; tip.style.top = '0px';
    });
    svg.on('pointerleave', () => { tip.hidden = true; rule.attr('opacity', 0); });
  }

  function legend(el, items) {
    el.replaceChildren();
    items.forEach((it) => {
      const s = document.createElement('span');
      const sw = document.createElementNS(NS, 'svg'); sw.setAttribute('width', 14); sw.setAttribute('height', 14); sw.setAttribute('viewBox', '-7 -7 14 14');
      if (it.symbol) { const p = document.createElementNS(NS, 'path'); p.setAttribute('d', d3.symbol().type(it.symbol).size(60)()); p.setAttribute('fill', it.color); sw.appendChild(p); }
      else { const l = document.createElementNS(NS, 'line'); l.setAttribute('x1', -7); l.setAttribute('x2', 7); l.setAttribute('y1', 0); l.setAttribute('y2', 0); l.setAttribute('stroke', it.color); l.setAttribute('stroke-width', 2.5); sw.appendChild(l); }
      s.appendChild(sw); s.appendChild(document.createTextNode(it.label)); el.appendChild(s);
    });
  }

  function barChart(el, rows) {
    el.classList.remove('dash-skeleton'); el.replaceChildren();
    const W = Math.max(280, el.clientWidth || 320), rowH = 30, m = { l: 74, r: 52, t: 4, b: 4 };
    const H = rows.length * rowH + m.t + m.b;
    const svg = d3.select(el).append('svg').attr('viewBox', `0 0 ${W} ${H}`).attr('width', '100%');
    const x = d3.scaleLinear([0, Math.max(0.01, d3.max(rows, (r) => r.hitrate))], [0, W - m.l - m.r]);
    rows.forEach((r, i) => {
      const yy = m.t + i * rowH;
      const lead = r.leader === 1;
      svg.append('text').attr('x', m.l - 8).attr('y', yy + rowH / 2).attr('dy', '0.32em').attr('text-anchor', 'end').attr('font-size', 12).attr('fill', lead ? 'var(--color-fg)' : 'var(--color-fg-muted)').attr('font-weight', lead ? 600 : 400).text(r.g);
      svg.append('rect').attr('x', m.l).attr('y', yy + 5).attr('height', rowH - 10).attr('width', Math.max(2, x(r.hitrate))).attr('rx', 4).attr('fill', lead ? dash.colors[0] : 'var(--cds-chart-muted)');
      svg.append('text').attr('x', m.l + Math.max(2, x(r.hitrate)) + 6).attr('y', yy + rowH / 2).attr('dy', '0.32em').attr('font-size', 11).attr('fill', 'var(--color-fg-muted)').style('font-variant-numeric', 'tabular-nums').text(pct0(r.hitrate));
    });
  }

  const YG = ['개인', '외국인', '기관계', '금융투자', '보험', '투신', '기타금융', '은행', '연기금등', '사모펀드', '국가', '기타법인', '기타외인'];
  let ymode = 'net';
  const MODE_NOTE = {
    net: '칸은 그 구간의 순매수(초록)·순매도(빨강) 주식 수입니다. 진할수록 많습니다.',
    px: '칸은 그 구간에서 사거나(초록) 판(빨강) 날들의 평균 가격입니다. 순매수 구간은 산 날들, 순매도 구간은 판 날들을 기준으로 합니다.'
  };

  // ---- 투자팀 분석: 요구는 이 컴퓨터(로컬 서버)에서만, 보고서 읽기는 어디서나 ----
  const RPT = { local: false, jobs: [], busy: null, reports: [], timer: null, armed: 0, openFile: null };
  const esc = (t) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const inline = (t) => esc(t)
    .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')
    .replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>').replace(/`([^`]+)`/g, '<code>$1</code>');
  function mdToHtml(md) {
    const L = md.replace(/\r/g, '').split('\n'); const o = []; let i = 0;
    const isTbl = (k) => /^\s*\|.*\|\s*$/.test(L[k] || '') && /^\s*\|[\s:|-]+\|\s*$/.test(L[k + 1] || '');
    while (i < L.length) {
      const ln = L[i];
      if (!ln.trim()) { i++; continue; }
      let m;
      if ((m = ln.match(/^(#{1,4})\s+(.*)$/))) { const n = Math.min(4, m[1].length); o.push('<h' + n + '>' + inline(m[2]) + '</h' + n + '>'); i++; continue; }
      if (/^\s*(-{3,}|\*{3,})\s*$/.test(ln)) { o.push('<hr>'); i++; continue; }
      if (isTbl(i)) {
        const cells = (r) => r.trim().replace(/^\||\|$/g, '').split('|').map((c) => c.trim());
        let h = '<div class="tw"><table><thead><tr>' + cells(ln).map((c) => '<th>' + inline(c) + '</th>').join('') + '</tr></thead><tbody>'; i += 2;
        while (i < L.length && /^\s*\|.*\|\s*$/.test(L[i])) { h += '<tr>' + cells(L[i]).map((c) => '<td>' + inline(c) + '</td>').join('') + '</tr>'; i++; }
        o.push(h + '</tbody></table></div>'); continue;
      }
      if (/^\s*>/.test(ln)) { const q = []; while (i < L.length && /^\s*>/.test(L[i])) { q.push(L[i].replace(/^\s*>\s?/, '')); i++; } o.push('<blockquote>' + q.map(inline).join('<br>') + '</blockquote>'); continue; }
      if (/^\s*([-*]|\d+\.)\s+/.test(ln)) {
        const ord = /^\s*\d+\./.test(ln); const it = [];
        while (i < L.length && /^\s*([-*]|\d+\.)\s+/.test(L[i])) { it.push('<li>' + inline(L[i].replace(/^\s*([-*]|\d+\.)\s+/, '')) + '</li>'); i++; }
        o.push((ord ? '<ol>' : '<ul>') + it.join('') + (ord ? '</ol>' : '</ul>')); continue;
      }
      const p = []; while (i < L.length && L[i].trim() && !/^(#{1,4}\s|\s*>|\s*\|)/.test(L[i]) && !/^\s*([-*]|\d+\.)\s+/.test(L[i])) { p.push(L[i]); i++; }
      o.push('<p>' + p.map(inline).join('<br>') + '</p>');
    }
    return o.join('\n');
  }
  async function probeLocal() {
    if (!/^(127\.0\.0\.1|localhost)$/.test(location.hostname)) { RPT.local = false; return; }
    try {
      const r = await fetch('/api/status', { cache: 'no-store' });
      if (!r.ok || !(r.headers.get('content-type') || '').includes('json')) throw new Error('no api');
      const j = await r.json(); RPT.local = !!j.local; RPT.jobs = j.jobs || []; RPT.busy = j.busy || null;
    } catch (e) { RPT.local = false; RPT.jobs = []; RPT.busy = null; }
  }
  async function loadReports() {
    try { const r = await fetch('reports/index.json?v=' + Date.now(), { cache: 'no-cache' }); RPT.reports = r.ok ? await r.json() : []; } catch (e) { RPT.reports = []; }
  }
  async function pollOnce() {
    const was = RPT.busy;
    await probeLocal();
    if (was && !RPT.busy) await loadReports();
    redraw();
    if (!RPT.busy && RPT.timer) { clearInterval(RPT.timer); RPT.timer = null; }
  }
  function startPoll() { if (!RPT.timer && RPT.local) RPT.timer = setInterval(pollOnce, 5000); }
  async function requestAnalysis(code) {
    try {
      const r = await fetch('/api/analyze', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Local-Analysis': '1' }, body: JSON.stringify({ code }) });
      const j = await r.json();
      if (!r.ok) { $('req-note').textContent = j.error || '요구하지 못했습니다'; return; }
      await probeLocal(); startPoll(); redraw();
    } catch (e) { $('req-note').textContent = '분석 서버에 연결하지 못했습니다'; }
  }
  async function openReport(file) {
    const box = $('rep-view');
    if (RPT.openFile === file) { RPT.openFile = null; box.hidden = true; return; }
    RPT.openFile = file; box.hidden = false; box.textContent = '불러오는 중...';
    try {
      const r = await fetch('reports/' + encodeURIComponent(file) + '?v=' + Date.now(), { cache: 'no-cache' });
      if (!r.ok) throw new Error(r.status);
      box.innerHTML = mdToHtml(await r.text());
      box.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (e) { box.textContent = '보고서를 불러오지 못했습니다'; }
  }
  // ---- 진입 판단 (strategy_core.py 결과를 그대로 표시. 화면에서 다시 계산하지 않음) ----
  const ENT = { meta: null };
  fetch('data/summary.json', { cache: 'no-cache' }).then((r) => r.json()).then((j) => { ENT.meta = j; try { redraw(); } catch (e) {} }).catch(() => {});
  const ST_CLS = { ready: 'ready', hold: 'hold', void: 'void', nodata: 'nodata', watch: 'watch', wait: 'wait' };
  function renderEntry(cur) {
    const sec = $('entry');
    if (!cur.st_ko) { sec.hidden = true; return; }
    const final = cur.final === 0 ? '잠정(당일 20:30 확정 전)' : '확정';
    $('entry-head').innerHTML = '<span class="st ' + (ST_CLS[cur.st] || '') + '">' + cur.st_ko + '</span> ' +
      (cur.cand_date ? '후보일 <b>' + cur.cand_date + '</b> · ' + cur.cand_types : '최근 후보 없음') +
      (cur.confirm_date ? ' · 반등 확인일 <b>' + cur.confirm_date + '</b>' : '') +
      (cur.entry_date ? ' · 진입 조건 충족일 <b>' + cur.entry_date + '</b>' : '') +
      (cur.valid_left != null ? ' · 후보 유효기간 ' + cur.valid_left + '거래일 남음' : '');
    $('entry-reason').textContent = cur.reason || '';
    const lab = { pass: '통과', fail: '미통과', na: '미확인', off: '꺼짐' };
    $('entry-conds').replaceChildren(...(cur.conds || []).map((c) => {
      const li = document.createElement('li'); li.className = "e-" + c[1];
      const m = document.createElement('span'); m.className = 'm'; m.textContent = lab[c[1]] || c[1];
      const n = document.createElement('span'); n.textContent = c[0];
      const t = document.createElement('span'); t.className = 't'; t.textContent = c[2];
      li.append(m, n, t); return li;
    }));
    $('entry-nums').textContent = '보조 지표 — 최근 5일 외국인+기관계 순매수 ' + (cur.flow_s5 == null ? '미확인' : num(cur.flow_s5) + '주') +
      ' · 순매수일 ' + (cur.flow_d5 == null ? '미확인' : cur.flow_d5 + '일') +
      ' · 5일 순매수/5일 거래량 ' + (cur.flow_r5 == null ? '미확인' : (cur.flow_r5 * 100).toFixed(1) + '%') +
      (cur.rb_ref ? ' · 반등 기준(직전 3거래일 최고 종가) ' + num(cur.rb_ref) + '원' : '') + '. 외국인+기관계만 더했고 기관 세부 주체는 중복 합산하지 않았습니다.';
    $('entry-px').textContent = cur.has_ohlc
      ? '진입 전 가격 기준(거래소 시세) — 예상 매수가 ' + (cur.exp_buy == null ? '-' : num(cur.exp_buy) + '원(오늘 종가)') + ' · 무효화 가격 ' + (cur.inv_price == null ? '-' : num(cur.inv_price) + '원(최근 10일 최저 저가)') +
        ' · 저항 가격 ' + (cur.resist == null ? '-' : num(cur.resist) + '원(최근 60일 최고 고가)') + ' · 예상 손익비 ' + (cur.rr == null ? '판단 불가 — ' + (cur.rr_why || '') : cur.rr.toFixed(2) + ' : 1') +
        '. 목표가는 조건을 맞추려고 조정하지 않았고, 손절가에 반드시 체결된다고 가정하지 않습니다. 무효화 가격은 진입 판단 기준이며, 첫 매수 뒤 보유 중 손절은 모의투자의 기존 규칙(전체의 50% 진입 후 평균단가 -10%)을 그대로 따릅니다.'
      : '예상 매수가·무효화 가격·저항 가격·예상 손익비: 판단 불가 — 이 종목의 시세(시가·고가·저가) 자료가 없거나 아직 적용 전입니다.';
    const m = ENT.meta && ENT.meta.market;
    $('entry-mkt').textContent = '시장 환경(참고용, 진입 조건 아님): ' + (m ? m.state + (m.ret20 != null ? ' · 대리지수 20일 ' + pct(m.ret20) : '') + (cur.rel20 != null ? ' · 이 종목 20일과의 차이 ' + pct(cur.rel20) : '') + ' — ' + m.basis : '미확인');
    $('entry-meta').textContent = '데이터 기준일 ' + cur.asof + ' (' + final + ') · 적용 전략: ' + (cur.cfg_ver || '-') + ' · 수치(반등 비교 3거래일·수급 5일·순매수일 3일 이상·유효 10거래일·무효화 7%)는 검증용 초기값이며 최적값이 아닙니다.';
  }

  // ---- 강한진입 날짜별 저장 목록 ----
  const SNAP = { idx: null, cache: {} };
  async function loadSnapIndex() {
    try {
      const r = await fetch('data/strong/index.json', { cache: 'no-cache' }); if (!r.ok) throw 0;
      SNAP.idx = await r.json();
      const sel = $('streak-date');
      sel.replaceChildren(...SNAP.idx.dates.map((d) => new Option(d.d + ' · ' + d.n + '종목' + (d.n5 ? '(5일↑ ' + d.n5 + ')' : '') + (d.final ? '' : ' · 잠정'), d.d)));
      if (SNAP.idx.dates.length) { sel.value = SNAP.idx.dates[0].d; showSnap(sel.value); }
      else sel.replaceChildren(new Option('저장된 날짜 없음', ''));
    } catch (e) { $('streak-date').replaceChildren(new Option('날짜 목록 없음', '')); $('streak-date-note').textContent = '아직 날짜별 목록이 만들어지지 않았습니다.'; }
  }
  async function showSnap(d) {
    if (!d) return;
    let o = SNAP.cache[d];
    if (!o) { try { const r = await fetch('data/strong/' + d + '.json', { cache: 'no-cache' }); o = await r.json(); SNAP.cache[d] = o; } catch (e) { $('streak-snap-note').textContent = d + ' 목록을 불러오지 못했습니다.'; return; } }
    const S = dash.data('summary'), now = {}; (S.data || []).forEach((r) => { now[r.code] = r; });
    const SK = { watch: '관심 후보', wait: '반등 대기', hold: '매수 보류', ready: '진입 조건 충족', void: '후보 무효', '': '-' };
    const tb = $('streak-snap').tBodies[0];
    tb.replaceChildren(...o.stocks.map((r) => {
      const tr = document.createElement('tr'); tr.dataset.key = r.c;
      const cur = now[r.c], ch = cur ? cur.close / r.p - 1 : null;
      [r.n, r.s + '일', r.sf.slice(5), pct(r.ret), SK[r.st] || r.st, r.cd ? r.cd.slice(5) : '-', r.cf ? r.cf.slice(5) : '-', r.en ? r.en.slice(5) : '-', num(r.p) + ' → ' + (cur ? num(cur.close) + ' (' + pct(ch) + ')' : '-')].forEach((t, i) => {
        const td = document.createElement('td'); td.textContent = t; if (i === 3 || i === 8) td.className = (i === 3 ? r.ret : ch) >= 0 ? 'chg-up' : 'chg-dn'; tr.appendChild(td);
      });
      return tr;
    }));
    $('streak-snap-wrap').hidden = false;
    $('streak-date-note').textContent = '저장 방식: ' + (o.src || '-') + ' · ' + (o.final ? '확정' : '잠정') + ' · 전략 ' + (o.cfg || '-');
    $('streak-snap-note').textContent = '연속 3일 이상인 종목을 그날 종가까지의 자료로 계산해 저장한 목록입니다. 「재구성」은 저장 기능이 생기기 전 날짜를 현재 보관 자료로 다시 만든 것입니다. 과거 성과 제외 필터는 그날 알 수 없던 정보를 쓰게 되므로 적용하지 않았습니다.' + (o.stocks.length ? '' : ' 이 날짜에는 해당 종목이 없습니다.');
  }
  $('streak-date').addEventListener('change', (e) => showSnap(e.target.value));
  $('streak-snap').addEventListener('click', (ev) => { const tr = ev.target.closest('tr[data-key]'); if (tr) { dash.setParams({ code: tr.dataset.key, tab: 'judge' }); window.scrollTo({ top: 0 }); } });
  loadSnapIndex();

  // ---- 종합 판단 = 수급 후보 + 진입 확인(strategy_core 결과) + 분석 보고서 ----
  const latestReport = (code, asOf) => RPT.reports.filter((r) => r.code === code && (!asOf || String(r.date).slice(0, 10) <= asOf)).sort((a, b) => (a.date < b.date ? 1 : -1))[0] || null;
  function reportTone(r) {
    const o = String(r.opinion || '');
    if (/(매도|회피|비중\s*축소|부정|투자\s*금지)/.test(o)) return 'neg';
    if (/(관망|중립|보유|Hold)/i.test(o)) return 'neu';
    if (/(매수|비중\s*확대|긍정|Buy)/i.test(o)) return 'pos';
    const sc = Number(r.score);
    if (!isNaN(sc)) return sc >= 3.5 ? 'pos' : sc < 2.0 ? 'neg' : 'neu';
    return 'neu';
  }
  const daysAgo = (d) => { const t = Date.parse(String(d).slice(0, 10)); return isNaN(t) ? null : Math.max(0, Math.round((Date.now() - t) / 86400000)); };
  // ---- 종합 판단 기준선(개인 설정, 이 브라우저에 저장) ----
  const JKEY = 'supply-judge.v2';   // v2: 추세 확인 도입·기본 기준선 변경(백테스트 근거). v1 저장값은 쓰지 않음
  const JDEF = { minSignals: 2, trend: true, trendReb: true, req: { rebound: false, flowSum: false, flowDays: false, chase: true, rr: false, liq: true }, repMode: 'optional', repBuy: 3.5, repBlock: 2.0, blockFlags: true, unknown: 'pass' };
  const jclone = (o) => JSON.parse(JSON.stringify(o));
  let JSET = jclone(JDEF);
  try { const j = JSON.parse(store(JKEY) || 'null'); if (j) { JSET = Object.assign(jclone(JDEF), j); JSET.req = Object.assign(jclone(JDEF.req), j.req || {}); } } catch (e) {}
  const jsave = () => { keep(JKEY, JSON.stringify(JSET)); window.dispatchEvent(new Event('supply-judge')); };
  const condKey = (n) => /가격 반등/.test(n) ? 'rebound' : /순매수 합/.test(n) ? 'flowSum' : /순매수일/.test(n) ? 'flowDays' : /추격매수/.test(n) ? 'chase' : /손익비/.test(n) ? 'rr' : /유동성|거래정지/.test(n) ? 'liq' : /급등일/.test(n) ? 'surge' : null;
  const COND_KO = { rebound: '가격 반등 확인', flowSum: '5일 외국인+기관 순매수 합 > 0', flowDays: '5일 중 순매수일 ≥ 3일', chase: '추격매수 제한(다음날 시가 갭)', rr: '예상 손익비', liq: '유동성·거래정지' };
  const JLAB = { buy: '매수진입', wait: '매수대기', hold: '매수보류', no: '매수불가' };
  const JCLS = { buy: 'v-buy', wait: 'v-wait4', hold: 'v-hold', no: 'v-no' };

  function finalJudge(cur, rep) {
    const S = JSET, L = {};
    const nsig = cur.cnt != null ? cur.cnt : 0;
    const why = [];                                   // 판단 이유(굵은 판정 아래에 표시)
    // 보고서
    const sc = rep ? Number(rep.score) : null;
    const negTxt = rep && /(매도|회피|비중\s*축소|부정)/.test(String(rep.opinion || ''));
    const repOn = S.repMode !== 'ignore';
    const repBlocked = !!(rep && repOn && ((sc != null && !isNaN(sc) && sc < S.repBlock) || negTxt));
    const repLow = !!(rep && repOn && sc != null && !isNaN(sc) && sc < S.repBuy);
    const repMissing = !rep && S.repMode === 'required';
    // 종목 상태 표시(투자경고 등)
    const flags = [];
    if ((cur.ctl || 0) >= 2) flags.push(cur.ctl === 2 ? '투자경고' : cur.ctl === 3 ? '투자위험예고' : '투자위험');
    if (cur.mng) flags.push('관리종목');
    if (cur.halt) flags.push('거래정지');
    // ① 후보
    const candOk = cur.st !== 'void' && cur.st !== 'nodata' && nsig >= S.minSignals;
    L.cand = { state: candOk ? 'pass' : 'fail', text: '수급 신호 ' + nsig + '/3개 (기준 ' + S.minSignals + '개 이상) · 후보 상태 ' + (cur.st_ko || '-') };
    // ② 진입 확인(필수로 고른 조건만)
    const waits = [], holds = [], noes = [], unk = [];
    let reqN = 0, passN = 0;
    (cur.conds || []).forEach((c) => {
      const k = condKey(c[0]); if (!k || k === 'surge' || !S.req[k] || c[1] === 'off') return;
      reqN++;
      if (c[1] === 'pass') { passN++; return; }
      if (c[1] === 'fail') { if (k === 'rebound') waits.push(COND_KO[k]); else if (k === 'liq') noes.push(COND_KO[k]); else holds.push(COND_KO[k]); return; }
      if (k === 'chase' && /대기/.test(c[2] || '')) { waits.push('다음 거래일 시가 갭 확인'); return; }
      if (/해당 없음/.test(c[2] || '')) { passN++; return; }
      if (S.unknown === 'block') holds.push(COND_KO[k] + '(미확인)'); else { passN++; unk.push(COND_KO[k]); }
    });
    L.entry = { state: noes.length ? 'fail' : holds.length ? 'fail' : waits.length ? 'wait' : 'pass', text: '필수 조건 ' + passN + '/' + reqN + ' 통과' + (noes.concat(holds).length ? ' · 미통과: ' + noes.concat(holds).join(', ') : '') + (waits.length ? ' · 대기: ' + waits.join(', ') : '') + (unk.length ? ' · 미확인(통과로 봄): ' + unk.join(', ') : '') };
    // ③ 추세 확인 (분산비 분석·백테스트: 종가가 20일선 +8.5%↑ & 세력 5일 순매수가 거래대금의 2.5% 이하 / 오늘 반등)
    const hasTrend = cur.trend_ok != null;
    const vsTxt = cur.vs20 == null ? '-' : (cur.vs20 * 100).toFixed(1) + '%', flTxt = cur.flow_f5 == null ? '-' : (cur.flow_f5 * 100).toFixed(1) + '%';
    const trendOn = !!S.trend && hasTrend;
    const trendFail = trendOn && !cur.trend_ok;
    const rebWait = trendOn && cur.trend_ok && !!S.trendReb && !cur.reb3;
    L.trend = { state: !trendOn ? 'none' : trendFail ? 'fail' : rebWait ? 'wait' : 'pass',
      text: (!S.trend ? '사용 안 함으로 설정됨' : !hasTrend ? '추세 자료 없음' : '20일선 대비 ' + vsTxt + '(기준 +8.5% 이상) · 세력 5일 순매수 ' + flTxt + '(기준 거래대금의 2.5% 이하)'
        + (S.trendReb ? ' · 오늘 반등 ' + (cur.reb3 ? '확인' : '아직') : '')) + (cur.heat ? ' · ▲ 세력 분산비 95%↑: 이미 많이 오른 뒤라 과거 성과가 약했던 구간(표시만)' : '') };
    // ④ 보고서
    L.rep = { state: !rep ? 'none' : !repOn ? 'none' : repBlocked ? 'fail' : repLow ? 'warn' : 'pass',
      text: !rep ? '보고서 없음(' + (S.repMode === 'required' ? '필수로 설정됨' : S.repMode === 'ignore' ? '반영 안 함으로 설정됨' : '있으면 반영, 없어도 진행') + ')'
        : '점수 ' + rep.score + '점 · ' + rep.opinion + ' (진입 기준 ' + S.repBuy + '점 이상, 불가 기준 ' + S.repBlock + '점 미만)' + (!repOn ? ' · 반영 안 함으로 설정됨' : '') };
    L.flags = { state: flags.length ? (S.blockFlags ? 'fail' : 'warn') : 'pass', text: flags.length ? flags.join(', ') + (S.blockFlags ? ' — 매수불가 설정' : ' (표시만)') : '이상 없음' };
    let key;
    if (S.blockFlags && flags.length) { key = 'no'; why.push(flags.join('·') + ' 종목입니다'); }
    else if (cur.st === 'nodata') { key = 'no'; why.push(cur.reason || '자료가 맞지 않아 판단하지 않습니다'); }
    else if (cur.st === 'void') { key = 'no'; why.push(cur.reason || '후보가 무효가 되었습니다'); }
    else if (!candOk && trendOn && cur.trend_ok) { key = 'hold'; why.push('추세는 강하지만 수급 신호가 ' + nsig + '개로 기준(' + S.minSignals + '개)에 못 미칩니다. 추세 단독은 과거 백테스트에서 낙폭이 컸습니다'); }
    else if (!candOk) { key = 'no'; why.push('수급 신호가 ' + nsig + '개로 기준(' + S.minSignals + '개)에 못 미쳐 후보가 아닙니다'); }
    else if (repBlocked) { key = 'no'; why.push('분석 보고서가 부정적입니다(' + rep.score + '점·' + rep.opinion + ')'); }
    else if (noes.length) { key = 'no'; why.push(noes.join(', ') + ' 조건을 통과하지 못했습니다'); }
    else if (trendFail) { key = 'hold'; why.push('수급 신호는 겹쳤지만 추세가 확인되지 않습니다(20일선 대비 ' + vsTxt + ', 세력 5일 순매수 ' + flTxt + '). 추세 없이 신호만 겹친 구간은 과거에 시장 평균 수준이었습니다'); }
    else if (holds.length) { key = 'hold'; why.push(holds.join(', ') + ' 조건이 아직 맞지 않아 보류합니다'); }
    else if (waits.length) { key = 'wait'; why.push(waits.join(', ') + '를(을) 기다리는 중입니다'); }
    else if (rebWait) { key = 'wait'; why.push('수급 신호와 추세는 맞습니다. 오늘 종가가 직전 3거래일 최고 종가를 넘는 반등 확인을 기다리는 중입니다'); }
    else if (repMissing) { key = 'wait'; why.push('보고서를 필수로 설정했는데 분석 보고서가 없습니다. 분석을 요구하세요'); }
    else if (repLow) { key = 'hold'; why.push('수급 조건은 맞지만 분석 보고서가 ' + rep.score + '점(' + rep.opinion + ')으로 진입 기준 ' + S.repBuy + '점에 못 미칩니다'); }
    else { key = 'buy'; why.push((trendOn ? '수급 신호 + 추세 + 반등 확인을 통과했습니다(과거 백테스트에서 가장 좋았던 조합)' : '설정한 기준선을 모두 통과했습니다') + (!rep && repOn ? ' (분석 보고서 없음: 수급 규칙만으로 판단)' : '')); }
    if (key !== 'buy' && key !== 'no' && rep && repOn) why.push('분석 보고서 ' + rep.score + '점(' + rep.opinion + ') 반영됨');
    return { key, label: JLAB[key], cls: JCLS[key], reason: why.join(' · '), layers: L };
  }
  function renderBasis(fj) {
    const ico = { pass: '✔', fail: '✖', wait: '…', warn: '▲', none: '-' }, nm = { cand: '① 수급 후보', entry: '② 진입 확인', trend: '③ 추세 확인', rep: '④ 분석 보고서', flags: '종목 상태' };
    $('jb-list').replaceChildren(...['cand', 'entry', 'trend', 'rep', 'flags'].map((k) => {
      const l = fj.layers[k], li = document.createElement('li'); li.className = 'jb-' + l.state;
      const m = document.createElement('span'); m.className = 'jb-ico'; m.textContent = ico[l.state];
      const t = document.createElement('b'); t.textContent = nm[k];
      const d = document.createElement('span'); d.className = 'jb-t'; d.textContent = l.text;
      li.append(m, t, d); return li;
    }));
  }
  window.supplyReport = (code) => latestReport(code);
  window.supplyJudge = (cur) => finalJudge(cur, latestReport(cur.code));      // 모의투자 탭이 같은 종합 판단을 쓰도록 내보낸다
  function syncJSet() {
    $('js-min').value = JSET.minSignals; $('js-rep').value = JSET.repMode; $('js-buy').value = JSET.repBuy; $('js-block').value = JSET.repBlock; $('js-flag').checked = !!JSET.blockFlags; $('js-unk').value = JSET.unknown; $('js-trend').checked = !!JSET.trend; $('js-trendreb').checked = !!JSET.trendReb;
    document.querySelectorAll('#jset [data-req]').forEach((c) => { c.checked = !!JSET.req[c.dataset.req]; });
  }
  document.querySelectorAll('#jset input, #jset select').forEach((e) => e.addEventListener('change', () => {
    JSET.minSignals = Math.min(3, Math.max(1, Number($('js-min').value) || JDEF.minSignals)); JSET.repMode = $('js-rep').value;
    JSET.repBuy = Number($('js-buy').value); if (isNaN(JSET.repBuy)) JSET.repBuy = JDEF.repBuy;
    JSET.repBlock = Number($('js-block').value); if (isNaN(JSET.repBlock)) JSET.repBlock = JDEF.repBlock;
    JSET.blockFlags = $('js-flag').checked; JSET.unknown = $('js-unk').value; JSET.trend = $('js-trend').checked; JSET.trendReb = $('js-trendreb').checked;
    document.querySelectorAll('#jset [data-req]').forEach((c) => { JSET.req[c.dataset.req] = c.checked; });
    jsave(); syncJSet(); redraw();
  }));
  $('js-reset').addEventListener('click', () => { JSET = jclone(JDEF); jsave(); syncJSet(); redraw(); });
  syncJSet();

  // ---- 강한진입 탭: 종합 판단별 목록 ----
  const JL = { key: 'all', q: '', strong: false, date: '', cache: {}, idx: null };
  const JV = ['강한 진입', '진입', '진입 준비', '관망', '대기'], JST = { n: '', w: 'watch', a: 'wait', h: 'hold', r: 'ready', v: 'void', x: 'nodata' };
  const JSK = { '': '후보 없음', watch: '관심 후보', wait: '반등 대기', hold: '매수 보류', ready: '진입 조건 충족', void: '후보 무효', nodata: '데이터 부족' };
  const JCN = ['가격 반등 확인', '최근 5일 외국인+기관 순매수 합 > 0', '최근 5일 중 순매수일 ≥ 3일', '추격매수 제한(다음날 시가 갭)', '예상 손익비 ≥ 2.0', '유동성(20일 평균 거래대금)'];
  // 날짜별 과거 자료 [코드, 이름, 신호 수, 판정 번호, 상태, 조건 6글자, 20일, 연속] 를 finalJudge 가 읽는 형태로 바꾼다
  function pseudoRows(J) {
    return J.stocks.map(([code, name, cnt, vi, stc, cc, chg, cons]) => {
      const st = JST[stc] || '';
      const conds = JCN.map((nm, i) => { const ch = cc[i]; const state = ch === 'p' ? 'pass' : ch === 'f' ? 'fail' : 'na'; return [nm, state, ch === 'w' ? '대기 — 다음 거래일 시가 확인' : ch === 'n' ? (i === 3 ? '해당 없음' : '미확인 — 과거 기록 없음') : '']; });
      return { code, name, cnt, verdict: JV[vi], st, st_ko: JSK[st], reason: '과거 기록: ' + JSK[st], conds, chg20: chg, strong_streak: cons, asof: J.date, ctl: 0, mng: 0, halt: 0 };
    });
  }
  async function loadJudgeDay(d) {
    try { JL.cache[d] = await (await fetch('data/judge/' + d + '.json', { cache: 'no-cache' })).json(); } catch (e) { JL.cache[d] = { date: d, stocks: [] }; }
    redraw();
  }
  (async () => {
    try {
      JL.idx = await (await fetch('data/judge/index.json', { cache: 'no-cache' })).json();
      $('jl-date').replaceChildren(new Option('최신 (오늘 자료)', ''), ...JL.idx.dates.map((d) => new Option(d, d)));
    } catch (e) { $('jl-date').title = '날짜별 자료가 아직 없습니다'; }
  })();
  $('jl-date').addEventListener('change', (e) => { JL.date = e.target.value; if (JL.date && !JL.cache[JL.date]) loadJudgeDay(JL.date); else redraw(); });
  const JORDER = { buy: 0, wait: 1, hold: 2, no: 3 };
  function renderJList(rows) {
    if (!$('jl-chips')) return;
    try { renderLimitUp(rows); } catch (e) {}
    try { renderMarket(rows); } catch (e) {}
    let asOf = null;
    if (JL.date) { const J = JL.cache[JL.date]; if (!J) { $('jl-sum').textContent = JL.date + ' 자료를 불러오는 중…'; return; } rows = pseudoRows(J); asOf = JL.date; }
    const list = rows.map((r) => { const rp = latestReport(r.code, asOf), fj = finalJudge(r, rp); return { r, rp, fj }; });
    const cnt = { all: list.length, buy: 0, wait: 0, hold: 0, no: 0 }; list.forEach((x) => { cnt[x.fj.key]++; });
    $('jl-chips').replaceChildren(...[['all', '전체'], ['buy', '매수진입'], ['wait', '매수대기'], ['hold', '매수보류'], ['no', '매수불가']].map(([k, t]) => {
      const b = document.createElement('button'); b.type = 'button'; b.dataset.k = k; b.className = 'jl-chip ' + k; b.setAttribute('aria-pressed', JL.key === k ? 'true' : 'false'); b.textContent = t + ' ' + cnt[k]; return b;
    }));
    const q = JL.q.trim().toLowerCase();
    const shown = list.filter((x) => (JL.key === 'all' || x.fj.key === JL.key) && (!JL.strong || x.r.strong_streak >= 3) && (!q || x.r.name.toLowerCase().includes(q) || x.r.code.startsWith(q.toUpperCase())))
      .sort((a, b) => (JORDER[a.fj.key] - JORDER[b.fj.key]) || (b.r.strong_streak - a.r.strong_streak) || a.r.name.localeCompare(b.r.name, 'ko'));
    $('jl-sum').textContent = shown.length + '종목' + (JL.key !== 'all' ? ' · ' + ({ buy: '매수진입', wait: '매수대기', hold: '매수보류', no: '매수불가' })[JL.key] : '') + ' (전체 ' + list.length + '종목 · 기준 ' + (rows[0] ? rows[0].asof : '') + ')' + (asOf ? ' · 그날 종가까지의 자료로 다시 계산한 과거 판정(종목 상태·일부 판정 라벨은 단순화, 그날 이전에 나온 분석 보고서만 반영)' : '');
    $('jl-table').tBodies[0].replaceChildren(...shown.map((x) => {
      const tr = document.createElement('tr'); tr.dataset.key = x.r.code;
      const c = (t) => { const td = document.createElement('td'); td.textContent = t; return td; };
      const tg = document.createElement('td'); const b = document.createElement('span'); b.className = 'jtag ' + x.fj.key; b.textContent = x.fj.label; tg.appendChild(b); tg.title = x.fj.reason;
      const L = x.fj.layers;
      tr.append(c(x.r.name), tg, c(x.r.verdict + ' (' + (x.r.cnt || 0) + '/3)'), c(x.r.st_ko || '-'), c(x.rp ? x.rp.score + '점·' + x.rp.opinion : '없음'), c(pct(x.r.chg20)), c(x.r.strong_streak ? x.r.strong_streak + '일' : '-'));
      return tr;
    }));
  }

  // ---- 상한가 종목 모음(강한진입 탭): data/limitup.json
  const LU = { d: null, date: '' };
  async function loadLimitUp() {
    try { LU.d = await (await fetch('data/limitup.json?v=' + Date.now(), { cache: 'no-cache' })).json(); } catch (e) { LU.d = null; }
    if (!LU.d || !LU.d.dates.length) { $('lu-sum').textContent = '상한가 자료가 아직 없습니다.'; return; }
    $('lu-date').replaceChildren(...LU.d.dates.map((d) => new Option(d + ' (' + (LU.d.items[d] || []).length + '종목)', d)));
    LU.date = LU.d.dates[0];
    renderLimitUp(window.__lastRows || []);
  }
  function renderLimitUp(rows) {
    window.__lastRows = rows;
    if (!LU.d || !$('lu-table')) return;
    const by = {}; rows.forEach((r) => { by[r.code] = r; });
    const items = (LU.d.items[LU.date] || []);
    const latest = LU.date === LU.d.dates[0];
    $('lu-sum').textContent = LU.date + ' 상한가 ' + items.length + '종목' + (latest ? '' : ' · 종합 판단과 수급 후보는 오늘(최신) 기준입니다') + ' · 구분: 실제=수집기가 그날 마감 후 확인, 추정=종가 상승률 29.5% 이상(분석 중인 종목만)';
    $('lu-table').tBodies[0].replaceChildren(...items.map(([code, name, close, chg, real]) => {
      const r = by[code]; const tr = document.createElement('tr'); tr.dataset.key = code;
      const c = (t) => { const td = document.createElement('td'); td.textContent = t; return td; };
      const tg = document.createElement('td');
      if (r) { const fj = finalJudge(r, latestReport(r.code)); const b = document.createElement('span'); b.className = 'jtag ' + fj.key; b.textContent = fj.label; tg.appendChild(b); tg.title = fj.reason; } else tg.textContent = '-';
      tr.append(c(name), c(real ? '실제' : '추정'), c(close ? close.toLocaleString() : '-'), c(real ? '상한가' : (chg == null ? '-' : '+' + (chg * 100).toFixed(1) + '%')), tg, c(r ? r.verdict + ' (' + (r.cnt || 0) + '/3)' : '-'), c(r ? pct(r.chg20) : '-'));
      return tr;
    }));
  }
  $('lu-date').addEventListener('change', (e) => { LU.date = e.target.value; renderLimitUp(window.__lastRows || []); });
  $('lu-table').addEventListener('click', (e) => { const tr = e.target.closest('tr[data-key]'); if (tr) { dash.setParams({ code: tr.dataset.key, tab: 'judge' }); window.scrollTo({ top: 0 }); } });
  loadLimitUp();

  // ---- 시장 탭(오늘의 수급): data/market.json ----
  const MK = { d: null, p: '1', rows: [] };
  const mkEsc = (t) => String(t == null ? '' : t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  const mkCls = (v) => (v > 0 ? 'pos' : v < 0 ? 'neg' : '');
  const mkAmt = (v) => { if (v == null || isNaN(v)) return '-'; const a = Math.abs(v), sg = v > 0 ? '+' : v < 0 ? '−' : ''; return sg + (a >= 10000 ? (a / 10000).toFixed(2) + '조' : Math.round(a).toLocaleString('ko-KR') + '억'); };
  const mkPct = (c) => (c == null ? '-' : (c >= 0 ? '+' : '−') + (Math.abs(c) * 100).toFixed(1) + '%');
  const mkTag = (by, code) => { const r = by[code]; if (!r) return ''; try { const fj = finalJudge(r, latestReport(r.code)); return '<span class="jtag ' + fj.key + '" title="' + mkEsc(fj.reason) + '">' + fj.label + '</span>'; } catch (e) { return ''; } };
  async function loadMarket() {
    try { MK.d = await (await fetch('data/market.json?v=' + Date.now(), { cache: 'no-cache' })).json(); } catch (e) { MK.d = null; }
    if (!MK.d) { $('mk-line').textContent = '시장 수급 자료를 불러오지 못했습니다. 다음 갱신 뒤 다시 확인해 주세요.'; return; }
    renderMarket(MK.rows);
  }
  function mkRow(by, it, rk, idx, key) {
    // it: [코드, 이름, 외국인, 기관, 개인, 등락률]
    const v = it[idx];
    return '<button type="button" class="mk-row" data-code="' + mkEsc(it[0]) + '"><span class="rk">' + rk + '</span><span class="nm">' + mkEsc(it[1]) + '<small>' + mkTag(by, it[0]) + '</small></span>'
      + '<span class="amt ' + mkCls(v) + '">' + mkAmt(v) + '<small class="' + mkCls(it[5]) + '">' + mkPct(it[5]) + '</small></span><span></span></button>';
  }
  function renderMarket(rows) {
    MK.rows = rows || [];
    const d = MK.d; if (!d || !$('mk-sum')) return;
    const by = {}; MK.rows.forEach((r) => { by[r.code] = r; });
    $('mk-date').textContent = d.date + ' 기준 · 분석 ' + d.n + '종목';
    // 한 줄 요약 + 시장별 카드(거래소 기준 0797)
    const word = (v) => (v > 0 ? '순매수' : v < 0 ? '순매도' : '보합');
    const lines = [], cards = [];
    ['코스피', '코스닥'].forEach((m) => {
      const k = d.mk && d.mk[m]; if (!k || !k.d1) return;
      const [ind, fgn, ins] = k.d1;
      lines.push('<b>' + m + '</b> 외국인 <b class="' + mkCls(fgn) + '">' + mkAmt(fgn) + '</b> ' + word(fgn) + ' · 기관 <b class="' + mkCls(ins) + '">' + mkAmt(ins) + '</b> ' + word(ins) + ' · 개인 <b class="' + mkCls(ind) + '">' + mkAmt(ind) + '</b> ' + word(ind));
      const n5 = Math.min(k.days, 5);
      const cell = (nm, v, v5) => '<div class="cell"><span>' + nm + '</span><b class="' + mkCls(v) + '">' + mkAmt(v) + '</b>' + (v5 != null && k.days >= 2 ? '<em class="' + mkCls(v5) + '">' + n5 + '일 ' + mkAmt(v5) + '</em>' : '') + '</div>';
      cards.push('<div class="mk-kpi"><h3>' + m + ' <small style="font-weight:400;color:var(--color-fg-muted)">' + k.date + ' · 거래소 기준</small></h3><div class="cells">' + cell('외국인', fgn, k.d5 && k.d5[1]) + cell('기관', ins, k.d5 && k.d5[2]) + cell('개인', ind, k.d5 && k.d5[0]) + '</div></div>');
    });
    const P1 = d.periods['1'];
    if (P1 && P1.f_buy[0] && P1.i_buy[0]) lines.push('분석 종목 중 외국인 순매수 1위 <b>' + mkEsc(P1.f_buy[0][1]) + '</b> ' + mkAmt(P1.f_buy[0][2]) + ', 기관 순매수 1위 <b>' + mkEsc(P1.i_buy[0][1]) + '</b> ' + mkAmt(P1.i_buy[0][3]) + (P1.both.length ? ', 쌍끌이 ' + P1.both.length + '종목' : ''));
    $('mk-line').innerHTML = lines.length ? lines.map((t) => '<div>' + t + '</div>').join('') : '시장 수급 자료가 아직 없습니다.';
    $('mk-kpis').innerHTML = cards.join('');
    $('mk-note').textContent = '시장별 순매수는 크레온 0797(거래소 기준, 억원)을 매일 저장한 값입니다(저장 ' + d.saved_days + '일, 5일 누적은 저장된 날 기준). 코스피·코스닥 종목별 순위와 누적은 분석 종목 기준입니다.';
    // 누적 표
    const acc = [['외국인', 0], ['기관', 1], ['개인', 2]];
    $('mk-acc-t').tBodies[0].innerHTML = acc.map(([nm, i]) => '<tr><td>' + nm + '</td>' + ['1', '5', '20'].map((w) => { const v = d.periods[w] && d.periods[w].total[i]; return '<td class="' + mkCls(v) + '">' + mkAmt(v) + '</td>'; }).join('') + '</tr>').join('');
    // Top 카드
    const P = d.periods[MK.p] || P1;
    const def = [['외국인 순매수 Top5', 'buy', P.f_buy, 2], ['외국인 순매도 Top5', 'sell', P.f_sell, 2], ['기관 순매수 Top5', 'buy', P.i_buy, 3], ['기관 순매도 Top5', 'sell', P.i_sell, 3],
      ['쌍끌이 순매수 (외국인+기관 동시)', 'both', P.both, -1], ['개인 순매수 Top5', 'buy', P.p_buy, 4], ['개인 순매도 Top5', 'sell', P.p_sell, 4]];
    $('mk-grid').innerHTML = def.map(([t, cl, list, idx]) => '<div class="mk-card ' + cl + '"><h3>' + t + '</h3>' + (list.length ? list.map((it, i) => {
      if (idx >= 0) return mkRow(by, it, i + 1, idx);
      const tot = it[2] + it[3];   // 쌍끌이: 합계를 크게, 외국인/기관을 작게
      return '<button type="button" class="mk-row" data-code="' + mkEsc(it[0]) + '"><span class="rk">' + (i + 1) + '</span><span class="nm">' + mkEsc(it[1]) + '<small>' + mkTag(by, it[0]) + '</small></span><span class="amt pos">' + mkAmt(tot) + '<small>외 ' + mkAmt(it[2]) + ' · 기 ' + mkAmt(it[3]) + '</small></span><span></span></button>';
    }).join('') : '<div class="mk-empty">해당 종목이 없습니다.</div>') + '</div>').join('');
    document.querySelectorAll('#mk-chips button').forEach((b) => b.setAttribute('aria-pressed', b.dataset.p === MK.p ? 'true' : 'false'));
    // 업종
    $('mk-sec-d').textContent = (d.mk && d.mk['코스피'] ? d.mk['코스피'].date : '') + ' · 억원';
    const sec = (list) => (list && list.length ? list.map((x, i) => '<div class="mk-row" style="cursor:default"><span class="rk">' + (i + 1) + '</span><span class="nm">' + mkEsc(x[1]) + '<small>외국인 <span class="' + mkCls(x[2]) + '">' + mkAmt(x[2]) + '</span> · 기관 <span class="' + mkCls(x[3]) + '">' + mkAmt(x[3]) + '</span></small></span><span class="amt ' + mkCls(x[2] + x[3]) + '">' + mkAmt(x[2] + x[3]) + '</span><span></span></div>').join('') : '<div class="mk-empty">업종 자료가 없습니다.</div>');
    $('mk-sec-b').innerHTML = sec(d.sector_buy); $('mk-sec-s').innerHTML = sec(d.sector_sell);
    // 상한가
    const lu = d.limitup || {}; $('mk-lu-d').textContent = lu.date || '';
    $('mk-lu-b').innerHTML = lu.items && lu.items.length ? '<div class="mk-grid">' + lu.items.map(([code, name, close, chg, real]) => '<button type="button" class="mk-row" data-code="' + mkEsc(code) + '"><span class="rk">▲</span><span class="nm">' + mkEsc(name) + '<small>' + mkTag(by, code) + '</small></span><span class="amt pos">' + (real ? '상한가' : (chg == null ? '-' : mkPct(chg))) + '<small>' + (close ? close.toLocaleString('ko-KR') + '원' : '') + '</small></span><span></span></button>').join('') + '</div>' : '<div class="mk-empty">오늘 상한가 자료가 없습니다.</div>';
  }
  document.querySelectorAll('.subnav').forEach((n) => n.addEventListener('click', (e) => { const b = e.target.closest('button[data-jump]'); if (!b) return; const t = document.getElementById(b.dataset.jump); if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' }); }));
  $('mk-chips').addEventListener('click', (e) => { const b = e.target.closest('button[data-p]'); if (!b) return; MK.p = b.dataset.p; renderMarket(MK.rows); });
  $('mk-grid').addEventListener('click', (e) => { const r = e.target.closest('[data-code]'); if (r) { dash.setParams({ code: r.dataset.code, tab: 'judge' }); window.scrollTo({ top: 0 }); } });
  $('mk-lu-b').addEventListener('click', (e) => { const r = e.target.closest('[data-code]'); if (r) { dash.setParams({ code: r.dataset.code, tab: 'judge' }); window.scrollTo({ top: 0 }); } });
  $('mk-lu-more').addEventListener('click', () => { dash.setParams({ tab: 'streak' }); window.scrollTo({ top: 0 }); setTimeout(() => { const t = document.getElementById('limitup'); if (t) t.scrollIntoView({ behavior: 'smooth' }); }, 80); });
  loadMarket();
  $('jl-chips').addEventListener('click', (e) => { const b = e.target.closest('button[data-k]'); if (!b) return; JL.key = b.dataset.k; redraw(); });
  $('jl-q').addEventListener('input', (e) => { JL.q = e.target.value; redraw(); });
  $('jl-strong').addEventListener('change', (e) => { JL.strong = e.target.checked; redraw(); });
  $('jl-table').addEventListener('click', (e) => { const tr = e.target.closest('tr[data-key]'); if (tr) { dash.setParams({ code: tr.dataset.key, tab: 'judge' }); window.scrollTo({ top: 0 }); } });

  function renderRepJudge(cur, rep, fj) {
    const age = rep ? daysAgo(rep.date) : null;
    const stale = age != null && age > 30;
    $('v-layers').textContent = '수급 후보 ' + cur.verdict + ' · 진입 확인 ' + (cur.st_ko || '-') + ' · 분석 보고서 ' + (rep ? '반영됨' : '없음(미반영)');
    const vr = $('v-rep');
    if (rep) {
      vr.className = 'rep-line on';
      vr.innerHTML = '<b>✔ 분석 보고서 반영됨</b> · ' + esc(String(rep.date).slice(0, 10)) + (age != null ? '(' + age + '일 전)' : '') + ' · ' + esc(String(rep.opinion)) + ' · ' + esc(String(rep.score)) + '점' + (stale ? ' · <b>오래된 보고서</b>' : '');
    } else { vr.className = 'rep-line off'; vr.textContent = '분석 보고서 미반영 — 이 종목의 보고서가 없습니다. 「분석 요구」로 만들면 판단에 반영됩니다.'; }
    const hd = $('rj-head'), sm = $('rj-sum'), bt = $('rj-open');
    if (rep) {
      hd.innerHTML = '<span class="tg">반영됨</span>' + esc(String(rep.date).slice(0, 10)) + ' 작성 · ' + esc(String(rep.opinion)) + ' · ' + esc(String(rep.score)) + ' / 5점' + (stale ? ' · 오래된 보고서(' + age + '일 전)' : '');
      sm.textContent = rep.summary || '';
      bt.hidden = false; bt.dataset.file = rep.file;
    } else {
      hd.innerHTML = '<span class="tg off">미반영</span>이 종목의 분석 보고서가 없습니다';
      sm.textContent = '최종 판단은 수급 규칙(① 후보, ② 진입 확인)만으로 냈습니다.'; bt.hidden = true;
    }
  }
  $('rj-open').addEventListener('click', (e) => { const f = e.currentTarget.dataset.file; if (f) { dash.setParams({ tab: 'report' }); window.scrollTo({ top: 0 }); openReport(f); } });

  function renderAnalysis(cur) {
    $('simcard').dataset.local = RPT.local ? '1' : '';
    const br = $('band-req'), haveRep = RPT.reports.some((r) => r.code === cur.code);
    if (RPT.local) {
      br.hidden = false; br.disabled = !!RPT.busy;
      const armed = RPT.armed && Date.now() - RPT.armed < 6000;
      br.textContent = RPT.busy ? '분석 중…' : armed ? '한 번 더' : '분석 요구';
      br.classList.toggle('arm', !!armed && !RPT.busy);
    } else { br.hidden = false; br.disabled = false; br.textContent = haveRep ? '분석 보기' : '분석 요구'; br.classList.remove('arm'); br.classList.toggle('off', !haveRep); br.title = haveRep ? '' : '분석 요구는 이 컴퓨터(127.0.0.1:8770)에서만 할 수 있습니다'; }
    const ga = $('go-analysis');
    const have = RPT.reports.some((r) => r.code === cur.code);
    ga.hidden = !(RPT.local || have);
    ga.textContent = RPT.local ? (have ? '분석 보고서 보기 · 새로 분석 요구 →' : cur.name + ' 분석 요구하기 →') : '분석 보고서 보기 →';
    const btn = $('req-btn'), note = $('req-note');
    if (RPT.local) {
      const busy = !!RPT.busy;
      btn.disabled = busy;
      if (RPT.armed && Date.now() - RPT.armed < 6000) { btn.textContent = '정말 요구할까요? 한 번 더 누르면 시작합니다'; btn.classList.add('arm'); }
      else { btn.textContent = cur.name + ' 분석 요구'; btn.classList.remove('arm'); RPT.armed = 0; }
      note.textContent = busy ? '분석이 진행 중입니다. 끝나야 다음 분석을 요구할 수 있습니다.' : '이 컴퓨터에서 열었기 때문에 요구할 수 있습니다.';
    } else {
      btn.disabled = true; btn.textContent = '이 컴퓨터에서만 요구할 수 있습니다'; btn.classList.remove('arm');
      note.textContent = '분석은 이 컴퓨터의 http://127.0.0.1:8770 주소로 열었을 때만 요구할 수 있습니다. 이 화면에서는 완성된 보고서를 읽기만 할 수 있습니다.';
    }
    const jb = $('job-box');
    jb.replaceChildren(...(RPT.local ? RPT.jobs.slice(0, 3) : []).map((j) => {
      const d = document.createElement('div'); d.className = 'job';
      const names = { business: '사업모델', financial: '재무', industry: '산업', risk: '리스크', synthesis: '종합' };
      const state = { queued: '대기', running: '진행 중', done: '완료', failed: '실패' }[j.state] || j.state;
      const t = document.createElement('div'); t.innerHTML = '<b></b> · ' + state; t.querySelector('b').textContent = j.name;
      const st = document.createElement('div'); st.className = 'steps';
      Object.keys(names).forEach((k) => { const v = (j.steps || {})[k] || '대기'; const sp = document.createElement('span'); sp.textContent = names[k] + ' ' + v; if (v === '완료') sp.className = 'ok'; if (v.startsWith('실패')) sp.className = 'bad'; st.appendChild(sp); });
      d.append(t, st);
      if (j.error) { const e = document.createElement('div'); e.className = 'note'; e.textContent = j.error; d.appendChild(e); }
      if (j.usage && (j.usage.output_tokens || j.usage.input_tokens)) {
        const u = j.usage, tot = (u.input_tokens || 0) + (u.output_tokens || 0) + (u.cache_creation_input_tokens || 0) + (u.cache_read_input_tokens || 0);
        const e = document.createElement('div'); e.className = 'note';
        e.textContent = '사용 토큰 약 ' + num(Math.round(tot / 1000)) + 'K (새로 읽은 입력 ' + num(Math.round(((u.input_tokens || 0) + (u.cache_creation_input_tokens || 0)) / 1000)) + 'K, 캐시 재사용 ' + num(Math.round((u.cache_read_input_tokens || 0) / 1000)) + 'K, 출력 ' + num(Math.round((u.output_tokens || 0) / 1000)) + 'K) · 환산 비용 $' + (u.cost_usd || 0).toFixed(2);
        d.appendChild(e);
      }
      if (j.publish) { const e = document.createElement('div'); e.className = 'note'; e.textContent = '웹 게시: ' + j.publish; d.appendChild(e); }
      return d;
    }));
    const rows = RPT.reports.slice().sort((a, b) => (b.code === cur.code) - (a.code === cur.code) || (a.date < b.date ? 1 : -1));
    $('rep-note').textContent = rows.length ? '줄을 누르면 아래에 보고서가 펼쳐집니다. 지금 보는 종목의 보고서가 위에 옵니다.' : '아직 보고서가 없습니다.';
    $('rep-table').tBodies[0].replaceChildren(...rows.map((r) => {
      const tr = document.createElement('tr'); tr.dataset.file = r.file;
      [r.name, r.date.slice(5), r.score == null ? '-' : r.score.toFixed(1), r.opinion || '-'].forEach((t) => { const td = document.createElement('td'); td.textContent = t; tr.appendChild(td); });
      return tr;
    }));
  }

  function applyTab() {
    const t = hashTab();
    document.querySelectorAll('[data-tab]').forEach((e) => { e.hidden = e.dataset.tab !== t; });
    document.querySelectorAll('#tabbar button').forEach((b) => b.classList.toggle('on', b.dataset.go === t));
    document.documentElement.classList.toggle('tab-market', t === 'market');
    const on = document.querySelector('#tabbar button.on'); if (on && on.scrollIntoView) { try { on.scrollIntoView({ inline: 'center', block: 'nearest' }); } catch (e) { /* 일부 브라우저 */ } }
  }
  function render() {
    applyTab();
    const S = dash.data('summary'), D = dash.data('daily'), G = dash.data('groups'), C = dash.data('cum60'), Y = dash.data('blocks'), K = dash.data('cost');
    const code = getCode();
    const sel = $('pick');
    if (S.status !== 'ok') {
      ['verdict'].forEach(() => {});
      $('v-text').textContent = S.status === 'loading' ? '' : '요약 자료를 불러오지 못했습니다';
      return;
    }
    const srows = S.data.slice().sort((a, b) => (VORDER[a.verdict] - VORDER[b.verdict]) || (b.score - a.score) || a.name.localeCompare(b.name, 'ko'));
    // 종목 선택
    if (sel.options.length !== srows.length || sel.dataset.sig !== srows.map((r) => r.code).join()) {
      sel.replaceChildren(...S.data.slice().sort((a, b) => a.name.localeCompare(b.name, 'ko')).map((r) => new Option(r.name + ' (' + r.code + ')', r.code)));
      sel.dataset.sig = srows.map((r) => r.code).join();
      PICKROWS = S.data.slice().sort((a, b) => a.name.localeCompare(b.name, 'ko'));
    }
    const cur = S.data.find((r) => r.code === code) || srows[0];
    sel.value = cur.code;
    { const pq = $('pick-q'); pq.dataset.cur = cur.name; if (document.activeElement !== pq) pq.value = cur.name; }

    // 판단 카드
    const pill = $('v-pill');
    const repo = latestReport(cur.code), fj = finalJudge(cur, repo);
    pill.classList.remove('dash-skeleton', 'v-strong', 'v-go', 'v-ready', 'v-watch', 'v-wait', 'v-hold', 'v-void', 'v-buy', 'v-wait4', 'v-no');
    pill.classList.add(fj.cls);
    pill.textContent = fj.label;
    const w = { source: 'summary', where: 'code=' + cur.code };
    const mark = (id, field, text) => { const e = $(id); e.dataset.source = 'summary'; e.dataset.field = field; e.dataset.where = 'code=' + cur.code; e.textContent = text; };
    mark('v-name', 'name', cur.name);
    $('v-code').textContent = cur.code;
    mark('v-close', 'close', num(cur.close));
    mark('v-chg', 'chg20', pct(cur.chg20));
    $('v-chg').className = cur.chg20 >= 0 ? 'chg-up' : 'chg-dn';
    $('v-asof').textContent = cur.asof + ' 종가 기준 · 수급 ' + num(cur.days) + '일 분석';
    const gapTxt = cur.gap_ref == null ? '' : ' 매집 간격은 이전 상승 초입(' + shares(cur.gap_ref) + ')의 ' + (cur.gap_pct == null ? '아래입니다' : pct0(cur.gap_pct) + '입니다') + '.';
    const TEXT = {
      '강한 진입': '진입 신호 3가지 중 ' + cur.cnt + '개가 켜져 있습니다. 눌림 매수·매집 간격 확산·거래량 폭발이 겹친 가장 강한 구간입니다.',
      '진입': '가격이 20일 동안 ' + pct(cur.chg20) + ' 눌렸는데 세력 매집은 유지되고 있습니다. 눌림 매수 신호가 켜졌습니다.',
      '진입 준비': (cur.c5 ? '매집 간격이 이전 상승 초입 수준까지 벌어졌습니다.' : cur.c6 ? '최근 5일 안에 거래량 2배↑·주가 8%↑가 나왔고 매집은 유지 중입니다.' : '세력 매집이 유지되고 핵심 세력이 최근 5일 순매수 중입니다. 가격이 20일 -10%까지 눌리면 진입 신호입니다.') + ' 한 가지가 더 겹치면 진입으로 올라갑니다.',
      '관망': '세력 매집 추세는 이어지지만 켜진 신호가 없습니다. 지켜보는 단계입니다.' + gapTxt,
      '대기': '세력합 매집수량의 5일선이 20일선 아래입니다. 세력이 빠지는 중이라 진입을 기다리는 단계입니다.'
    };
    $('v-text').textContent = fj.reason;
    $('check-sum').textContent = TEXT[cur.verdict];
    renderRepJudge(cur, repo, fj);
    renderBasis(fj);
    renderJList(S.data);
    document.title = cur.name + ' 수급';

    // 진입 신호 3가지 + 확인 2가지
    const lead = cur.leaders === '-' ? '핵심 세력' : cur.leaders.split('·').slice(0, 2).join('·');
    const volTxt = cur.c6 ? cur.last_vol.slice(5) + ' ×' + cur.vol_x : (cur.last_vol ? '최근 ' + cur.last_vol.slice(2) : '없음');
    const items = [
      [cur.s_buy, '[신호 ①] 눌림 매수: 20일 10% 하락 + 매집 5일선이 20일선 위', pct(cur.chg20) + (cur.c2 ? '' : ' · 매집↓')],
      [cur.c5, '[신호 ②] 매집 간격 확산: 5일선-20일선 간격이 이전 상승 초입' + (cur.gap_ref == null ? '' : '(' + shares(cur.gap_ref) + ')') + ' 이상', cur.gap_pct == null ? '미달' : pct0(cur.gap_pct)],
      [cur.c6, '[신호 ③] 거래량 폭발: 최근 5일 안에 거래량이 이전 60일 평균의 2배↑ + 주가 8%↑', volTxt],
      [cur.c3, '[확인] ' + lead + '이 최근 5일 순매수 중이다', shares(cur.lead5)],
      [cur.c4, '[확인] 분산비가 0.5 이상(매집이 최고치 근처)이다', cur.ratio.toFixed(2)]
    ];
    $('check-list').replaceChildren(...items.map((it, i) => {
      const li = document.createElement('li'); li.className = it[0] ? 'ok' : '';
      const dot = document.createElement('span'); dot.className = 'dot'; dot.textContent = it[0] ? '✓' : '';
      const t = document.createElement('span'); t.textContent = it[1];
      const v = document.createElement('span'); v.className = 'val'; v.textContent = it[2];
      li.append(dot, t, v); return li;
    }));

    // 신호별 과거 성과
    $('perf-table').tBodies[0].replaceChildren(...[
      ['① 눌림 매수', cur.n_sig, cur.win20, cur.avg20, cur.last_sig],
      ['② 간격 확산', cur.n_gap, cur.gap_win20, cur.gap_avg20, cur.last_gap],
      ['③ 거래량 폭발', cur.n_vol, cur.vol_win20, cur.vol_avg20, cur.last_vol]
    ].map((r) => {
      const tr = document.createElement('tr'); tr.style.cursor = 'default';
      [r[0], num(r[1]) + '회', r[2] == null ? '-' : pct0(r[2]), r[3] == null ? '-' : pct(r[3]), r[4] ? r[4].slice(2) : '-'].forEach((t, i) => {
        const td = document.createElement('td'); td.textContent = t;
        if (i === 3 && r[3] != null) td.className = r[3] >= 0 ? 'chg-up' : 'chg-dn';
        tr.appendChild(td);
      });
      return tr;
    }));

    // 누가 매집했나
    const whoEl = $('who-chart');
    if (G.status === 'ok') {
      const gr = G.data.filter((r) => r.c === cur.code).sort((a, b) => b.hitrate - a.hitrate || b.avg_pre - a.avg_pre);
      if (gr.length) {
        $('who-note').textContent = '지난 5년 동안 20일에 5% 이상 오른 구간 ' + gr[0].eps + '번을 골라, 오르기 직전 20일 동안 가장 많이 산 투자자를 셌습니다. 막대가 길수록 오르기 전에 먼저 사 둔 경우가 많았습니다.';
        barChart(whoEl, gr);
      }
    } else if (G.status !== 'loading') fail(whoEl);

    // 현재 추이
    const nowEl = $('now-chart');
    if (C.status === 'ok') {
      const cr = C.data.filter((r) => r.c === cur.code);
      const gs = [...new Set(cr.map((r) => r.g))];
      const byDate = d3.group(cr, (r) => r.d);
      const rows = [...byDate.keys()].sort().map((d) => { const o = { d }; byDate.get(d).forEach((r) => { o[r.g] = r.v; }); return o; });
      const cols = gs.map((g, i) => ({ key: g, label: g, color: dash.colors[i], width: i === 0 ? 2.5 : 2, end: true, tipFmt: shares }));
      legend($('now-legend'), cols.map((c) => ({ label: c.label, color: c.color })));
      timeChart(nowEl, { rows, x: 'd', series: cols, yFmt: (v) => shares(v), height: 200, ref: [{ y: 0, label: '0' }] });
    } else if (C.status !== 'loading') fail(nowEl);
    if (G.status === 'ok') {
      const tb = $('now-table').tBodies[0];
      const gr = G.data.filter((r) => r.c === cur.code && r.leader === 1).sort((a, b) => b.hitrate - a.hitrate);
      tb.replaceChildren(...gr.map((r) => {
        const tr = document.createElement('tr'); tr.dataset.key = r.c + ',' + r.g; tr.style.cursor = 'default';
        const st = r.cur5 > 0 && r.cur20 > 0 ? '매집 중' : r.cur5 > 0 ? '다시 매수' : r.cur20 > 0 ? '매수 둔화' : '매도 중';
        [r.g, shares(r.cur5), shares(r.cur20), r.ratio.toFixed(2), st].forEach((t) => { const td = document.createElement('td'); td.textContent = t; tr.appendChild(td); });
        return tr;
      }));
    }

    // 년월별 거래량 · 수급주체별 평균단가
    const yTbl = $('year-table');
    const compact = window.matchMedia('(max-width: 640px)').matches;
    const man = (v) => { const m = v / 1e4, a = Math.abs(m); if (a >= 10000) return Math.abs(v) >= 1e9 ? Math.round(v / 1e8) + '억' : (v / 1e8).toFixed(1) + '억'; return a < 10 ? (a < 0.05 ? '0' : m.toFixed(1)) : String(Math.round(m)); };   // 만주 단위(1억주 넘으면 억)
    const chon = (p) => (p == null ? '-' : p >= 1e5 ? String(Math.round(p / 1e3)) : (p / 1e3).toFixed(1));                                     // 천원 단위
    if (Y.status === 'ok') {
      const yr = Y.data.filter((r) => r.c === cur.code).sort((a, b) => a.o - b.o);
      const colMax = {};
      YG.forEach((g) => { colMax[g] = d3.max(yr, (r) => Math.abs(r[g])) || 1; });
      $('mode-note').textContent = MODE_NOTE[ymode] + (compact ? (ymode === 'net' ? ' (단위: 만주)' : ' (단위: 천원)') : '');
      yTbl.tBodies[0].replaceChildren(...yr.map((r) => {
        const tr = document.createElement('tr'); tr.dataset.key = r.c + ',' + r.o;
        if (r.lab === '1주전' || r.lab === '1개월전' || r.lab === '1분기' || r.lab === '1년') tr.className = 'grp';
        const mk = (t, cls) => { const td = document.createElement('td'); td.textContent = t; if (cls) td.className = cls; return td; };
        tr.appendChild(mk(r.lab));
        tr.appendChild(mk(compact ? chon(r.ap) : num(r.ap)));
        tr.appendChild(mk(compact ? man(r.vol) : shares(r.vol)));
        YG.forEach((g) => {
          const v = r[g], p = r[g + 'p'];
          const txt = ymode === 'net' ? (compact ? man(v) : shares(v)) : (p == null ? '-' : compact ? chon(p) : num(p));
          const td = mk(txt, 'cell');
          const a = ymode === 'net' ? Math.sqrt(Math.abs(v) / colMax[g]) * 55 : (p == null ? 0 : 22);
          td.style.setProperty('--bg', 'color-mix(in srgb, ' + (v >= 0 ? 'var(--color-ok)' : 'var(--color-bad)') + ' ' + a.toFixed(0) + '%, transparent)');
          tr.appendChild(td);
        });
        return tr;
      }));
    } else if (Y.status !== 'loading') {
      yTbl.tBodies[0].replaceChildren();
    }
    if (K.status === 'ok') {
      const kr = K.data.filter((r) => r.c === cur.code);
      $('cost-table').tBodies[0].replaceChildren(...kr.map((r) => {
        const tr = document.createElement('tr'); tr.dataset.key = r.c + ',' + r.g; tr.style.cursor = 'default';
        const cells = [r.g, r.avg == null ? '-' : num(r.avg), r.ret == null ? '-' : pct(r.ret), shares(r.acc)];
        cells.forEach((t, i) => { const td = document.createElement('td'); td.textContent = t; if (i === 2 && r.ret != null) td.className = r.ret >= 0 ? 'chg-up' : 'chg-dn'; tr.appendChild(td); });
        return tr;
      }));
    }

    // 주가·세력 차트
    const dr = D.status === 'ok' ? D.data.filter((r) => r.c === cur.code).sort((a, b) => (a.d < b.d ? -1 : 1)) : [];
    const pEl = $('price-chart'), aEl = $('acc-chart'), rEl = $('ratio-chart'), gEl = $('gap-chart');
    if (D.status === 'ok') {
      const mk = (cls, test, sym, color, dy) => ({ cls, key: 'p', test, symbol: sym, color, dy, size: 80 });
      legend($('price-legend'), [
        { label: '종가', color: dash.colors[0] },
        { label: '▲ 매수신호', color: 'var(--color-ok)', symbol: d3.symbolTriangle },
        { label: '◆ 상승 중 주도세력 분산비 70%↑', color: dash.colors[3], symbol: d3.symbolDiamond },
        { label: '■ 매수비중 70%↑', color: dash.colors[2], symbol: d3.symbolSquare },
        { label: '★ 둘 다', color: dash.colors[4], symbol: d3.symbolStar },
        { label: '● 매집 간격 확산 시작', color: dash.colors[1], symbol: d3.symbolCircle },
        { label: '✚ 거래량 2배↑ + 주가 8%↑', color: 'var(--color-bad)', symbol: d3.symbolCross }
      ]);
      timeChart(pEl, {
        rows: dr, x: 'd', height: 230, yFmt: (v) => num(Math.round(v)),
        series: [{ key: 'p', label: '종가', color: dash.colors[0], width: 2, end: true, tipFmt: (v) => num(v) + '원' }],
        markers: [
          mk('mb', (r) => r.b === 1, d3.symbolTriangle, 'var(--color-ok)', 12),
          mk('mdd', (r) => r.k === 'D', d3.symbolDiamond, dash.colors[3], -10),
          mk('mbb', (r) => r.k === 'B', d3.symbolSquare, dash.colors[2], -10),
          mk('mss', (r) => r.k === 'S', d3.symbolStar, dash.colors[4], -10),
          mk('mga', (r) => r.ga === 1, d3.symbolCircle, dash.colors[1], 12),
          mk('mvs', (r) => r.vs === 1, d3.symbolCross, 'var(--color-bad)', -14)
        ],
        tipExtra: (r) => [r.b === 1 ? '▲ 매수신호' : '', r.k === 'S' ? '★ 분산비·비중 모두 70%↑' : r.k === 'D' ? '◆ 분산비 70%↑' : r.k === 'B' ? '■ 매수비중 70%↑' : '',
          r.ga === 1 ? '● 매집 간격 확산 시작' : '', r.vs === 1 ? '✚ 거래량 ×' + r.vx + ' · 주가 ' + pct(r.pc) : ''].filter(Boolean).join(' · ')
      });
      legend($('acc-legend'), [{ label: '5일선', color: dash.colors[0] }, { label: '20일선', color: 'var(--cds-chart-muted)' }]);
      timeChart(aEl, {
        rows: dr, x: 'd', height: 200, yFmt: (v) => shares(v),
        series: [
          { key: 'm20', label: '20일선', color: 'var(--cds-chart-muted)', width: 2, tipFmt: shares },
          { key: 'm5', label: '5일선', color: dash.colors[0], width: 2.2, end: true, tipFmt: shares }
        ]
      });
      legend($('gap-legend'), [{ label: '간격', color: dash.colors[0] }, { label: '이전 상승 초입 간격', color: 'var(--cds-chart-muted)' }, { label: '● 확산 시작', color: dash.colors[1], symbol: d3.symbolCircle }]);
      timeChart(gEl, {
        rows: dr, x: 'd', height: 190, yFmt: (v) => shares(v),
        series: [
          { key: 'gr', label: '이전 상승 초입 간격', color: 'var(--cds-chart-muted)', width: 2, tipFmt: shares },
          { key: 'gp', label: '간격', color: dash.colors[0] + '', width: 2.2, end: true, tipFmt: shares }
        ],
        markers: [{ cls: 'gga', key: 'gp', test: (r) => r.ga === 1, symbol: d3.symbolCircle, color: dash.colors[1], dy: 0, size: 70 }],
        ref: [{ y: 0, label: '0' }]
      });
      timeChart(rEl, {
        rows: dr, x: 'd', height: 170, yMin: 0, yMax: 1, yFmt: (v) => v.toFixed(1),
        series: [{ key: 'r', label: '분산비', color: dash.colors[1], width: 2, end: true, tipFmt: (v) => v.toFixed(2) }],
        ref: [{ y: 0.7, label: '0.7' }]
      });
    } else if (D.status !== 'loading') { fail(pEl); fail(aEl); fail(rEl); fail(gEl); }

    // 강한 진입 연속 종목 (과거 신호 성과가 나쁜 종목은 후보에서 제외)
    const fillStreak = (tbl, rows, emptyText) => {
      tbl.tBodies[0].replaceChildren(...(rows.length ? rows.map((r) => {
        const tr = document.createElement('tr'); tr.dataset.key = r.code;
        const cells = [r.name, r.strong_streak + '일', pct(r.strong_ret), r.hist_win == null ? '표본 적음' : pct0(r.hist_win) + ' (' + r.hist_n + '건)', r.hist_avg == null ? '-' : pct(r.hist_avg), r.st_ko || '-'];
        cells.forEach((t, i) => {
          const td = document.createElement('td'); td.textContent = t;
          if (i === 2) td.className = r.strong_ret >= 0 ? 'chg-up' : 'chg-dn';
          if (i === 4 && r.hist_avg != null) td.className = r.hist_avg >= 0 ? 'chg-up' : 'chg-dn';
          tr.appendChild(td);
        });
        return tr;
      }) : [(() => { const tr = document.createElement('tr'); tr.style.cursor = 'default'; const td = document.createElement('td'); td.colSpan = 6; td.textContent = emptyText; td.style.color = 'var(--muted)'; tr.appendChild(td); return tr; })()]));
    };
    const byStreak = (a, b) => (b.strong_streak - a.strong_streak) || a.name.localeCompare(b.name, 'ko');
    const long5 = S.data.filter((r) => r.strong_streak >= 5).sort(byStreak);
    const long34 = S.data.filter((r) => r.strong_streak >= 3 && r.strong_streak < 5).sort(byStreak);
    const s5 = long5.filter((r) => r.hist_ok !== false);
    const s34 = long34.filter((r) => r.hist_ok !== false);
    const sOut = long5.concat(long34).filter((r) => r.hist_ok === false);
    $('streak-sum').textContent = '후보 5일 이상 ' + s5.length + '종목 · 3~4일 ' + s34.length + '종목 · 과거 성과 부진으로 제외 ' + sOut.length + '종목 (전체 ' + S.data.length + '종목, 기준 ' + (S.data[0] ? S.data[0].asof : '') + ')';
    $('streak-outnote').textContent = '5일 이상 연속이거나 3~4일 연속이면서, 지금 켜진 신호의 과거 20일 뒤 성과가 승률 50% 미만이거나 평균 수익이 마이너스인 종목입니다.';
    fillStreak($('streak-table'), s5, '해당하는 종목이 없습니다');
    fillStreak($('streak-near'), s34, '해당하는 종목이 없습니다');
    fillStreak($('streak-out'), sOut, '제외된 종목이 없습니다');

    renderAnalysis(cur);
    renderEntry(cur);

    // 종목 모아보기
    const tb2 = $('rank-table').tBodies[0];
    tb2.replaceChildren(...srows.map((r) => {
      const tr = document.createElement('tr'); tr.dataset.key = r.code; if (r.code === cur.code) tr.className = 'cur';
      const c1 = document.createElement('td'); c1.textContent = r.name;
      const c2 = document.createElement('td'); const tg = document.createElement('span'); tg.className = 'tag ' + VCLASS[r.verdict]; tg.textContent = r.verdict; c2.appendChild(tg);
      const c3 = document.createElement('td'); c3.textContent = pct(r.chg20); c3.className = r.chg20 >= 0 ? 'chg-up' : 'chg-dn';
      const c4 = document.createElement('td'); c4.textContent = r.leaders;
      tr.append(c1, c2, c3, c4); return tr;
    }));
  }

  const setMode = (m) => { ymode = m; $('mode-net').classList.toggle('on', m === 'net'); $('mode-px').classList.toggle('on', m === 'px'); render(); };
  $('mode-net').addEventListener('click', () => setMode('net'));
  $('mode-px').addEventListener('click', () => setMode('px'));
  document.querySelectorAll('#tabbar button').forEach((b) => b.addEventListener('click', () => { dash.setParams({ tab: b.dataset.go }); window.scrollTo({ top: 0 }); }));
  let rz = null;
  window.addEventListener('resize', () => { clearTimeout(rz); rz = setTimeout(() => { if (st.renderFn) st.renderFn(); }, 200); });
  $('pick').addEventListener('change', (e) => { dash.setParams({ code: e.target.value }); });
  // 종목명·코드를 써서 검색: 이름이 같으면 그 종목, 아니면 이름이 그 글자로 시작하는 종목, 그것도 없으면 이름·코드에 글자가 들어간 종목
  const goPick = () => {
    const pq = $('pick-q'), q = pq.value.trim(); if (!q) return;
    const rows = dash.data('summary').data || [], ql = q.toLowerCase(), qu = q.toUpperCase();
    const m = rows.find((r) => r.name.toLowerCase() === ql || r.code === qu) || rows.find((r) => r.name.toLowerCase().startsWith(ql)) || rows.find((r) => r.name.toLowerCase().includes(ql) || r.code.startsWith(qu));
    if (m) { dash.setParams({ code: m.code }); window.scrollTo({ top: 0 }); pq.blur(); return; }
    pq.value = ''; pq.placeholder = '"' + q + '" 은(는) 분석 중이 아닙니다. 종목 탭에서 추가하세요';
    setTimeout(() => { pq.placeholder = '종목명·코드를 입력하세요'; }, 4000);
  };
  $('pick-q').addEventListener('change', goPick);
  $('pick-q').addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); goPick(); } });
  // 목록: 입력창을 누르거나 ▾ 를 누르면 전체 종목이 이전 목록처럼 나오고, 글자를 쓰면 걸러진다
  const pl = $('pick-list'); let pHi = -1;
  const pickItems = () => { const q = $('pick-q').value.trim().toLowerCase(); const cur = $('pick-q').dataset.cur || ''; const all = !q || q === cur.toLowerCase(); return PICKROWS.filter((r) => all || r.name.toLowerCase().includes(q) || r.code.startsWith(q.toUpperCase())); };
  const pickShow = () => {
    const items = pickItems(); pHi = -1;
    pl.replaceChildren(...items.map((r, i) => { const d = document.createElement('div'); d.className = 'pick-item'; d.dataset.code = r.code; d.textContent = r.name + ' (' + r.code + ')'; return d; }));
    if (!items.length) { const d = document.createElement('div'); d.className = 'pick-empty'; d.textContent = '분석 중인 종목이 아닙니다. 종목 탭에서 추가하세요'; pl.replaceChildren(d); }
    pl.hidden = false;
  };
  const pickHide = () => { pl.hidden = true; };
  $('pick-q').addEventListener('focus', (e) => { e.target.select(); pickShow(); });
  $('pick-q').addEventListener('input', pickShow);
  $('pick-btn').addEventListener('click', () => { if (pl.hidden) { $('pick-q').focus(); pickShow(); } else pickHide(); });
  pl.addEventListener('mousedown', (e) => { const it = e.target.closest('.pick-item'); if (!it) return; e.preventDefault(); pickHide(); dash.setParams({ code: it.dataset.code }); window.scrollTo({ top: 0 }); $('pick-q').blur(); });
  $('pick-q').addEventListener('keydown', (e) => {
    const its = [...pl.querySelectorAll('.pick-item')];
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); if (pl.hidden) pickShow(); pHi = Math.max(0, Math.min(its.length - 1, pHi + (e.key === 'ArrowDown' ? 1 : -1))); its.forEach((x, i) => x.classList.toggle('hi', i === pHi)); if (its[pHi]) its[pHi].scrollIntoView({ block: 'nearest' }); }
    else if (e.key === 'Enter' && pHi >= 0 && its[pHi]) { e.preventDefault(); pickHide(); dash.setParams({ code: its[pHi].dataset.code }); window.scrollTo({ top: 0 }); $('pick-q').blur(); }
    else if (e.key === 'Escape') pickHide();
  });
  $('pick-q').addEventListener('blur', () => setTimeout(pickHide, 150));
  ['streak-table', 'streak-near', 'streak-out'].forEach((id) => $(id).addEventListener('click', (ev) => {
    const tr = ev.target.closest('tr[data-key]');
    if (tr) { dash.setParams({ code: tr.dataset.key, tab: 'judge' }); window.scrollTo({ top: 0 }); }
  }));
  $('band-req').addEventListener('click', () => {
    const code = dash.params().code;
    if (!RPT.local) { dash.setParams({ tab: 'report' }); window.scrollTo({ top: 0 }); return; }
    if (RPT.busy) return;
    if (RPT.armed && Date.now() - RPT.armed < 6000) { RPT.armed = 0; requestAnalysis(code); dash.setParams({ tab: 'report' }); window.scrollTo({ top: 0 }); return; }
    RPT.armed = Date.now(); redraw(); setTimeout(redraw, 6200);
  });
  $('go-analysis').addEventListener('click', () => { dash.setParams({ tab: 'report' }); window.scrollTo({ top: 0 }); });
  $('req-btn').addEventListener('click', () => {
    if (!RPT.local || RPT.busy) return;
    const code = dash.params().code;
    if (RPT.armed && Date.now() - RPT.armed < 6000) { RPT.armed = 0; requestAnalysis(code); return; }
    RPT.armed = Date.now(); redraw(); setTimeout(redraw, 6200);
  });
  $('rep-table').addEventListener('click', (ev) => { const tr = ev.target.closest('tr[data-file]'); if (tr) openReport(tr.dataset.file); });
  $('rank-table').addEventListener('click', (ev) => {
    const tr = ev.target.closest('tr[data-key]');
    if (tr) { dash.setParams({ code: tr.dataset.key, tab: 'judge' }); window.scrollTo({ top: 0 }); }
  });
  dash.onData(render);
  boot();
})();
</script>
<script>
// SIM-SECTION: 강한진입 모의투자 (patch_sim_section.py)
(() => {
'use strict';
// 파일을 더블클릭으로 열었으면(file://) 자동으로 켜져 있는 로컬 서버 주소로 보낸다
// ───────────────────────── 규칙 상수 ─────────────────────────
const MIN_STREAK = 4;          // 후보: 강한진입 N거래일 이상 연속
const ACT = 0.5;               // 전체 물량의 50% 진입 후부터 손절 적용
const STOP = 0.10;             // 평균단가 대비 -10%
const TP1 = 0.15, TP2 = 0.25;  // 목표 수익
const TRAIL = 0.05;            // 진입 후 고점 대비 되돌림
const HOLD_DAYS = 20;          // 기본 보유기간(거래일)

const LS = 'supply-sim.v1';
const jTag = (r) => { const j = window.supplyJudge && window.supplyJudge(r); return j ? `<span class="jtag ${j.key}" title="${esc(j.reason)}">${j.label}</span>` : ''; };
const JORD = { buy: 0, wait: 1, hold: 2, no: 3 };
const stTag = (r) => r && r.st_ko ? `<span class="st ${r.st}" title="${esc(r.reason || '')}">${esc(r.st_ko)}</span>` : '';
let state = { positions: [], def: { budget: 10000000, n: 4 }, minStreak: MIN_STREAK, jkey: 'buy' };
try { const j = JSON.parse(localStorage.getItem(LS) || 'null'); if (j && Array.isArray(j.positions)) state = Object.assign(state, j); } catch (e) {}
// 기록은 이 브라우저에 저장하고, 서버(/api/state)가 있으면 PC·폰이 같은 기록을 보도록 함께 맞춘다(더 최근 ts가 이김)
let pushT = 0;
const save = () => {
  state.ts = Date.now();
  try { localStorage.setItem(LS, JSON.stringify(state)); } catch (e) {}
  clearTimeout(pushT);
  pushT = setTimeout(() => { fetch('api/state', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(state) }).catch(() => {}); }, 400);
};
async function pullState() {
  try {
    const r = await fetch('api/state', { cache: 'no-store' }); if (!r.ok) return false;
    const j = await r.json(); if (!j || !Array.isArray(j.positions) || (j.ts || 0) <= (state.ts || 0)) return false;
    state = Object.assign(state, j); try { localStorage.setItem(LS, JSON.stringify(state)); } catch (e) {}
    state.positions.forEach((p) => { if (!p.mode) { p.mode = 'select'; p.start = p.buys && p.buys[0] || null; p.gap = 1; } });
    await Promise.all(state.positions.map((p) => loadSeries(p.code).catch(() => null)));
    return true;
  } catch (e) { return false; }
}

let stocks = [], built = '';
const cache = {};   // code -> daily series

// ───────────────────────── 유틸 ─────────────────────────
const root = document.getElementById('simcard');
const $ = (s, r = document) => r.querySelector(s);
const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const won = (v) => (v == null || isNaN(v)) ? '-' : Math.round(v).toLocaleString('ko-KR') + '원';
const num = (v) => (v == null || isNaN(v)) ? '-' : Math.round(v).toLocaleString('ko-KR');
const pct = (v, d = 1) => (v == null || isNaN(v)) ? '-' : (v >= 0 ? '+' : '') + (v * 100).toFixed(d) + '%';
const cls = (v) => v > 0 ? 'up' : v < 0 ? 'dn' : '';
const sgnWon = (v) => (v >= 0 ? '+' : '-') + Math.abs(Math.round(v)).toLocaleString('ko-KR') + '원';

async function loadSeries(code) {
  if (cache[code]) return cache[code];
  const r = await fetch('data/' + code + '.json', { cache: 'no-cache' });
  if (!r.ok) throw new Error(code + ' 데이터 없음');
  const j = await r.json();
  cache[code] = j.daily.map((x) => ({ d: x.d, p: x.p, m5: x.m5, m20: x.m20, r: x.r })).sort((a, b) => a.d < b.d ? -1 : 1);
  return cache[code];
}

// ───────────────────────── 시뮬레이션 ─────────────────────────
// 분할 매수일마다 그날 종가로 체결. 전체의 50% 이상 진입한 날부터 평균단가 -10% 종가 이탈 시 전량 손절(그날 종가).
function simulate(pos, s) {
  const n = pos.n, amt = pos.budget / n, L = s.length - 1;
  const idxOf = (d) => { let lo = 0, hi = L, r = -1; while (lo <= hi) { const m = (lo + hi) >> 1; if (s[m].d <= d) { r = m; lo = m + 1; } else hi = m - 1; } return r; };
  // 첫 매수일(start)이 1차 분할. 균등분할: 시작일부터 gap 거래일 간격으로 자동 배치(아직 안 온 날은 '예정'). 선택분할: 2차부터 날짜를 직접 선택.
  const si = pos.start ? idxOf(pos.start) : -1, gap = pos.gap || 1, equal = pos.mode === 'equal';
  const tr = Array.from({ length: n }, (_, i) => {
    let d = null, idx = -1, future = false;
    if (equal) { if (si >= 0) { const j = si + i * gap; if (j <= L) { idx = j; d = s[j].d; } else future = true; } }
    else { d = i === 0 ? pos.start : pos.buys[i]; idx = d ? idxOf(d) : -1; }
    const o = { i, req: d, idx, date: idx >= 0 ? s[idx].d : null, price: idx >= 0 ? s[idx].p : null, qty: 0, cost: 0, st: future ? 'future' : !d ? 'wait' : idx < 0 ? 'bad' : 'fill', void: false };
    if (o.st === 'fill') { o.qty = Math.floor(amt / o.price); o.cost = o.qty * o.price; if (!o.qty) o.st = 'short'; }
    return o;
  });
  const fills = tr.filter((t) => t.st === 'fill').sort((a, b) => a.idx - b.idx || a.i - b.i);
  const need = Math.ceil(n * ACT);
  const R = { tr, fills, need, amt, L, n, filled: fills.length, active: fills.length >= need, stopIdx: null, activeIdx: null };
  if (R.active) R.activeIdx = fills[need - 1].idx;
  if (R.active) {
    let q = 0, c = 0, fi = 0;
    for (let d = fills[0].idx; d <= L; d++) {
      while (fi < fills.length && fills[fi].idx <= d) { q += fills[fi].qty; c += fills[fi].cost; fi++; }
      if (d >= R.activeIdx && s[d].p <= (c / q) * (1 - STOP)) { R.stopIdx = d; break; }
    }
  }
  fills.forEach((f) => { if (R.stopIdx != null && f.idx > R.stopIdx) { f.void = true; f.st = 'void'; } });
  const live = fills.filter((f) => !f.void);
  R.filled = live.length;
  R.qty = live.reduce((a, f) => a + f.qty, 0);
  R.cost = live.reduce((a, f) => a + f.cost, 0);
  R.avg = R.qty ? R.cost / R.qty : null;
  R.stopped = R.stopIdx != null;
  R.last = s[L].p;
  R.exit = R.stopped ? s[R.stopIdx].p : null;
  R.value = R.qty * (R.stopped ? R.exit : R.last);
  R.pnl = R.value - R.cost;
  R.ret = R.cost ? R.pnl / R.cost : null;
  R.first = live.length ? live[0].idx : null;
  R.stopPrice = R.avg ? R.avg * (1 - STOP) : null;
  if (R.first != null && !R.stopped) { let pk = 0; for (let d = R.first; d <= L; d++) pk = Math.max(pk, s[d].p); R.peak = pk; R.peakRet = R.avg ? pk / R.avg - 1 : null; }
  R.future = tr.filter((t) => t.st === 'future').length;
  R.heldDays = R.first != null ? (R.stopped ? R.stopIdx : L) - R.first : 0;
  return R;
}

// ───────────────────────── 보유/익절 판단 ─────────────────────────
function judge(pos, R, s) {
  const L = R.L, f = [];   // f: {ok:true|false|null, t, w}
  if (!R.fills.length) return { cls: 'idle', title: '매수 대기', sub: '분할 매수일을 선택하면 그날 종가로 체결되고 수익이 계산됩니다.', f };
  if (R.stopped) {
    return { cls: 'stop', title: '손절 청산 완료', sub: s[R.stopIdx].d + ' 종가 ' + won(R.exit) + '에 전량 매도 · 평균단가 대비 ' + pct(R.exit / R.avg - 1) + ' · 실현손익 ' + sgnWon(R.pnl) + '. 이후 날짜의 분할 매수는 무효 처리됩니다.', f };
  }
  const row = s[L], b5 = s[Math.max(0, L - 5)];
  const gapN = row.m5 - row.m20, gap5 = b5.m5 - b5.m20;
  let score = 0;
  if (row.m5 > row.m20) f.push({ ok: true, t: '세력 매집수량 5일선이 20일선 위 — 수급 유지' });
  else { score += 3; f.push({ ok: false, t: '세력 매집수량 5일선이 20일선 아래로 이탈 — 수급 약화', w: 3 }); }
  if (gap5 > 0 && gapN < gap5 * 0.7) { score += 1; f.push({ ok: false, t: '매집 간격이 5거래일 전보다 30% 이상 축소', w: 1 }); }
  else if (gapN > gap5) f.push({ ok: true, t: '매집 간격이 5거래일 전보다 확대' });
  const dr = row.r - b5.r;
  if (dr <= -0.10) { score += 1; f.push({ ok: false, t: '분산비 5거래일간 ' + dr.toFixed(2) + ' 하락 — 매집 물량 이탈 조짐', w: 1 }); }
  const ma5p = s.slice(L - 4, L + 1).reduce((a, x) => a + x.p, 0) / 5;
  if (row.p < ma5p) { score += 1; f.push({ ok: false, t: '종가가 5일 평균가(' + won(ma5p) + ') 아래', w: 1 }); }
  else f.push({ ok: true, t: '종가가 5일 평균가 위 — 단기 추세 양호' });
  if (R.ret > 0 && R.peak && R.last / R.peak - 1 <= -TRAIL) { score += 2; f.push({ ok: false, t: '진입 후 고점(' + won(R.peak) + ') 대비 ' + pct(R.last / R.peak - 1) + ' 되돌림', w: 2 }); }
  if (R.heldDays >= HOLD_DAYS) { score += 1; f.push({ ok: false, t: '보유 ' + R.heldDays + '거래일 — 기본 보유기간(' + HOLD_DAYS + '일) 경과', w: 1 }); }
  if (R.ret >= TP2) { score += 2; f.push({ ok: false, t: '수익률 ' + pct(R.ret) + ' — 2차 목표(+25%) 도달', w: 2 }); }
  else if (R.ret >= TP1) { score += 1; f.push({ ok: false, t: '수익률 ' + pct(R.ret) + ' — 1차 목표(+15%) 도달', w: 1 }); }
  const out = { score, f };
  const near = R.active && R.last <= R.stopPrice * 1.03;
  if (R.ret > 0) {
    if (score >= 5) Object.assign(out, { cls: 'sell', title: '전량 익절 권고', sub: '수익 구간에서 매도 신호가 겹쳤습니다. 수익을 확정하는 쪽이 유리합니다.' });
    else if (score >= 3) Object.assign(out, { cls: 'part', title: '분할 익절 권고 (절반 매도)', sub: '일부 매도 신호가 나왔습니다. 절반을 익절하고 나머지는 손절선 상향 후 보유하세요.' });
    else Object.assign(out, { cls: 'hold', title: '계속 보유', sub: '수급과 추세가 유지되고 있어 아직 팔 이유가 약합니다.' });
  } else if (near) {
    Object.assign(out, { cls: 'stop', title: '손절선 근접 — 경계', sub: '현재가가 손절선 ' + won(R.stopPrice) + '에 3% 이내로 다가왔습니다. 이탈하면 규칙상 전량 손절입니다.' });
  } else if (row.m5 <= row.m20) {
    Object.assign(out, { cls: 'part', title: '비중 축소 검토', sub: '손실 구간에서 수급까지 약해졌습니다. 추가 분할 매수는 보류하고 비중 축소를 검토하세요.' });
  } else {
    Object.assign(out, { cls: 'hold', title: '계속 보유 (손절선 모니터링)', sub: '평가손실이지만 수급은 유지 중입니다.' + (R.active ? ' 손절선 ' + won(R.stopPrice) + '.' : ' 아직 50% 미만 진입이라 손절선은 비활성입니다.') });
  }
  const left = R.n - R.filled;
  if (left > 0) out.hint = '남은 분할 ' + left + '회' + (R.future ? '(' + R.future + '회는 다음 거래일부터 자동 체결 예정)' : '') + ' — ' + (row.m5 > row.m20 ? '수급이 유지되고 있어 다음 분할 진입을 이어가도 됩니다.' : '수급이 약해져 다음 분할 진입은 보류하는 편이 안전합니다.');
  return out;
}

// ───────────────────────── 차트 ─────────────────────────
function chart(pi, R, s) {
  const L = s.length - 1, a = Math.max(0, (R.first != null ? R.first : L - 60) - 20);
  const W = 640, H = 220, ml = 8, mr = 66, mt = 12, mb = 20;
  let lo = Infinity, hi = -Infinity;
  for (let i = a; i <= L; i++) { lo = Math.min(lo, s[i].p); hi = Math.max(hi, s[i].p); }
  if (R.avg) { lo = Math.min(lo, R.avg); hi = Math.max(hi, R.avg); }
  if (R.active && R.stopPrice) lo = Math.min(lo, R.stopPrice);
  const pad = (hi - lo) * 0.06 || hi * 0.02; lo -= pad; hi += pad;
  const x = (i) => ml + (i - a) / Math.max(1, L - a) * (W - ml - mr);
  const y = (v) => mt + (hi - v) / (hi - lo) * (H - mt - mb);
  let g = '';
  for (let k = 0; k <= 3; k++) { const v = lo + (hi - lo) * k / 3; g += `<line x1="${ml}" x2="${W - mr}" y1="${y(v)}" y2="${y(v)}" stroke="var(--chart-grid)"/><text x="${W - mr + 4}" y="${y(v) + 3}">${num(v)}</text>`; }
  const ticks = 4; for (let k = 0; k <= ticks; k++) { const i = Math.round(a + (L - a) * k / ticks); g += `<text x="${x(i)}" y="${H - 5}" text-anchor="${k === 0 ? 'start' : k === ticks ? 'end' : 'middle'}">${s[i].d.slice(5)}</text>`; }
  let d = ''; for (let i = a; i <= L; i++) d += (i === a ? 'M' : 'L') + x(i).toFixed(1) + ' ' + y(s[i].p).toFixed(1);
  let ov = '';
  if (R.avg) ov += `<line x1="${ml}" x2="${W - mr}" y1="${y(R.avg)}" y2="${y(R.avg)}" stroke="var(--primary)" stroke-dasharray="5 3"/><text x="${W - mr + 4}" y="${y(R.avg) + 3}" style="fill:var(--primary);font-weight:700">평단</text>`;
  if (R.active && R.stopPrice) ov += `<line x1="${ml}" x2="${W - mr}" y1="${y(R.stopPrice)}" y2="${y(R.stopPrice)}" stroke="var(--dn)" stroke-dasharray="2 3"/><text x="${W - mr + 4}" y="${y(R.stopPrice) + 3}" style="fill:var(--dn);font-weight:700">손절</text>`;
  R.tr.filter((t) => t.st === 'fill' || t.st === 'void').forEach((t) => { ov += `<circle cx="${x(t.idx)}" cy="${y(t.price)}" r="5" fill="${t.void ? 'var(--chart-axis)' : 'var(--primary)'}" stroke="#fff" stroke-width="1.5"/><text x="${x(t.idx)}" y="${y(t.price) - 9}" text-anchor="middle" style="fill:var(--ink);font-weight:700">${t.i + 1}</text>`; });
  if (R.stopped) ov += `<path d="M${x(R.stopIdx) - 5} ${y(s[R.stopIdx].p) - 5}l10 10m0 -10l-10 10" stroke="var(--dn)" stroke-width="2.5"/>`;
  return `<svg class="chart" viewBox="0 0 ${W} ${H}" data-pi="${pi}" data-a="${a}">${g}<path d="${d}" fill="none" stroke="var(--blue)" stroke-width="1.8"/>${ov}<line class="xh" y1="${mt}" y2="${H - mb}" stroke="var(--chart-axis)" visibility="hidden"/><text class="tip" y="9" visibility="hidden" style="fill:var(--ink);font-weight:700"></text><rect class="hit" x="${ml}" y="0" width="${W - ml - mr}" height="${H}" fill="transparent"/></svg>`;
}
function wireChart(svg, s) {
  const a = +svg.dataset.a, L = s.length - 1, W = 640, ml = 8, mr = 66, hit = svg.querySelector('.hit'), xh = svg.querySelector('.xh'), tip = svg.querySelector('.tip');
  const mv = (e) => {
    const r = svg.getBoundingClientRect(), px = (e.clientX - r.left) / r.width * W;
    const i = Math.max(a, Math.min(L, Math.round(a + (px - ml) / (W - ml - mr) * (L - a))));
    const X = ml + (i - a) / Math.max(1, L - a) * (W - ml - mr);
    xh.setAttribute('x1', X); xh.setAttribute('x2', X); xh.setAttribute('visibility', 'visible');
    tip.textContent = s[i].d + '  ' + won(s[i].p); tip.setAttribute('x', Math.min(Math.max(X, 70), W - mr - 70)); tip.setAttribute('text-anchor', 'middle'); tip.setAttribute('visibility', 'visible');
  };
  hit.addEventListener('pointermove', mv); hit.addEventListener('pointerleave', () => { xh.setAttribute('visibility', 'hidden'); tip.setAttribute('visibility', 'hidden'); });
}

// ───────────────────────── 렌더 ─────────────────────────
function candidates() {
  if (!window.supplyJudge) return [];
  return stocks.map((r) => ({ r, j: window.supplyJudge(r) })).filter((x) => state.jkey === 'all' || x.j.key === state.jkey)
    .sort((a, b2) => (JORD[a.j.key] - JORD[b2.j.key]) || (b2.r.strong_streak - a.r.strong_streak) || a.r.name.localeCompare(b2.r.name, 'ko')).map((x) => x.r);
}

let searchQ = '';
function searchHtml(q) {
  const held = new Set(state.positions.map((p) => p.code));
  const t = q.trim().toLowerCase();
  if (!t) return '<p class="note" style="margin:8px 0 0">종목명이나 코드 일부를 입력하세요. 예: 삼성, 하이닉스, 005930</p>';
  const hit = stocks.filter((r) => r.name.toLowerCase().includes(t) || r.code.toLowerCase().includes(t))
    .sort((a, b) => (b.name.toLowerCase().startsWith(t) - a.name.toLowerCase().startsWith(t)) || a.name.localeCompare(b.name, 'ko'));
  if (!hit.length) return '<p class="note" style="margin:8px 0 0">검색 결과가 없습니다. 이 대시보드는 코스피200 종목만 분석합니다.</p>';
  const rows = hit.slice(0, 12).map((r) => `<tr><td><b>${esc(r.name)}</b> <span class="disc">${esc(r.code)}</span></td><td>${esc(r.verdict)}</td><td class="num">${r.strong_streak > 0 ? r.strong_streak + '일' : '-'}</td><td class="num">${num(r.close)}</td><td class="num ${cls(r.chg20)}">${pct(r.chg20)}</td><td>${jTag(r) || '-'}</td><td>${r.hist_ok === true ? '<span class="tag g">양호</span>' : r.hist_ok === false ? '<span class="tag r">부진</span>' : '<span class="tag">표본부족</span>'}</td><td>${held.has(r.code) ? '<span class="tag l">담김</span>' : `<button class="solid" data-add="${esc(r.code)}">담기</button>`}</td></tr>`).join('');
  return `<div class="tbl-wrap" style="margin-top:8px"><table><thead><tr><th>종목</th><th>판단</th><th class="num">강한진입</th><th class="num">현재가</th><th class="num">20일</th><th>종합 판단</th><th>과거 성과</th><th></th></tr></thead><tbody>${rows}</tbody></table></div>` +
    (hit.length > 12 ? `<p class="note" style="margin:6px 0 0">${hit.length}개 중 12개만 보여줍니다. 더 구체적으로 입력해 보세요.</p>` : '');
}

function renderAll() {
  const held = new Set(state.positions.map((p) => p.code));
  const cands = candidates();
  const sims = state.positions.map((p) => { const s = cache[p.code]; return s ? { p, s, R: simulate(p, s) } : null; });
  // 요약
  let cost = 0, value = 0, realized = 0, nStop = 0, nOpen = 0;
  sims.forEach((x) => { if (!x) return; cost += x.R.cost; value += x.R.value; if (x.R.stopped) { realized += x.R.pnl; nStop++; } else if (x.R.qty) nOpen++; });
  const pnl = value - cost, ret = cost ? pnl / cost : null;

  let h = `<section class="card" id="s-sum"><h2>내 모의투자 현황</h2>
    <div class="kpis">
      <div class="kpi"><small>총 투입(체결 원가)</small><b>${won(cost)}</b></div>
      <div class="kpi"><small>평가금액(청산 포함)</small><b>${won(value)}</b></div>
      <div class="kpi ${pnl > 0 ? 'pos' : pnl < 0 ? 'neg' : ''}"><small>평가손익</small><b>${cost ? sgnWon(pnl) : '-'}</b></div>
      <div class="kpi ${pnl > 0 ? 'pos' : pnl < 0 ? 'neg' : ''}"><small>수익률</small><b>${pct(ret, 2)}</b></div>
      <div class="kpi"><small>보유 / 손절 청산</small><b>${nOpen}종목 / ${nStop}종목</b></div>
    </div></section>`;

  h += `<section class="card" id="s-rule"><h2>진행 규칙</h2><div class="rules"><ol>
    <li><b>후보</b>: 판단 탭의 <b>종합 판단</b>(① 수급 후보 + ② 진입 확인 + ③ 추세 확인 + ④ 분석 보고서)이 <b>매수진입</b>인 종목을 기본으로 보여 줍니다. 매수대기·매수보류·매수불가도 버튼으로 고를 수 있습니다. 기준선은 판단 탭의 「기준선 설정」에서 바꾸며 이 목록도 같이 바뀝니다. <b>매수진입은 규칙을 만족했다는 뜻이며 수익 보장이 아닙니다.</b> 다른 판정의 종목도 직접 담을 수는 있지만 이른 매수·추격매수 위험이 더 큽니다.</li>
    <li><b>분할 매수</b>: 전체 투입금액을 N회로 나눠 <b>첫 매수 당일부터</b> 그날 종가로 체결. <b>균등분할</b>은 첫 매수일부터 일정 간격으로 자동 체결, <b>선택분할</b>은 2차부터 날짜를 직접 선택.</li>
    <li><b>손절</b>: 전체 물량의 <b>50% 진입 이후</b> 종가가 평균단가 <b>-10%</b> 이하가 되는 날 전량 매도(그날 종가). 50% 미만일 땐 손절 비활성.</li>
    <li><b>판단</b>: 현재 수익과 수급 지표(매집 5일선/20일선, 분산비, 고점 되돌림, 보유일수)로 보유·분할익절·전량익절을 안내.</li></ol></div></section>`;

  const jc = { all: stocks.length, buy: 0, wait: 0, hold: 0, no: 0 };
  if (window.supplyJudge) stocks.forEach((r) => { jc[window.supplyJudge(r).key]++; });
  h += `<section class="card" id="s-cand"><h2>종합 판단 후보 종목</h2>
    <p class="note">판단 탭의 종합 판단(수급 후보 + 진입 확인 + 분석 보고서, 개인 기준선)으로 나눈 종목입니다. 판정 칸에 마우스를 올리면 이유가 보입니다.</p>
    <div class="jl-chips2" style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px">${[['buy', '매수진입'], ['wait', '매수대기'], ['hold', '매수보류'], ['no', '매수불가'], ['all', '전체']].map(([k, t]) => `<button class="jl-chip ${k}" data-jk="${k}" aria-pressed="${state.jkey === k}">${t} ${jc[k]}</button>`).join('')}</div>
    <div class="row" style="margin-bottom:10px">
      <label>종목당 투입금액(원) <input type="number" id="defBudget" min="100000" step="1000000" value="${state.def.budget}" style="width:130px"></label>
      <label>분할 횟수 <select id="defN">${[2,3,4,5,6,8,10].map((k) => `<option ${k === state.def.n ? 'selected' : ''}>${k}</option>`).join('')}</select></label>
    </div>
    <div class="tbl-wrap" style="max-height:420px;overflow:auto"><table><thead><tr><th>종목</th><th>종합 판단</th><th>수급 후보</th><th>진입 확인</th><th>보고서</th><th class="num">20일</th><th class="num">현재가</th><th></th></tr></thead><tbody>` +
    (cands.length ? cands.map((r) => { const rp = window.supplyReport ? window.supplyReport(r.code) : null; return `<tr><td><b>${esc(r.name)}</b> <span class="disc">${esc(r.code)}</span></td><td>${jTag(r)}</td><td>${esc(r.verdict)} (${r.cnt || 0}/3)</td><td>${esc(r.st_ko || '-')}</td><td>${rp ? esc(rp.score + '점·' + rp.opinion) : '없음'}</td><td class="num ${cls(r.chg20)}">${pct(r.chg20)}</td><td class="num">${num(r.close)}</td><td>${held.has(r.code) ? '<span class="tag l">담김</span>' : `<button class="solid" data-add="${esc(r.code)}">담기</button>`}</td></tr>`; }).join('') : `<tr><td colspan="8" class="empty">${window.supplyJudge ? '이 판정에 해당하는 종목이 없습니다.' : '판단을 계산하는 중입니다…'}</td></tr>`) +
    `</tbody></table></div></section>`;

  h += `<section class="card" id="s-search"><h2>종목 직접 검색해서 담기</h2>
    <p class="note">강한진입 후보가 아니어도 코스피200 안의 종목을 이름이나 코드로 찾아 모의투자에 담을 수 있습니다. 담은 뒤의 분할 매수·손절·판단은 후보와 똑같이 적용됩니다.</p>
    <input type="search" id="simq" placeholder="종목명 또는 코드 (예: 삼성, 005930)" value="${esc(searchQ)}" autocomplete="off" style="width:100%;max-width:26rem">
    <div id="simq-res">${searchHtml(searchQ)}</div></section>`;

  if (!state.positions.length) h += `<section class="card empty">위 후보나 검색으로 종목을 담으면 여기에 분할 매수 · 손절 · 수익 현황이 나타납니다.</section>`;
  else {
    const all = state.sel == null || !state.positions.some((p) => p.code === state.sel);
    h += `<section class="card" id="s-mine"><div class="pos-head"><div><h2>내 매수 종목</h2><p class="note" style="margin:0">종목 줄을 누르면 그 종목의 분할 매수·손절·판단을 봅니다.</p></div><button class="${all ? 'solid' : ''}" data-all="1">전체 보기</button></div>
      <div class="tbl-wrap" style="margin-top:8px"><table><thead><tr><th>종목</th><th>상태</th><th class="num">진입</th><th class="num">평균단가</th><th class="num">현재가</th><th class="num">수익률</th><th class="num">손익</th><th>판단</th></tr></thead><tbody>` +
      sims.map((x, i) => { const p = state.positions[i]; if (!x) return `<tr><td>${esc(p.name)}</td><td colspan="7">데이터 없음</td></tr>`; const J = judge(p, x.R, x.s), R = x.R, on = !all && state.sel === p.code;
        const stt = R.stopped ? '<span class="tag r">손절 청산</span>' : R.qty ? '<span class="tag g">보유 중</span>' : '<span class="tag">매수 대기</span>';
        return `<tr class="sel ${on ? 'on' : ''}" data-sel="${esc(p.code)}"><td><b>${esc(p.name)}</b> <span class="disc">${esc(p.code)}</span></td><td>${stt}</td><td class="num">${R.filled}/${R.n}회</td><td class="num">${num(R.avg)}</td><td class="num">${num(R.last)}</td><td class="num ${cls(R.ret)}">${R.qty ? pct(R.ret, 2) : '-'}</td><td class="num ${cls(R.pnl)}">${R.qty ? sgnWon(R.pnl) : '-'}</td><td>${esc(J.title)}</td></tr>`; }).join('') + `</tbody></table></div></section>`;
    h += sims.map((x, i) => (all || state.sel === state.positions[i].code) ? (x ? posCard(i, x.p, x.s, x.R) : `<section class="card"><div class="err">${esc(state.positions[i].name)} 데이터를 불러오지 못했습니다.</div></section>`) : '').join('');
  }

  h += `<section class="card"><div class="row"><button class="ghost" id="exp">백업 내보내기</button><label class="ghost" style="cursor:pointer"><span class="tag">백업 가져오기</span><input type="file" id="imp" accept="application/json" hidden></label><button class="ghost" id="reset">전체 초기화</button></div>
    <p class="note" style="margin:8px 0 0">기록은 이 브라우저(주소 단위)에 저장됩니다. 로컬 서버와 GitHub Pages는 서로 다른 저장소이니, 옮길 땐 백업 파일을 쓰세요.</p></section>`;
  root.innerHTML = h;
  // 모바일 카드 표시용: 각 칸에 열 이름 붙이기
  root.querySelectorAll('table').forEach((tb) => {
    tb.classList.add('stack');
    const hd = [...tb.querySelectorAll('thead th')].map((x) => x.textContent.trim());
    tb.querySelectorAll('tbody tr').forEach((tr) => [...tr.children].forEach((td, k) => { if (k > 0 && hd[k] && !td.hasAttribute('colspan')) td.dataset.label = hd[k]; }));
  });
  root.querySelectorAll('svg.chart').forEach((svg) => { const p = state.positions[+svg.dataset.pi]; wireChart(svg, cache[p.code]); });
}

function posCard(i, p, s, R) {
  const J = judge(p, R, s), L = s.length - 1, minD = s[0].d, maxD = s[L].d;
  const stT = R.stopped ? '<span class="tag r">손절 청산</span>' : R.qty ? '<span class="tag g">보유 중</span>' : '<span class="tag">매수 대기</span>';
  const eq = p.mode === 'equal';
  const rows = R.tr.map((t) => {
    const stTxt = { future: '<span class="tag l">예정</span>', wait: '<span class="tag">날짜 선택</span>', bad: '<span class="tag w">데이터 이전</span>', short: '<span class="tag w">금액 부족</span>', fill: '<span class="tag g">체결</span>', void: '<span class="tag r">손절 후 무효</span>' }[t.st];
    const snap = t.st !== 'wait' && t.date && t.date !== t.req ? `<div class="disc">휴장 → ${esc(t.date)} 종가</div>` : '';
    return `<tr><td>${t.i + 1}차 <span class="disc">${num(R.amt)}원</span></td>
      <td>${eq || t.i === 0 ? (t.date ? esc(t.date) : '<span class="disc">' + (t.st === 'future' ? '다음 거래일 이후' : '-') + '</span>') + (t.i === 0 ? ' <span class="disc">(첫 매수일)</span>' : '') : `<input type="date" class="tr-in" data-pi="${i}" data-ti="${t.i}" min="${esc(p.start || minD)}" max="${maxD}" value="${esc(t.req || '')}">`}${snap}</td>
      <td class="num">${t.price ? num(t.price) : '-'}</td><td class="num">${t.qty ? num(t.qty) + '주' : '-'}</td><td>${stTxt}</td>
      <td>${!eq && t.i > 0 ? `<button class="ghost" data-today="${i}:${t.i}" title="마지막 거래일 종가로 매수">오늘</button>${t.req ? ` <button class="ghost" data-clear="${i}:${t.i}">비우기</button>` : ''}` : ''}</td></tr>`;
  }).join('');
  const sc = state.positions[i] && stocks.find((r) => r.code === p.code);
  const sl = R.active ? `<div class="stopline on">손절 활성 — 평균단가 ${won(R.avg)} × 0.90 = <b>${won(R.stopPrice)}</b> 종가 이탈 시 전량 매도${R.stopped ? ' (이미 ' + esc(s[R.stopIdx].d) + ' 발동)' : ''}. 활성일 ${esc(s[R.activeIdx].d)}</div>`
    : `<div class="stopline">손절 비활성 — 전체 ${R.n}회 중 <b>${R.need}회(50%)</b> 이상 진입해야 평균단가 -10% 손절이 적용됩니다. 현재 ${R.filled}/${R.n}회 체결${R.avg ? ' · 가정 손절선 ' + won(R.stopPrice) : ''}.</div>`;
  const stat = (k, v, c) => `<div class="stat"><small>${k}</small><b class="${c || ''}">${v}</b></div>`;
  return `<section class="card posc">
    <div class="pos-head"><h3>${esc(p.name)}<small>${esc(p.code)}${sc ? ' · 강한진입 ' + sc.strong_streak + '일째' : ''}</small> ${stT} ${sc ? jTag(sc) : ''}</h3>
      <div class="row"><label>투입금액 <input type="number" data-budget="${i}" value="${p.budget}" step="1000000" min="100000" style="width:120px"></label>
        <label>분할 <select data-n="${i}">${[2,3,4,5,6,8,10].map((k) => `<option ${k === p.n ? 'selected' : ''}>${k}</option>`).join('')}</select></label>
        <button class="ghost" data-del="${i}">삭제</button></div></div>
    <div class="row" style="margin-top:10px">
      <label>분할 방식 <select data-mode="${i}"><option value="equal" ${eq ? 'selected' : ''}>균등분할 (자동)</option><option value="select" ${eq ? '' : 'selected'}>선택분할 (날짜 직접)</option></select></label>
      <label>첫 매수일 <input type="date" data-start="${i}" min="${minD}" max="${maxD}" value="${esc(p.start || '')}"></label>
      <button class="ghost" data-startnow="${i}">오늘로</button>
      ${eq ? `<label>간격 <select data-gap="${i}">${[1,2,3,5].map((k) => `<option value="${k}" ${k === (p.gap || 1) ? 'selected' : ''}>${k}거래일마다</option>`).join('')}</select></label>` : ''}
    </div>
    <div class="stats">
      ${stat('평균단가', won(R.avg))}${stat('보유수량', R.stopped ? '청산' : R.qty ? num(R.qty) + '주' : '-')}${stat('투입 원가', won(R.cost))}${stat(R.stopped ? '청산금액' : '평가금액', R.qty ? won(R.value) : '-')}
      ${stat('현재가', won(R.last))}${stat(R.stopped ? '실현손익' : '평가손익', R.qty ? sgnWon(R.pnl) : '-', cls(R.pnl))}${stat('수익률', pct(R.ret, 2), cls(R.ret))}${stat('진입 / 보유일', R.filled + '/' + R.n + '회 · ' + R.heldDays + '일')}
    </div>
    ${sl}
    ${sc && sc.inv_price ? `<div class="stopline">진입 판단 무효화 가격 <b>${won(sc.inv_price)}</b>(최근 10일 최저 저가) — 종가가 이 아래로 내려가면 추가 분할 매수는 보류하는 편이 안전합니다. 보유 중 손절은 위의 기존 규칙(50% 진입 후 평균단가 -10%)만 적용되며, 체결가를 보장하지 않습니다.</div>` : ''}
    <div class="grid2">
      <div><div class="tbl-wrap"><table><thead><tr><th>분할</th><th>매수일</th><th class="num">체결가</th><th class="num">수량</th><th>상태</th><th></th></tr></thead><tbody>${rows}</tbody></table></div>
        <p class="note" style="margin:6px 0 0">${eq ? '첫 매수일부터 ' + (p.gap || 1) + '거래일 간격으로 균등하게 자동 체결됩니다. 시세가 갱신되면 예정 분할이 그날 종가로 채워집니다.' : '1차는 첫 매수일에 체결되고, 2차부터 날짜를 직접 고릅니다(그날 종가 체결, 휴장일은 직전 거래일).'} 마지막 시세일 ${esc(maxD)}.</p></div>
      <div>${chart(i, R, s)}</div>
    </div>
    <div class="verdict ${J.cls}"><div class="vt">${esc(J.title)}${R.qty && !R.stopped ? ` <span style="font-weight:400;font-size:.9rem">· 현재 ${pct(R.ret, 2)}</span>` : ''}</div>
      <div style="font-weight:400;font-size:.9rem;margin-top:2px">${esc(J.sub)}</div>
      ${J.score != null ? `<div class="meter" title="매도 압력 점수"><i style="width:${Math.min(100, J.score / 9 * 100)}%"></i></div><div class="disc">매도 압력 ${J.score}점 (3점↑ 분할 익절, 5점↑ 전량 익절 · 수익 구간 기준)</div>` : ''}
      ${J.f.length ? '<ul>' + J.f.map((x) => `<li>${x.ok ? '<b class="up">✓</b>' : '<b class="dn">⚠</b>'} ${esc(x.t)}${x.w ? ` <span class="disc">(+${x.w})</span>` : ''}</li>`).join('') + '</ul>' : ''}
      ${J.hint ? `<div style="margin-top:8px;font-weight:500;font-size:.86rem">➕ ${esc(J.hint)}</div>` : ''}
    </div>
  </section>`;
}

// ───────────────────────── 이벤트 ─────────────────────────
async function addPos(code) {
  const r = stocks.find((x) => x.code === code); if (!r || state.positions.some((p) => p.code === code)) return;
  await loadSeries(code);
  const s = cache[code];
  state.positions.push({ code, name: r.name, budget: state.def.budget, n: state.def.n, mode: 'equal', gap: 1, start: s[s.length - 1].d, buys: Array(state.def.n).fill(null), added: new Date().toISOString().slice(0, 10) });
  state.sel = code;
  save(); renderAll();
}
// 이전 버전 기록 호환: 모드/첫 매수일이 없으면 선택분할로 보고 1차 날짜를 첫 매수일로 쓴다
state.positions.forEach((p) => { if (!p.mode) { p.mode = 'select'; p.start = p.buys && p.buys[0] || null; p.gap = 1; } });
root.addEventListener('click', async (e) => {
  const row = e.target.closest('tr[data-sel]');
  if (row && !e.target.closest('button,input,select')) { state.sel = row.dataset.sel; save(); renderAll(); return; }
  const t = e.target.closest('button'); if (!t) return;
  const d = t.dataset;
  if (d.jk) { state.jkey = d.jk; save(); renderAll(); }
  else if (d.add) await addPos(d.add);
  else if (d.del != null) { if (confirm('이 종목 모의투자를 삭제할까요?')) { const [x] = state.positions.splice(+d.del, 1); if (state.sel === x.code) state.sel = null; save(); renderAll(); } }
  else if (d.all) { state.sel = null; save(); renderAll(); }
  else if (d.startnow != null) { const p = state.positions[+d.startnow], s = cache[p.code]; p.start = s[s.length - 1].d; save(); renderAll(); }
  else if (d.today) { const [i, k] = d.today.split(':').map(Number), p = state.positions[i]; p.buys[k] = cache[p.code][cache[p.code].length - 1].d; save(); renderAll(); }
  else if (d.clear) { const [i, k] = d.clear.split(':').map(Number); state.positions[i].buys[k] = null; save(); renderAll(); }
  else if (t.id === 'exp') { const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([JSON.stringify(state, null, 1)], { type: 'application/json' })); a.download = 'supply-sim-backup.json'; a.click(); }
  else if (t.id === 'reset') { if (confirm('모든 모의투자 기록을 지울까요?')) { state.positions = []; save(); renderAll(); } }
});
root.addEventListener('input', (e) => {
  if (e.target.id !== 'simq') return;
  searchQ = e.target.value;
  const box = root.querySelector('#simq-res'); if (box) box.innerHTML = searchHtml(searchQ);
});
root.addEventListener('change', async (e) => {
  const t = e.target, d = t.dataset;
  if (t.id === 'onlyReady') { state.onlyReady = t.checked; save(); renderAll(); }
  else if (t.id === 'minStreak') { state.minStreak = Math.max(1, +t.value || MIN_STREAK); save(); renderAll(); }
  else if (t.id === 'defBudget') { state.def.budget = Math.max(100000, +t.value || 10000000); save(); renderAll(); }
  else if (t.id === 'defN') { state.def.n = +t.value; save(); renderAll(); }
  else if (d.budget != null) { state.positions[+d.budget].budget = Math.max(100000, +t.value || 10000000); save(); renderAll(); }
  else if (d.n != null) { const p = state.positions[+d.n], n = +t.value; p.n = n; p.buys = Array.from({ length: n }, (_, k) => p.buys[k] || null); save(); renderAll(); }
  else if (d.mode != null) { state.positions[+d.mode].mode = t.value; save(); renderAll(); }
  else if (d.gap != null) { state.positions[+d.gap].gap = +t.value; save(); renderAll(); }
  else if (d.start != null) { const p = state.positions[+d.start]; p.start = t.value || null; p.buys = p.buys.map((b) => (b && p.start && b < p.start) ? p.start : b); save(); renderAll(); }
  else if (d.ti != null) { state.positions[+d.pi].buys[+d.ti] = t.value || null; save(); renderAll(); }
  else if (t.id === 'imp' && t.files[0]) {
    try { const j = JSON.parse(await t.files[0].text()); if (!Array.isArray(j.positions)) throw 0; state = Object.assign(state, j); await Promise.all(state.positions.map((p) => loadSeries(p.code))); save(); renderAll(); }
    catch (err) { alert('백업 파일을 읽지 못했습니다.'); }
  }
});

window.addEventListener('supply-judge', () => { try { renderAll(); } catch (e) {} });
// ───────────────────────── 시작 ─────────────────────────
(async function init() {
  try {
    const r = await fetch('data/summary.json', { cache: 'no-cache' });
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const j = await r.json(); stocks = j.stocks; built = j.built || '';
    await pullState();
    await Promise.all(state.positions.map((p) => loadSeries(p.code).catch(() => null)));
    if (!state.ts && state.positions.length) save();          // 처음 연동: 이 기기의 기록을 서버에 올린다
    renderAll();
    // 다른 기기(PC↔폰)에서 바꾼 기록을 20초마다 가져온다. 입력 중일 땐 건너뛴다
    setInterval(async () => { if (!document.hidden && !/INPUT|SELECT/.test(document.activeElement.tagName) && await pullState()) renderAll(); }, 20000);
    // 매일 시세가 갱신되면(열어 둔 화면에서도) 자동으로 다시 불러온다
    setInterval(async () => {
      try {
        const r2 = await fetch('data/summary.json', { cache: 'no-cache' }); if (!r2.ok) return;
        const j2 = await r2.json(); if ((j2.built || '') === built) return;
        stocks = j2.stocks; built = j2.built || ''; Object.keys(cache).forEach((k) => delete cache[k]);
        await Promise.all(state.positions.map((p) => loadSeries(p.code).catch(() => null))); renderAll();
      } catch (e) {}
    }, 600000);
  } catch (e) {
    root.innerHTML = '<div class="err">데이터를 불러오지 못했습니다 (' + esc(e.message) + ').<br>잠시 후 새로고침해 보세요.</div>';
  }
})();
})();
</script>

<style>
  .sd .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0; }
  .sd .chips button { font: inherit; font-size: .8rem; padding: 5px 10px; border-radius: 999px; border: 1px solid var(--hairline-strong, #ccc); background: transparent; color: var(--muted, #555); cursor: pointer; }
  .sd .chips button[aria-pressed="true"] { background: var(--primary, #00855a); color: #fff; border-color: var(--primary, #00855a); }
  .sd .row-sec { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin: 6px 0 10px; }
  .sd .row-sec button { font: inherit; font-size: .85rem; padding: 6px 12px; border-radius: 6px; border: 1px solid var(--primary, #00855a); background: transparent; color: var(--primary, #00855a); cursor: pointer; }
  .sd .sector-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  @media (max-width: 900px) { .sd .sector-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .sd .sector-grid { grid-template-columns: 1fr; } .tabbar button span { font-size: .6rem; letter-spacing: -.04em; } }
  .sd .scard { border: 1px solid var(--hairline, #ddd); border-radius: 8px; padding: 8px 10px; min-width: 0; }
  .sd .scard h3 { margin: 0 0 2px; font-size: .95rem; display: flex; justify-content: space-between; gap: 6px; align-items: baseline; }
  .sd .scard .sub { color: var(--muted, #666); font-size: .74rem; margin: 0 0 4px; }
  .sd .scard svg { width: 100%; height: auto; display: block; }
  .sd .scard .tg { font-size: .68rem; padding: 2px 6px; border-radius: 2px; font-weight: 700; background: var(--canvas-soft, #eee); color: var(--muted, #666); white-space: nowrap; }
  .sd .scard .tg.up { background: var(--primary, #00855a); color: #fff; }
  .sd .btn-sm { font: inherit; font-size: .82rem; padding: 5px 10px; border-radius: 6px; border: 1px solid var(--primary, #00855a); background: var(--primary, #00855a); color: #fff; cursor: pointer; }
  .sd .btn-sm:disabled { opacity: .45; cursor: not-allowed; }
  .sd .fl { display: inline-block; font-size: .68rem; padding: 1px 6px; border-radius: 2px; background: #fdecec; color: #b3261e; margin-left: 4px; font-weight: 700; }
</style>

<script>
(() => {
'use strict';
const $ = (id) => document.getElementById(id);
const esc = (t) => String(t).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const eok = (v) => v == null ? '-' : (Math.abs(v) >= 10000 ? (v / 10000).toFixed(1) + '조' : Math.round(v).toLocaleString('ko-KR') + '억');
const sgn = (v) => (v > 0 ? '+' : '') + eok(v);
const KEY = 'supply-sector.v1';
let LOCAL = false;
try { LOCAL = (location.hostname === '127.0.0.1' || location.hostname === 'localhost'); } catch (e) {}
if (LOCAL) fetch('api/status', { cache: 'no-store' }).then((r) => { LOCAL = r.ok; }).catch(() => { LOCAL = false; });

// ───────────── 업종 탭 ─────────────
const SEC = { data: null, sel: [] };
const loadSel = () => { try { const j = JSON.parse(localStorage.getItem(KEY) || 'null'); return Array.isArray(j) ? j : null; } catch (e) { return null; } };
const saveSel = () => { try { localStorage.setItem(KEY, JSON.stringify(SEC.sel)); } catch (e) {} };
const recommend = () => SEC.data.sectors.slice().sort((a, b) => b.gap_ratio - a.gap_ratio).slice(0, 12).map((s) => s.name);

function chartSvg(s) {
  const pts = s.s.slice(-240), W = 300, H = 120, ml = 4, mr = 4, mt = 6, mb = 16;
  const ys = [];
  pts.forEach((r) => { ys.push(r[1]); if (r[2] != null) ys.push(r[2]); if (r[3] != null) ys.push(r[3]); });
  let lo = Math.min(...ys, 0), hi = Math.max(...ys); if (hi <= lo) hi = lo + 1; const pad = (hi - lo) * 0.06; hi += pad;
  const x = (i) => ml + i / Math.max(1, pts.length - 1) * (W - ml - mr), y = (v) => mt + (hi - v) / (hi - lo) * (H - mt - mb);
  const path = (k) => { let d = '', on = false; pts.forEach((r, i) => { if (r[k] == null) return; d += (on ? 'L' : 'M') + x(i).toFixed(1) + ' ' + y(r[k]).toFixed(1); on = true; }); return d; };
  const area = path(1) + `L${x(pts.length - 1).toFixed(1)} ${y(0).toFixed(1)}L${x(0).toFixed(1)} ${y(0).toFixed(1)}Z`;
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(s.name)} 매집이평선"><path d="${area}" fill="var(--canvas-soft,#eee)" opacity=".7"/>` +
    `<path d="${path(1)}" fill="none" stroke="#9aa0a6" stroke-width="1"/><path d="${path(3)}" fill="none" stroke="var(--warn,#b45f00)" stroke-width="1.6"/><path d="${path(2)}" fill="none" stroke="var(--primary,#00855a)" stroke-width="1.8"/>` +
    `<text x="${ml}" y="${H - 3}" font-size="9" fill="var(--muted,#666)">${esc(pts[0][0].slice(2))}</text><text x="${W - mr}" y="${H - 3}" font-size="9" text-anchor="end" fill="var(--muted,#666)">${esc(pts[pts.length - 1][0].slice(2))}</text></svg>`;
}

function renderSectors() {
  const D = SEC.data, by = Object.fromEntries(D.sectors.map((s) => [s.name, s]));
  $('sector-basis').textContent = D.basis + ' · 기준일 ' + (D.sectors[0] ? D.sectors[0].asof : '') + ' · 계산 ' + D.built;
  $('sector-chips').replaceChildren(...D.sectors.slice().sort((a, b) => (a.market === '코스피' ? 0 : 1) - (b.market === '코스피' ? 0 : 1) || a.name.localeCompare(b.name, 'ko')).map((s) => {
    const b = document.createElement('button'); b.type = 'button'; b.dataset.name = s.name; b.setAttribute('aria-pressed', SEC.sel.includes(s.name) ? 'true' : 'false');
    b.textContent = s.name.replace(/^코스(피|닥) /, '') + (s.name.startsWith('코스닥') ? '(닥)' : '') + ' ' + s.n; return b;
  }));
  $('sector-count').textContent = SEC.sel.length + '/12개 선택';
  $('sector-grid').innerHTML = SEC.sel.map((n) => by[n]).filter(Boolean).map((s) => `<div class="scard"><h3><span>${esc(s.name)}</span><span class="tg ${s.up ? 'up' : ''}">${s.up ? '매집 우위' : '매집 약화'}</span></h3>` +
    `<p class="sub">분석 종목 ${s.n}/${s.total}개 · 5일 순매수 ${sgn(s.flow5)} · 20일 ${sgn(s.flow20)}${s.chg20 != null ? ' · 지수 20일 ' + (s.chg20 >= 0 ? '+' : '') + (s.chg20 * 100).toFixed(1) + '%' : ''}</p>${chartSvg(s)}` +
    `<p class="sub" title="${esc(s.stocks.join(', '))}">주도주 순: ${esc(s.stocks.slice(0, 5).join(', '))}${s.stocks.length > 5 ? ' 외 ' + (s.stocks.length - 5) : ''}</p></div>`).join('') || '<p class="note">위에서 업종을 선택하세요.</p>';
}
async function initSectors() {
  try { const r = await fetch('data/sectors.json', { cache: 'no-cache' }); if (!r.ok) throw 0; SEC.data = await r.json(); }
  catch (e) { $('sector-basis').textContent = '업종 자료를 불러오지 못했습니다(아직 만들어지지 않았을 수 있습니다).'; return; }
  const names = SEC.data.sectors.map((s) => s.name); let sel = (loadSel() || []).filter((n) => names.includes(n));
  SEC.sel = (sel.length ? sel : recommend()).slice(0, 12); renderSectors();
}
$('sector-chips').addEventListener('click', (e) => {
  const b = e.target.closest('button[data-name]'); if (!b) return; const n = b.dataset.name, i = SEC.sel.indexOf(n);
  if (i >= 0) SEC.sel.splice(i, 1); else { if (SEC.sel.length >= 12) { $('sector-count').textContent = '최대 12개까지 볼 수 있습니다. 하나를 해제하세요.'; return; } SEC.sel.push(n); }
  saveSel(); renderSectors();
});
$('sector-rec').addEventListener('click', () => { if (!SEC.data) return; SEC.sel = recommend(); saveSel(); renderSectors(); });
$('sector-clear').addEventListener('click', () => { SEC.sel = []; saveSel(); renderSectors(); });

// ───────────── 종목 검색 · 추가 ─────────────
const UNI = { list: null, have: new Set() };
async function initUniverse() {
  try {
    const [u, s] = await Promise.all([fetch('data/universe.json', { cache: 'no-cache' }).then((r) => r.json()), fetch('data/summary.json', { cache: 'no-cache' }).then((r) => r.json())]);
    UNI.list = u.stocks; UNI.have = new Set(s.stocks.map((r) => r.code));
    renderFind();
  } catch (e) { $('find-info').textContent = '종목 목록을 불러오지 못했습니다(아직 만들어지지 않았을 수 있습니다).'; }
}
const PEND = {};     // code -> 마지막 상태
function findRows(q) {
  q = q.trim().toLowerCase(); if (!UNI.list || !q) return [];
  return UNI.list.filter((r) => r.n.toLowerCase().includes(q) || r.c.startsWith(q)).sort((a, b) => (b.n.toLowerCase().startsWith(q) - a.n.toLowerCase().startsWith(q)) || a.n.localeCompare(b.n, 'ko')).slice(0, 15);
}
function renderFind() {
  const rows = findRows($('find-q').value), tb = $('find-table');
  tb.hidden = !rows.length;
  if (UNI.list) { const q = $('find-q').value.trim(); $('find-info').textContent = (q ? (rows.length ? rows.length + '건 · ' : '검색 결과가 없습니다 · ') : '') + '전체 ' + UNI.list.length.toLocaleString('ko-KR') + '종목 · 분석 중 ' + UNI.have.size + '종목'; }
  tb.tBodies[0].replaceChildren(...rows.map((r) => {
    const tr = document.createElement('tr'), have = UNI.have.has(r.c), pend = PEND[r.c];
    const flags = (r.w >= 3 ? '<span class="fl">투자위험</span>' : r.w === 2 ? '<span class="fl">투자경고</span>' : r.w === 1 ? '<span class="fl">투자주의</span>' : '') + (r.g ? '<span class="fl">관리</span>' : '') + (r.t ? '<span class="fl">거래정지</span>' : '');
    let st, act;
    if (have) { st = '분석 중'; act = `<button class="btn-sm" data-view="${r.c}">보기</button>`; }
    else if (pend) { st = esc(pend); act = ''; }
    else { st = '분석 안 함'; act = `<button class="btn-sm" data-add="${r.c}" ${LOCAL ? '' : 'disabled title="이 컴퓨터(127.0.0.1:8770)에서만 추가할 수 있습니다"'}>추가</button>`; }
    tr.innerHTML = `<td><b>${esc(r.n)}</b> <span class="note">${r.c}</span>${flags}</td><td>${esc(r.m)} · ${esc(r.s.replace(/^코스(피|닥) /, ''))}</td><td>${st}</td><td>${act}</td>`;
    return tr;
  }));
}
$('find-q').addEventListener('input', renderFind);
async function poll(code) {
  for (let i = 0; i < 400; i++) {
    await new Promise((r) => setTimeout(r, 4000));
    let st; try { st = await (await fetch('api/addstatus?code=' + code, { cache: 'no-store' })).json(); } catch (e) { continue; }
    if (st.analyzed) { PEND[code] = null; UNI.have.add(code); $('find-msg').textContent = code + ' 분석에 포함되었습니다.'; renderFind(); return; }
    if (st.state === '오류') { PEND[code] = '오류: ' + (st.message || ''); renderFind(); return; }
    if (st.state === '완료' && !st.queued) {
      PEND[code] = '수집 완료 — 「분석 반영」을 누르세요'; renderFind();
      $('find-msg').innerHTML = esc(code) + ' 수집이 끝났습니다. <button class="btn-sm" id="find-rebuild">분석 반영 (약 2~3분)</button> 이 컴퓨터의 화면에만 먼저 반영되고, 공개 사이트에는 매일 밤 갱신 때 올라갑니다.';
      return;
    }
    PEND[code] = st.queued ? '수집기 대기 중' : (st.state === '수집중' ? '수집 중…' : '요청됨'); renderFind();
  }
}
$('find-table').addEventListener('click', async (e) => {
  const b = e.target.closest('button'); if (!b) return;
  if (b.dataset.view) { location.hash = '#' + b.dataset.view + '/judge'; window.scrollTo({ top: 0 }); return; }
  if (b.dataset.add) {
    const code = b.dataset.add; b.disabled = true;
    try {
      const r = await fetch('api/addstock', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Local-Analysis': '1' }, body: JSON.stringify({ code }) });
      const j = await r.json(); if (!r.ok) throw new Error(j.error || '실패');
      PEND[code] = '요청함'; renderFind(); poll(code);
    } catch (err) { PEND[code] = '실패: ' + err.message; renderFind(); }
  }
});
$('find-msg').addEventListener('click', async (e) => {
  if (e.target.id !== 'find-rebuild') return; e.target.disabled = true;
  try { await fetch('api/rebuild', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Local-Analysis': '1' }, body: '{}' }); } catch (err) { return; }
  $('find-msg').textContent = '분석 데이터를 다시 계산하는 중입니다…';
  for (let i = 0; i < 400; i++) {
    await new Promise((r) => setTimeout(r, 5000));
    try { const st = await (await fetch('api/addstatus?code=000000', { cache: 'no-store' })).json(); if (st.rebuild && !st.rebuild.running) { if (st.rebuild.ok) { location.reload(); } else { $('find-msg').textContent = '계산 실패: ' + (st.rebuild.msg || ''); } return; } } catch (err) {}
  }
});
initSectors(); initUniverse();
})();
</script>

<style>
  .sd .pill.v-hold { background: #fff3e0; color: #b45f00; } .sd .pill.v-void { background: #fdecec; color: #b3261e; }
  .sd .rep-line { margin: 0; padding: 8px 10px; border-radius: 6px; font-size: .88rem; border: 1px solid var(--hairline-strong, #ccc); }
  .sd .rep-line.on { border-color: var(--primary, #00855a); background: var(--lime-panel, #eef9d6); color: #000; }
  .sd .rep-line.off { color: var(--muted, #666); }
  .sd .rep-line b { font-weight: 700; }
  .sd #rj-head .tg { display: inline-block; font-size: .78rem; padding: 3px 8px; border-radius: 2px; font-weight: 700; background: var(--primary, #00855a); color: #fff; margin-right: 6px; }
  .sd #rj-head .tg.off { background: var(--canvas-soft, #eee); color: var(--muted, #666); }
  .sd #sl-stocks td, .sd #sl-stocks th { white-space: nowrap; } .sd #sl-stocks td:nth-child(2) { white-space: normal; min-width: 7rem; }
  .sd .seltbl tbody tr { cursor: pointer; } .sd .seltbl tbody tr.on { background: var(--lime-panel, #eef9d6); }
</style>

<script>
(() => {
'use strict';
const $ = (id) => document.getElementById(id);
const esc = (t) => String(t).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const num = (v) => v == null || isNaN(v) ? '-' : Math.round(v).toLocaleString('ko-KR');
let LOCAL = false;
try { LOCAL = (location.hostname === '127.0.0.1' || location.hostname === 'localhost'); } catch (e) {}
if (LOCAL) fetch('api/status', { cache: 'no-store' }).then((r) => { LOCAL = r.ok; }).catch(() => { LOCAL = false; });
const SL = { uni: null, sum: {}, sec: {}, mkt: '전체', pick: null, pend: {} };
async function load() {
  try {
    const [u, s, c] = await Promise.all([fetch('data/universe.json', { cache: 'no-cache' }).then((r) => r.json()), fetch('data/summary.json', { cache: 'no-cache' }).then((r) => r.json()), fetch('data/sectors.json', { cache: 'no-cache' }).then((r) => r.json()).catch(() => ({ sectors: [] }))]);
    SL.uni = u.stocks; s.stocks.forEach((r) => { SL.sum[r.code] = r; }); (c.sectors || []).forEach((x) => { SL.sec[x.name] = x; });
    draw();
  } catch (e) { $('sl-msg').textContent = '종목 목록을 불러오지 못했습니다(아직 만들어지지 않았을 수 있습니다).'; }
}
function groups() {
  const g = {};
  SL.uni.forEach((r) => { const k = r.s || '(업종 없음)'; (g[k] = g[k] || { name: k, mkt: r.m, stocks: [] }).stocks.push(r); });
  return Object.values(g).filter((x) => SL.mkt === '전체' || x.mkt === SL.mkt).sort((a, b) => (a.mkt === '코스피' ? 0 : 1) - (b.mkt === '코스피' ? 0 : 1) || a.name.localeCompare(b.name, 'ko'));
}
function draw() {
  if (!SL.uni) return;
  $('sl-mkt').replaceChildren(...['전체', '코스피', '코스닥'].map((m) => { const b = document.createElement('button'); b.type = 'button'; b.dataset.m = m; b.setAttribute('aria-pressed', SL.mkt === m ? 'true' : 'false'); const n = SL.uni.filter((r) => m === '전체' || r.m === m).length; b.textContent = m + ' ' + n.toLocaleString('ko-KR') + '종목'; return b; }));
  const gs = groups();
  $('sl-table').tBodies[0].replaceChildren(...gs.map((g) => {
    const tr = document.createElement('tr'); tr.dataset.name = g.name; if (SL.pick === g.name) tr.className = 'on';
    const have = g.stocks.filter((r) => SL.sum[r.c]).length, sc = SL.sec[g.name];
    [g.name.replace(/^코스(피|닥) /, ''), g.mkt, g.stocks.length, have, sc ? (sc.up ? '매집 우위' : '매집 약화') : '-'].forEach((t) => { const td = document.createElement('td'); td.textContent = t; tr.appendChild(td); });
    return tr;
  }));
  drawStocks();
}
function drawStocks() {
  const tb = $('sl-stocks');
  if (!SL.pick) { tb.hidden = true; $('sl-title').textContent = ''; return; }
  const g = groups().find((x) => x.name === SL.pick); if (!g) { tb.hidden = true; return; }
  $('sl-title').textContent = g.name + ' · ' + g.stocks.length + '종목 (분석 중 ' + g.stocks.filter((r) => SL.sum[r.c]).length + ')';
  tb.hidden = false;
  const pos = g.stocks.reduce((a, r) => a + (SL.sum[r.c] && SL.sum[r.c].sf20 > 0 ? SL.sum[r.c].sf20 : 0), 0);
  const eok = (v) => v == null ? '-' : (v > 0 ? '+' : '') + (Math.abs(v) >= 10000 ? (v / 10000).toFixed(1) + '조' : Math.round(v).toLocaleString('ko-KR') + '억');
  const ordered = g.stocks.slice().sort((a, b) => (!!SL.sum[b.c] - !!SL.sum[a.c]) || ((SL.sum[b.c] ? SL.sum[b.c].sf20 : 0) - (SL.sum[a.c] ? SL.sum[a.c].sf20 : 0)) || a.n.localeCompare(b.n, 'ko'));
  let rk = 0;
  tb.tBodies[0].replaceChildren(...ordered.map((r) => {
    const tr = document.createElement('tr'), s = SL.sum[r.c], pend = SL.pend[r.c];
    const fl = (r.w >= 3 ? '투자위험 ' : r.w === 2 ? '투자경고 ' : r.w === 1 ? '투자주의 ' : '') + (r.g ? '관리 ' : '') + (r.t ? '거래정지 ' : '');
    const st = s ? s.verdict : (pend || '분석 안 함');
    const act = s ? '<button class="btn-sm" data-view="' + r.c + '">보기</button>' : (pend ? '' : '<button class="btn-sm" data-add="' + r.c + '"' + (LOCAL ? '' : ' disabled title="이 컴퓨터(127.0.0.1:8770)에서만 추가할 수 있습니다"') + '>추가</button>');
    const rank = s ? ++rk : '-', f20 = s ? s.sf20 : null, share = s && f20 > 0 && pos > 0 ? Math.round(f20 / pos * 100) + '%' : '-';
    tr.innerHTML = '<td>' + rank + '</td><td><b>' + esc(r.n) + '</b> <span class="note">' + r.c + '</span>' + (fl ? ' <span class="fl">' + esc(fl.trim()) + '</span>' : '') + '</td><td>' + esc(st) + '</td><td>' + eok(f20) + '</td><td>' + share + '</td><td>' + (s ? num(s.close) : '-') + '</td><td>' + (s && s.chg20 != null ? (s.chg20 >= 0 ? '+' : '') + (s.chg20 * 100).toFixed(1) + '%' : '-') + '</td><td>' + act + '</td>';
    return tr;
  }));
}
$('sl-mkt').addEventListener('click', (e) => { const b = e.target.closest('button[data-m]'); if (!b) return; SL.mkt = b.dataset.m; if (SL.pick && !groups().some((g) => g.name === SL.pick)) SL.pick = null; draw(); });
$('sl-table').addEventListener('click', (e) => { const tr = e.target.closest('tr[data-name]'); if (!tr) return; SL.pick = tr.dataset.name; draw(); });
$('sl-stocks').addEventListener('click', async (e) => {
  const b = e.target.closest('button'); if (!b) return;
  if (b.dataset.view) { location.hash = '#' + b.dataset.view + '/judge'; window.scrollTo({ top: 0 }); return; }
  if (b.dataset.add) {
    const code = b.dataset.add; b.disabled = true;
    try {
      const r = await fetch('api/addstock', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Local-Analysis': '1' }, body: JSON.stringify({ code }) });
      const j = await r.json(); if (!r.ok) throw new Error(j.error || '실패');
      SL.pend[code] = '수집 요청함'; $('sl-msg').textContent = code + ' 수집을 요청했습니다. 끝나면 매일 갱신과 함께 분석에 포함됩니다(진행은 종목 탭의 검색에서도 볼 수 있습니다).';
    } catch (err) { SL.pend[code] = '실패: ' + err.message; }
    drawStocks();
  }
});
load();
})();
</script>

<style>
  .sd .pill.v-buy { background: #0a7d3c; color: #fff; font-weight: 800; } .sd .pill.v-wait4 { background: #1f5fbf; color: #fff; font-weight: 800; }
  .sd .pill.v-hold { background: #ff9f1c; color: #3a2400; font-weight: 800; } .sd .pill.v-no { background: #c62828; color: #fff; font-weight: 800; }
  .sd #v-pill { font-size: 1.05rem; letter-spacing: -.02em; }
  .sd ul.jb { list-style: none; margin: 8px 0; padding: 0; } .sd ul.jb li { display: grid; grid-template-columns: 1.4rem 6.5rem 1fr; gap: 6px; padding: 7px 0; border-bottom: 1px solid var(--hairline, #ddd); align-items: baseline; }
  .sd ul.jb .jb-ico { font-weight: 800; } .sd ul.jb .jb-t { color: var(--muted, #555); font-size: .86rem; }
  .sd ul.jb .jb-pass .jb-ico { color: #0a7d3c; } .sd ul.jb .jb-fail .jb-ico { color: #c62828; } .sd ul.jb .jb-wait .jb-ico { color: #1f5fbf; } .sd ul.jb .jb-warn .jb-ico { color: #b45f00; }
  .sd #jset summary { cursor: pointer; } .sd .jset-grid { display: grid; gap: 10px; margin-top: 10px; }
  .sd .jset-grid label { display: block; font-size: .9rem; } .sd .jset-grid fieldset { border: 1px solid var(--hairline, #ddd); border-radius: 6px; padding: 8px 10px; }
  .sd .jset-grid fieldset label { margin: 4px 0; } .sd .jset-grid button { justify-self: start; font: inherit; padding: 6px 12px; border-radius: 6px; border: 1px solid var(--primary, #00855a); background: transparent; color: var(--primary, #00855a); cursor: pointer; }
  .sd .jset-grid input[type=number], .sd .jset-grid select { font: inherit; font-size: 16px; padding: 4px 6px; }
</style>

<style>
  .sd .si-ctl { margin: 6px 0; } .sd .si-ctl select { font: inherit; font-size: 16px; padding: 5px 8px; }
  .sd table.si { font-size: .82rem; } .sd table.si th, .sd table.si td { white-space: nowrap; text-align: right; padding: 5px 8px; } .sd table.si th:first-child, .sd table.si td:first-child { text-align: left; position: sticky; left: 0; background: var(--color-panel, #fff); }
  .sd table.si td.pos { color: #d32f2f; } .sd table.si td.neg { color: #1565c0; }
</style>

<script>
(() => {
'use strict';
const $ = (id) => document.getElementById(id);
const SI = { d: null, mkt: '코스피', per: 'last' };
const NAMES = (n) => n.replace(/^코스(피|닥) /, '');
async function load() {
  try { SI.d = await (await fetch('data/sector_inv.json', { cache: 'no-cache' })).json(); }
  catch (e) { $('si-basis').textContent = '업종별 투자자 자료가 아직 없습니다(수집기가 마감 후 첫 저장을 하면 나타납니다).'; return; }
  $('si-basis').textContent = SI.d.basis;
  const nd = SI.d.dates.length, need = SI.d.min_days || 100;
  $('si-prog').textContent = nd >= need ? '자료 ' + nd + '일: 업종별 세력합 매집이평선을 아래에 보여줍니다.' : '자료 ' + nd + '/' + need + '일 저장됨 — 지금은 표만 보여주고, ' + need + '일이 모이면 업종별 매집이평선 차트가 이 자리에 자동으로 나타납니다. 위의 「업종별 수급 — 매집이평선」 차트는 종목 수급을 합산한 것으로 지금도 볼 수 있습니다.';
  drawCharts();
  const n = SI.d.dates.length, opts = [['last', '최근일 (' + SI.d.dates[n - 1] + ')']];
  if (n >= 2) opts.push(['5', '최근 ' + Math.min(5, n) + '일 합계']);
  if (n >= 6) opts.push(['20', '최근 ' + Math.min(20, n) + '일 합계']);
  if (n >= 2) opts.push(['all', '저장한 전체 ' + n + '일 누적']);
  $('si-per').replaceChildren(...opts.map(([v, t]) => new Option(t, v)));
  draw();
}
function sums() {
  const D = SI.d, n = D.dates.length;
  const use = SI.per === 'last' ? D.dates.slice(n - 1) : SI.per === 'all' ? D.dates : D.dates.slice(-Math.min(Number(SI.per), n));
  const acc = new Map(), order = [];
  use.forEach((d) => (D.rows[d] || []).forEach(([m, name, v]) => {
    if (m !== SI.mkt) return;
    if (!acc.has(name)) { acc.set(name, v.map(() => 0)); order.push(name); }
    const a = acc.get(name); v.forEach((x, i) => { a[i] += x; });
  }));
  return { use, order, acc };
}
function chartSvg(name, pts) {
  const W = 300, H = 120, ml = 4, mr = 4, mt = 6, mb = 16, ys = [0];
  pts.forEach((r) => { ys.push(r[1]); if (r[2] != null) ys.push(r[2]); if (r[3] != null) ys.push(r[3]); });
  const lo = Math.min(...ys); let hi = Math.max(...ys); if (hi <= lo) hi = lo + 1; hi += (hi - lo) * 0.06;
  const x = (i) => ml + i / Math.max(1, pts.length - 1) * (W - ml - mr), y = (v) => mt + (hi - v) / (hi - lo) * (H - mt - mb);
  const path = (k) => { let d = '', on = false; pts.forEach((r, i) => { if (r[k] == null) return; d += (on ? 'L' : 'M') + x(i).toFixed(1) + ' ' + y(r[k]).toFixed(1); on = true; }); return d; };
  return '<svg viewBox="0 0 ' + W + ' ' + H + '"><path d="' + path(1) + '" fill="none" stroke="#9aa0a6" stroke-width="1"/><path d="' + path(3) + '" fill="none" stroke="var(--warn,#b45f00)" stroke-width="1.6"/><path d="' + path(2) + '" fill="none" stroke="var(--primary,#00855a)" stroke-width="1.8"/><text x="4" y="117" font-size="9" fill="var(--muted,#666)">' + pts[0][0].slice(2) + '</text><text x="296" y="117" font-size="9" text-anchor="end" fill="var(--muted,#666)">' + pts[pts.length - 1][0].slice(2) + '</text></svg>';
}
function drawCharts() {
  const g = $('si-charts'), cs = (SI.d.charts || []).filter((c) => c.market === SI.mkt);
  g.hidden = !cs.length; if (!cs.length) return;
  g.innerHTML = cs.map((c) => '<div class="scard"><h3><span>' + c.name + '</span></h3>' + chartSvg(c.name, c.s) + '</div>').join('');
}
function draw() {
  if (!SI.d) return;
  $('si-mkt').replaceChildren(...['코스피', '코스닥'].map((m) => { const b = document.createElement('button'); b.type = 'button'; b.dataset.m = m; b.setAttribute('aria-pressed', SI.mkt === m ? 'true' : 'false'); b.textContent = m; return b; }));
  const { use, order, acc } = sums();
  $('si-range').textContent = use.length ? use[0] + (use.length > 1 ? ' ~ ' + use[use.length - 1] + ' (' + use.length + '일)' : '') : '';
  const cols = SI.d.cols;
  $('si-table').tHead.innerHTML = '<tr><th>업종명</th>' + cols.map((c) => '<th>' + c + '</th>').join('') + '</tr>';
  $('si-table').tBodies[0].replaceChildren(...order.map((name) => {
    const tr = document.createElement('tr'), v = acc.get(name);
    const t0 = document.createElement('td'); t0.textContent = name; tr.appendChild(t0);
    v.forEach((x) => { const td = document.createElement('td'); td.textContent = x === 0 ? '' : x.toLocaleString('ko-KR'); td.className = x > 0 ? 'pos' : x < 0 ? 'neg' : ''; tr.appendChild(td); });
    return tr;
  }));
}
$('si-mkt').addEventListener('click', (e) => { const b = e.target.closest('button[data-m]'); if (!b) return; SI.mkt = b.dataset.m; draw(); drawCharts(); });
$('si-per').addEventListener('change', (e) => { SI.per = e.target.value; draw(); });
load();
})();
</script>

<script>
(() => {
'use strict';
const $ = (id) => document.getElementById(id);
let U = null;
const fill = (el, first, opts) => { el.replaceChildren(new Option(first, ''), ...opts.map((o) => (typeof o === 'string' ? new Option(o, o) : new Option(o[1], o[0])))); };
function sectors() {
  const m = $('fp-mkt').value;
  return [...new Set(U.filter((r) => !m || r.m === m).map((r) => r.s))].sort((a, b) => a.localeCompare(b, 'ko'));
}
function stocks() {
  const m = $('fp-mkt').value, sc = $('fp-sec').value;
  return U.filter((r) => (!m || r.m === m) && (!sc || r.s === sc)).sort((a, b) => a.n.localeCompare(b.n, 'ko'));
}
function drawStocks() {
  const list = stocks();
  fill($('fp-stk'), '목록에서 종목 고르기… (' + list.length.toLocaleString('ko-KR') + '개)', list.map((r) => [r.c, r.n + ' · ' + r.c]));
}
async function init() {
  try { U = (await (await fetch('data/universe.json', { cache: 'no-cache' })).json()).stocks; } catch (e) { return; }
  const dl = $('find-dl');
  U.slice().sort((a, b) => a.n.localeCompare(b.n, 'ko')).forEach((r) => { const o = document.createElement('option'); o.value = r.n; o.label = r.c + ' · ' + r.m; dl.appendChild(o); });
  fill($('fp-sec'), '업종 전체', sectors());
  drawStocks();
}
$('fp-mkt').addEventListener('change', () => { if (!U) return; fill($('fp-sec'), '업종 전체', sectors()); drawStocks(); });
$('fp-sec').addEventListener('change', () => { if (U) drawStocks(); });
$('fp-stk').addEventListener('change', (e) => {
  const code = e.target.value; if (!code) return;
  const q = $('find-q'); q.value = code; q.dispatchEvent(new Event('input', { bubbles: true }));
});
init();
})();
</script>

<style>
  .band-pick .pick-wrap { position: relative; flex: 1 1 auto; min-width: 0; display: flex; }
  .band-pick .pick-wrap input { flex: 1 1 auto; border-radius: 2px 0 0 2px; }
  .band-pick #pick-btn { font: inherit; font-size: 1rem; width: 2.2rem; border: 0; border-left: 1px solid #ccc; border-radius: 0 2px 2px 0; background: #fff; color: #333; cursor: pointer; }
  .pick-list { position: absolute; left: 0; right: 0; top: calc(100% + 2px); max-height: 52vh; overflow: auto; background: #fff; color: #111; border: 1px solid #bbb; border-radius: 4px; box-shadow: 0 6px 18px rgba(0,0,0,.25); z-index: 60; }
  .pick-item { padding: 9px 12px; font-size: 16px; cursor: pointer; border-bottom: 1px solid #eee; } .pick-item:hover, .pick-item.hi { background: #e8f5ee; }
  .pick-empty { padding: 12px; font-size: .9rem; color: #666; }
  .sd .jl-ctl { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 6px 0; }
  .sd .jl-ctl input[type=search] { font: inherit; font-size: 16px; padding: 7px 10px; border: 1px solid var(--hairline-strong, #ccc); border-radius: 6px; flex: 1 1 12rem; min-width: 0; }
  .sd .jl-chip { font: inherit; font-weight: 800; font-size: .85rem; padding: 6px 12px; border-radius: 999px; border: 2px solid currentColor; background: transparent; cursor: pointer; }
  .sd .jl-chip.all { color: #444; } .sd .jl-chip.buy { color: #0a7d3c; } .sd .jl-chip.wait { color: #1f5fbf; } .sd .jl-chip.hold { color: #b45f00; } .sd .jl-chip.no { color: #c62828; }
  .sd .jl-chip[aria-pressed="true"].all { background: #444; color: #fff; } .sd .jl-chip[aria-pressed="true"].buy { background: #0a7d3c; color: #fff; } .sd .jl-chip[aria-pressed="true"].wait { background: #1f5fbf; color: #fff; }
  .sd .jl-chip[aria-pressed="true"].hold { background: #ff9f1c; color: #3a2400; } .sd .jl-chip[aria-pressed="true"].no { background: #c62828; color: #fff; }
  .sd .jtag { display: inline-block; font-weight: 800; font-size: .8rem; padding: 3px 8px; border-radius: 2px; white-space: nowrap; }
  .sd .jtag.buy { background: #0a7d3c; color: #fff; } .sd .jtag.wait { background: #1f5fbf; color: #fff; } .sd .jtag.hold { background: #ff9f1c; color: #3a2400; } .sd .jtag.no { background: #c62828; color: #fff; }
  .sd table.jl td, .sd table.jl th { white-space: nowrap; } .sd table.jl tbody tr { cursor: pointer; }
</style>
<script>
// 크레온 자료 받기 진행 상황(내 컴퓨터 서버에서 열었을 때만)
(() => {
  if (!/^(127\.0\.0\.1|localhost)$/.test(location.hostname)) return;
  const box = document.getElementById('crawl'), tx = document.getElementById('crawl-t'), bar = document.getElementById('crawl-i');
  if (!box) return;
  const fmt = (s) => { s = Math.max(0, Math.round(s)); const h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60); return (h ? h + '시간 ' : '') + (h || m ? m + '분' : s + '초'); };
  async function tick() {
    try {
      const r = await fetch('/api/progress', { cache: 'no-store' });
      if (!r.ok || !(r.headers.get('content-type') || '').includes('json')) throw 0;
      const j = await r.json();
      const age = (Date.now() - new Date(j.갱신시각).getTime()) / 1000;
      const sec = j.업종 && j.업종.최근 ? ' · 업종 수급 ' + j.업종.일수 + '일 저장(최근 ' + j.업종.최근.slice(5) + ')' : '';
      if (!j.전체 || (!j.갱신 && age > 1800)) { box.className = 'crawl'; return; }
      bar.style.width = j.퍼센트 + '%';
      if (j.갱신) { box.className = 'crawl on'; tx.textContent = '크레온 자료 받는 중 ' + j.완료 + ' / ' + j.전체 + '종목 (' + j.퍼센트 + '%) · 경과 ' + fmt(j.경과초) + ' · 남은 약 ' + fmt(j.남은초) + sec + (age > 600 ? ' · ⚠ ' + fmt(age) + ' 동안 갱신 없음(크레온 연결 확인)' : ''); }
      else { box.className = 'crawl on done'; tx.textContent = '크레온 자료 받기 완료 — 전체 ' + j.전체 + '종목, ' + fmt(j.경과초) + ' 걸림' + sec; }
    } catch (e) { box.className = 'crawl'; }
  }
  tick(); setInterval(tick, 10000);
})();
</script>
</body>
</html>
